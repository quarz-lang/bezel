require "test"

# The `bezel` command: an application generated into a temporary
# directory (bezel from this checkout), its generators, and the tasks it
# runs in it. The checks of generated code run `quarz` on the PATH, or
# $QUARZ.
class CliTest < Test::Case
  # This checkout's root (the bezel library).
  def self.repo -> String = File.expand_path(File.join(File.dirname(__FILE__), "..", ".."))

  # A new directory for one test.
  def self.tmp -> String
    dir = File.join(Dir.tmpdir, "bezel-cli-#{Process.pid}-#{Random.rand(1_000_000_000)}")
    Dir.mkdir_p(dir)
    dir
  end

  # What `bezel argv` in `cwd` printed and returned.
  def bezel(argv: Array[String], cwd: String) -> [Int, String]
    path = File.join(Dir.tmpdir, "bezel-cli-out-#{Process.pid}-#{Random.rand(1_000_000_000)}.txt")
    begin
      status = File.open(path, "w") { |io| Cli.run(argv, cwd, io) }
      [status, File.read(path)]
    ensure
      File.delete(path) if File.exist?(path)
    end
  end

  # A new application `shop` in a new directory; its root.
  def new_app -> String
    dir = CliTest.tmp
    status, _ = bezel(["new", "shop", "--bezel", CliTest.repo], dir)
    assert_equal(0, status)
    File.join(dir, "shop")
  end

  # `quarz check` in `root`: its status and output.
  def quarz_check(root: String) -> Process::Output
    Process.sh("cd #{Cli.quote(root)} && exec #{Cli.quote(Cli.quarz)} check 2>&1")
  end

  def read(root: String, path: String) -> String = File.read(File.join(root, path))

  def test_new_writes_an_application_that_checks_and_passes_its_test
    root = new_app
    begin
      ["Cog.toml", "Cog.local.toml", ".gitignore", "README.md", ".github/workflows/ci.yml", "src/main.qz", "src/shop.qz",
       "src/config.qz", "src/endpoint.qz", "src/router.qz", "src/controllers/page_controller.qz",
       "src/views/layouts/app.html.bz", "src/views/page/home.html.bz", "src/views/generated/layouts.qz",
       "src/views/generated/page.qz", "src/migrations.qz", "src/jobs.qz", "priv/static/app.css", "test/page_test.qz"].each do |f|
        assert(File.file?(File.join(root, f)), f)
      end
      assert(read(root, "Cog.toml").include?("Bezel = { git = \"https://github.com/quarz-lang/bezel\", branch = \"main\" }"))
      assert(read(root, "Cog.toml").include?("Divider = { git = \"https://github.com/quarz-lang/divider\", branch = \"main\" }"))
      assert(read(root, "src/main.qz").include?("exit(Shop::Jobs.serve) if ARGV.first? == \"jobs\""))
      assert(read(root, "src/main.qz").include?("migrations: Shop::Migrations.all + Divider::Migrations.all"))
      assert(read(root, "src/jobs.qz").include?("def self.all -> Array[Type[Divider::Job]] = []"))
      assert_equal("[patch]\nBezel = { path = #{CliTest.repo.inspect} }\n", read(root, "Cog.local.toml"))
      assert(read(root, "src/views/generated/page.qz").include?("module Shop::PageView"))
      assert_equal(0, bezel(["templates", "--check"], root)[0])
      assert_equal(0, bezel(["migrations", "--check"], root)[0])
      res = quarz_check(root)
      assert(res.success?, res.stdout)
      t = Process.sh("cd #{Cli.quote(root)} && exec #{Cli.quote(Cli.quarz)} test 2>&1")
      assert(t.success?, t.stdout)
      status, out = bezel(["routes"], File.join(root, "src"))
      assert_equal([0, "home  GET     /  Shop::PageController#home"], [status, out.strip])
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  def test_new_refuses_bad_names_and_existing_directories
    dir = CliTest.tmp
    begin
      assert_equal(1, bezel(["new", "Shop"], dir)[0])
      assert_equal(1, bezel(["new"], dir)[0])
      assert_equal(1, bezel(["new", "a", "b"], dir)[0])
      # (A dependency's module: divider's, which every application has.)
      assert_equal(1, bezel(["new", "divider"], dir)[0])
      Dir.mkdir(File.join(dir, "taken"))
      assert_equal(1, bezel(["new", "taken"], dir)[0])
    ensure
      Dir.rm_rf(dir)
    end
  end

  def test_commands_need_an_application
    dir = CliTest.tmp
    begin
      assert_equal(1, bezel(["templates"], dir)[0])
      assert_equal(2, bezel(["nope"], dir)[0])
      assert_equal(0, bezel(["help"], dir)[0])
    ensure
      Dir.rm_rf(dir)
    end
  end

  def test_generators
    root = new_app
    begin
      status, out = bezel(["gen", "controller", "about", "index", "team"], root)
      assert_equal(0, status)
      assert(out.include?("create  src/controllers/about_controller.qz"))
      assert(read(root, "src/controllers/about_controller.qz").include?("render(conn, Shop::LayoutsView.app(conn, \"About\", Shop::AboutView.team(conn)))"))
      assert(read(root, "src/views/generated/about.qz").include?("def self.team(conn: Bezel::Conn) -> Bezel::Html"))
      router = read(root, "src/router.qz")
      assert(router.include?("      get \"/about\", Shop::AboutController, :index\n      get \"/about/team\", Shop::AboutController, :team\n      # bezel gen: routes\n"))
      assert_equal(1, bezel(["gen", "controller", "about"], root)[0])

      assert_equal(0, bezel(["gen", "migration", "AddThings", "--version", "20261108000001"], root)[0])
      assert(read(root, "src/migrations/20261108000001_add_things.qz").include?("class Shop::Migrations::AddThings < Rotor::Migration\n  version 20261108000001\n"))
      assert_equal(1, bezel(["gen", "migration", "other", "--version", "20261108000001"], root)[0])
      assert_equal(1, bezel(["gen", "migration", "add_things"], root)[0])

      assert_equal(0, bezel(["gen", "model", "tag", "name:string", "weight:float", "note:text", "seen:boolean", "at:time"], root)[0])
      model = read(root, "src/models/tag.qz")
      assert(model.include?("class Shop::Tag < Rotor::Model\n  table \"tags\" do\n    column :id, Int, primary: true\n    column :name, String\n    column :weight, Float\n"))
      assert(model.include?("Rotor::Changeset.cast(Shop::Tag, params, [:name, :weight, :note, :seen, :at])"))
      migs = Dir.children(File.join(root, "src", "migrations")).sort
      assert_equal(2, migs.size)
      assert(migs[1].end_with?("_create_tags.qz"))
      # (A version after the latest, here the one given above.)
      assert(migs[1] > migs[0])
      assert(read(root, "src/migrations.qz").include?("[Shop::Migrations::AddThings, Shop::Migrations::CreateTags]"))
      assert_equal(1, bezel(["gen", "model", "tag", "name:str"], root)[0])
      assert_equal(1, bezel(["gen", "model", "x", "id:integer"], root)[0])

      res = quarz_check(root)
      assert(res.success?, res.stdout)
      assert_equal(0, bezel(["migrations", "--check"], root)[0])
      assert_equal(0, bezel(["templates", "--check"], root)[0])
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  def test_resource
    root = new_app
    begin
      status, _ = bezel(["gen", "resource", "post", "title:string", "body:text", "views:integer", "published:boolean"], root)
      assert_equal(0, status)
      assert(read(root, "src/router.qz").include?("resources \"/posts\", Shop::PostsController"))
      c = read(root, "src/controllers/posts_controller.qz")
      assert(c.include?("case conn.repo.insert(Shop::Post.changeset(conn.params[\"post\"].to_h))"))
      assert(c.include?("redirect(conn.put_flash(:info, \"Post deleted.\"), to: Shop::Router.posts_path)"))
      v = read(root, "src/views/posts_view.qz")
      assert(v.include?("          f.textarea(:body)\n"))
      assert(v.include?("          f.number_field(:views)\n"))
      assert(v.include?("          f.checkbox(:published)\n"))
      assert_equal(1, bezel(["gen", "resource", "post", "title:string"], root)[0])
      assert_equal(1, bezel(["gen", "resource", "comment"], root)[0])
      # The application with the resource checks, passes its test and
      # lists the resource's routes.
      res = quarz_check(root)
      assert(res.success?, res.stdout)
      t = Process.sh("cd #{Cli.quote(root)} && exec #{Cli.quote(Cli.quarz)} test 2>&1")
      assert(t.success?, t.stdout)
      status, out = bezel(["routes"], root)
      assert_equal(0, status)
      assert(out.include?("edit_post  GET     /posts/{id}/edit  Shop::PostsController#edit"), out)
      assert(out.include?("post  DELETE  /posts/{id}  Shop::PostsController#delete"), out)
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  # The body of `http://127.0.0.1:port/`, or nil while nothing answers.
  def page(port: Int) -> String?
    res = HTTP.get("http://127.0.0.1:#{port}/")
    res.status == 200 ? res.body.read : nil
  rescue StandardError
    nil
  end

  def test_server_runs_the_application_and_restarts_it_on_a_change
    root = new_app
    log = File.join(File.dirname(root), "server.log")
    # (Below Linux's ephemeral ports, 32768 and up.)
    port = 20_000 + Random.rand(10_000)
    app = Cli.app(root)
    stop = Channel[Nil].new
    begin
      t = Task.spawn do
        File.open(log, "w") { |io| Cli::Server.serve(app, io, stop, {"PORT" => port.to_s}) }
      end
      body: String? = nil
      status = -1
      begin
        600.times do
          body = page(port)
          break if body
          Task.sleep(200.ms)
        end
        assert_match(/Welcome to Shop/, body || "")
        path = File.join(root, "src", "views", "page", "home.html.bz")
        File.write(path, File.read(path).sub("<h1>", "<h1>Changed "))
        600.times do
          body = page(port)
          break if body && body.include?("Changed ")
          Task.sleep(200.ms)
        end
        assert_match(/Changed Welcome to Shop/, body || "")
      ensure
        stop.close
        status = t.await
      end
      assert_equal(0, status)
      text = File.read(log)
      assert_equal(2, text.lines.count { |l| l.start_with?("bezel: starting shop") }, text)
      assert_match(/bezel: a file changed\n  update  src\/views\/generated\/page\.qz/, text)
      assert_nil(page(port))
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  def test_server_watches_files_without_following_links_or_hidden_ones
    root = CliTest.tmp
    begin
      Dir.mkdir_p(File.join(root, "src", "a", ".hidden"))
      File.write(File.join(root, "src", "x.qz"), "")
      File.write(File.join(root, "src", "a", "y.html.bz"), "")
      File.write(File.join(root, "src", "a", ".#y.html.bz"), "")
      File.write(File.join(root, "src", "a", ".hidden", "z.qz"), "")
      links = Process.sh("ln -s .. #{Cli.quote(File.join(root, "src", "a", "up"))} && ln -s . #{Cli.quote(File.join(root, "src", "self"))} && " +
                         "ln -s x.qz #{Cli.quote(File.join(root, "src", "linked.qz"))}")
      assert(links.success?, links.stderr)
      # (Links to directories are not followed; one to a file is a file.)
      assert_equal(["src/a/y.html.bz", "src/linked.qz", "src/x.qz"], Cli::Server.under(root, "src"))
      # The files `prepare` writes take their times after it, the others
      # before.
      t0 = Time.utc(2026, 1, 1)
      t1 = Time.utc(2026, 1, 2)
      before = {"src/x.qz" => t0, "src/views/generated/page.qz" => t0, "src/migrations.qz" => t0}
      after = {"src/x.qz" => t1, "src/views/generated/page.qz" => t1, "src/migrations.qz" => t1, "src/views/generated/new.qz" => t1}
      assert_equal({"src/x.qz" => t0, "src/views/generated/page.qz" => t1, "src/migrations.qz" => t1, "src/views/generated/new.qz" => t1},
                   Cli::Server.with_generated(before, after))
    ensure
      Dir.rm_rf(root)
    end
  end

  def test_gen_job
    root = new_app
    begin
      assert_equal(0, bezel(["gen", "job", "send_welcome", "user_id:integer", "template:string"], root)[0])
      j = read(root, "src/jobs/send_welcome.qz")
      assert(j.include?("class Shop::Jobs::SendWelcome < Divider::Job\n"), j)
      assert(j.include?("  data Args = (user_id: Int, template: String)\n\n  job_args Args\n"), j)
      assert(j.include?("  def perform(args: Args, job: Divider::Context) -> Void\n"), j)
      assert_equal(0, bezel(["gen", "job", "cleanup"], root)[0])
      c = read(root, "src/jobs/cleanup.qz")
      assert(c.include?("  def perform(job: Divider::Context) -> Void\n") && !c.include?("job_args"), c)
      assert(read(root, "src/jobs.qz").include?("def self.all -> Array[Type[Divider::Job]] = [Shop::Jobs::Cleanup, Shop::Jobs::SendWelcome]"))
      # Refused: the same name again, an argument named as enqueue's keywords.
      assert_equal(1, bezel(["gen", "job", "cleanup"], root)[0])
      assert_equal(1, bezel(["gen", "job", "remind", "at:time"], root)[0])
      assert(!File.exist?(File.join(root, "src", "jobs", "remind.qz")))
      # Names that would hide a constant for the other jobs, a reserved
      # word as a field; a job's field may be named `id`.
      ["divider", "hash", "string", "shop", "jobs", "config"].each do |bad|
        assert_equal(1, bezel(["gen", "job", bad], root)[0], bad)
      end
      assert_equal(1, bezel(["gen", "job", "remind", "class:string"], root)[0])
      assert_equal(0, bezel(["gen", "job", "remind", "id:integer"], root)[0])
      res = quarz_check(root)
      assert(res.success?, res.stdout)
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  def test_jobs_runs_the_application_s_worker
    root = new_app
    begin
      assert_equal(0, bezel(["gen", "job", "cleanup"], root)[0])
      PG::Testing.with_cluster do |url|
        c = PG.connect(url)
        # (A database of its own: PG_TEST_URL's server is shared.)
        db = "bezel_cli_jobs_#{Process.pid}_#{Random.rand(1_000_000)}"
        c.exec("CREATE DATABASE #{db}")
        begin
          base, q, query = url.partition("?")
          app_url = base[0, (base.rindex("/") || base.size)] + "/" + db + q + query
          env = {"DATABASE_URL" => app_url, "BEZEL_ENV" => "dev"}
          m = Process.spawn(Cli.quarz, "run", "--", "migrate", chdir: root, env: env, stdout: :pipe)
          migrated = m.stdout.read
          assert_equal(0, m.wait.code, migrated)
          app = PG.connect(app_url)
          state = ""
          code = -1
          begin
            app.exec("INSERT INTO divider_jobs (class, queue) VALUES ('Shop::Jobs::Cleanup', 'default')")
            w = Process.spawn(Cli.quarz, "run", "--", "jobs", chdir: root, env: env)
            begin
              600.times do
                state = app.query("SELECT state FROM divider_jobs").rows[0].string?(0) || ""
                break if state == "completed" || !w.running?
                Task.sleep(200.ms)
              end
            ensure
              w.signal(:TERM)
              code = w.wait.code || -1
            end
          ensure
            app.close
          end
          assert_equal("completed", state)
          assert_equal(0, code)
        ensure
          c.exec("DROP DATABASE IF EXISTS #{db}")
          c.close
        end
      end
    rescue PG::Testing::Unavailable => e
      omit(e.message)
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  def test_review_cases
    dir = CliTest.tmp
    begin
      assert_equal(1, bezel(["new", "test", "--bezel", CliTest.repo], dir)[0])
      assert_equal(1, bezel(["new", "time", "--bezel", CliTest.repo], dir)[0])
      assert_equal(1, bezel(["new", "result", "--bezel", CliTest.repo], dir)[0])
      assert_equal(1, bezel(["new", "range_error", "--bezel", CliTest.repo], dir)[0])
      assert_equal(1, bezel(["new", "shop", "--bezel", dir], dir)[0])
      assert(!File.exist?(File.join(dir, "shop")))
    ensure
      Dir.rm_rf(dir)
    end
    root = new_app
    begin
      # (Names whose plural the router would read back otherwise.)
      assert_equal(1, bezel(["gen", "resource", "movie", "title:string"], root)[0])
      assert(!File.exist?(File.join(root, "src/models/movie.qz")))
      # (A singular name stays as given.)
      assert_equal(0, bezel(["gen", "model", "status", "name:string"], root)[0])
      assert(read(root, "src/models/status.qz").include?("class Shop::Status < Rotor::Model"))
      assert_equal(1, bezel(["gen", "controller", "generated"], root)[0])
      # (A broken template elsewhere: nothing is left behind.)
      Dir.mkdir_p(File.join(root, "src/views/wip"))
      File.write(File.join(root, "src/views/wip/a.html.bz"), "<p>\n<b>x</p>")
      router = read(root, "src/router.qz")
      assert_equal(1, bezel(["gen", "controller", "contact"], root)[0])
      assert(!File.exist?(File.join(root, "src/controllers/contact_controller.qz")))
      assert(!File.exist?(File.join(root, "src/views/contact/index.html.bz")))
      assert_equal(router, read(root, "src/router.qz"))
      assert(!File.exist?(File.join(root, "src/views/contact")))
      # (A new directory with two files.)
      assert_equal(1, bezel(["gen", "controller", "two", "a", "b"], root)[0])
      assert(!File.exist?(File.join(root, "src/views/two")))
      File.delete(File.join(root, "src/views/wip/a.html.bz"))
      assert_equal(0, bezel(["gen", "controller", "contact"], root)[0])
      # (Second review: names.)
      assert_equal(1, bezel(["gen", "resource", "x_1", "title:string"], root)[0])
      assert_equal(1, bezel(["gen", "model", "router", "name:string"], root)[0])
      assert_equal(1, bezel(["gen", "model", "page_controller"], root)[0])
      assert_equal(1, bezel(["gen", "controller", "page"], root)[0])
      assert_equal(1, bezel(["gen", "controller", "xx", "render"], root)[0])
      assert_equal(1, bezel(["gen", "migration", "early", "--version", "01234567890123"], root)[0])
      # (A file where a directory goes: a message, not a trace.)
      File.write(File.join(root, "src/views/blog"), "")
      assert_equal(1, bezel(["gen", "controller", "blog"], root)[0])
      assert(!File.exist?(File.join(root, "src/controllers/blog_controller.qz")))
      File.delete(File.join(root, "src/views/blog"))
      # (Third review: declarations the scan sees, entries it skips.)
      File.write(File.join(root, "src/extra.qz"), "abstract class Shop::Post\nend\nmodule Shop::Things\n  data Item = (a: Int)\nend\n")
      assert_equal(1, bezel(["gen", "model", "post", "name:string"], root)[0])
      # (Shop::Things::Item is not Shop::Item.)
      assert_equal(0, bezel(["gen", "model", "item", "name:string"], root)[0])
      File.delete(File.join(root, "src/extra.qz"))
      File.write(File.join(root, "src/shop.qz"), "# The application.\r\nmodule Shop # root\r\n  enum Color\r\n    variant Red\r\n  end\r\n  module Admin\r\n    class Gadget\r\n    end\r\n  end\r\nend\r\nclass Shop::Things\r\n  class Widget\r\n  end\r\nend\r\n")
      assert_equal(1, bezel(["gen", "model", "color", "name:string"], root)[0])
      # (Deeper, or in another class: another namespace's.)
      assert_equal(0, bezel(["gen", "model", "gadget", "name:string"], root)[0])
      assert_equal(0, bezel(["gen", "model", "widget", "name:string"], root)[0])
      Dir.mkdir_p(File.join(root, "src/controllers/x.qz"))
      assert_equal(0, bezel(["gen", "model", "post", "name:string"], root)[0])
      assert_equal(1, bezel(["gen", "controller", "yy", "put_flash"], root)[0])
      # (A hand-written file among the generated ones stays.)
      File.write(File.join(root, "src/views/generated/helpers.qz"), "# mine\n")
      assert_equal(0, bezel(["templates"], root)[0])
      assert(File.exist?(File.join(root, "src/views/generated/helpers.qz")))
      # (The marker on the router's last line, without a line break.)
      parts = read(root, "src/router.qz").partition("# bezel gen: routes")
      File.write(File.join(root, "src/router.qz"), parts[0] + parts[1])
      assert_equal(0, bezel(["gen", "controller", "faq"], root)[0])
      assert(read(root, "src/router.qz").end_with?("      get \"/faq\", Shop::FaqController, :index\n      # bezel gen: routes"))
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end

  def test_templates_check_and_write
    root = new_app
    begin
      File.write(File.join(root, "src/views/page/home.html.bz"), "{@args conn: Bezel::Conn}\n<h1>Changed</h1>\n")
      assert_equal(1, bezel(["templates", "--check"], root)[0])
      status, out = bezel(["templates"], root)
      assert_equal([0, "  update  src/views/generated/page.qz\n"], [status, out])
      assert_equal(0, bezel(["templates", "--check"], root)[0])
      Dir.mkdir_p(File.join(root, "src/views/extra"))
      File.write(File.join(root, "src/views/extra/x.html.bz"), "<p>\n<b>x</p>")
      assert_equal(1, bezel(["templates"], root)[0])
      File.delete(File.join(root, "src/views/extra/x.html.bz"))
      File.write(File.join(root, "src/views/generated/old.qz"), "# Generated by `bezel templates` from the templates below: do not edit;\n")
      assert_equal(1, bezel(["templates", "--check"], root)[0])
      assert_equal([0, "  remove  src/views/generated/old.qz\n"], bezel(["templates"], root))
    ensure
      Dir.rm_rf(File.dirname(root))
    end
  end
end
