# The application's jobs: src/jobs/*.qz, each a `<App>::Jobs::<Name> <
# Divider::Job`, and src/jobs.qz, their list (`<App>::Jobs.all`) and the
# worker that runs them (`quarz run -- jobs`, what `bezel jobs` runs),
# written by `bezel new` and `bezel gen job`.
module Cli::Jobs
  # The job classes of src/jobs/, in file order.
  def self.found(app: Cli::App) -> Array[String]
    dir = File.join(app.root, "src", "jobs")
    classes = Array::Builder[String].new
    return classes.to_a unless File.directory?(dir)
    Dir.children(dir).select { |f| f.end_with?(".qz") }.sort.each do |f|
      # (A job, or an abstract base of the application's jobs, which is
      # not listed.)
      text = File.read(File.join(dir, f))
      next if text.match?(/^abstract\s+class\s/m) && !text.match?(/^class\s/m)
      c = text.match(/^class\s+([A-Za-z0-9_:]+)\s*</m)
      raise Cli::Error.new("src/jobs/#{f} declares no job class (`class ... < Divider::Job`)") if c.nil?
      classes << (c[1] || "")
    end
    classes.to_a
  end

  # The content of src/jobs.qz.
  def self.list(app: Cli::App) -> String
    m = app.module_name
    n = app.name
    <<~QZ
      # Generated by `bezel gen job` from src/jobs/: do not edit;
      # `bezel gen job NAME` adds one and writes this file again.

      # The application's jobs, and the worker that runs them.
      module #{m}::Jobs
        # The job classes.
        def self.all -> Array[Type[Divider::Job]] = [#{Cli::Jobs.found(app).join(", ")}]

        # Runs the jobs until TERM or INT (`quarz run -- jobs`, which
        # `bezel jobs` runs): a worker over DATABASE_URL (or the settings'),
        # with a queue of 5 at once for each queue the jobs name. The
        # configuration is a task's (`Bezel::Tasks.config`): SECRET_KEY_BASE
        # is not needed. The exit status.
        def self.serve -> Int
          jobs = all
          if jobs.empty?
            STDERR.puts "#{n}: no jobs to run (`bezel gen job NAME` makes one)"
            return 1
          end
          url = begin
            Bezel::Tasks.config(#{n.inspect}, #{m}::Config.settings).database_url
          rescue Bezel::ConfigError => e
            STDERR.puts "#{n}: \#{e.message}"
            return 1
          end
          if url.nil?
            STDERR.puts "#{n}: DATABASE_URL is not set"
            return 1
          end
          queues: Hash[Symbol, Int] = {}
          jobs.each { |j| queues = queues.put(j.job_queue.to_sym, 5) }
          Divider.serve(url, jobs: jobs, queues: queues)
          0
        end
      end
    QZ
  end

  # Writes src/jobs.qz when it changed.
  def self.write(app: Cli::App, out: IO) -> Void
    Cli.update(app.root, "src/jobs.qz", Cli::Jobs.list(app), out)
  end
end
