# The `bezel` command: generators and tasks for a bezel application.
module Cli
  # The application a command runs in: its directory, its cog's name and
  # the module its code lives in (`shop` and `Shop`).
  data App = (root: String, name: String, module_name: String)

  # A failure to report (`bezel: <message>`, status 1).
  class Error < StandardError
  end

  # Runs `bezel` with `argv` in the directory `cwd`; the exit status: 2
  # for a mistake in the arguments (`Cli::Commands`, the error and the
  # usage on standard error), 1 for a command that fails (`bezel:
  # <message>`), and what a task's program returns. The help, and
  # what the commands print, go to `out`.
  def self.run(argv: Array[String], cwd: String, out: IO = STDOUT) -> Int
    if argv.empty?
      out.print Cli::Commands::Bezel.help
      return 0
    end
    line = begin
      Cli::Commands::Bezel.parse(argv, exit: false)
    rescue CommandLine::Help => h
      out.print h.message
      return 0
    rescue CommandLine::Error => e
      STDERR.puts "#{e.program}: #{e.message}"
      STDERR.print e.usage
      STDERR.puts "Try '#{e.program} --help' for more information."
      return 2
    end
    begin
      Cli.dispatch(line, cwd, out)
    rescue Cli::Error => e
      STDERR.puts "bezel: #{e.message}"
      1
    rescue Bezel::Templates::Error => e
      STDERR.puts "bezel: #{e.message}"
      1
    rescue SystemCallError, IOError => e
      STDERR.puts "bezel: #{e.message}"
      1
    end
  end

  # Runs the command `line` holds.
  def self.dispatch(line: Cli::Commands::Bezel, cwd: String, out: IO) -> Int
    case line.command
    in Cli::Commands::New => c then Cli::Skeleton.command(c.name[0], c.bezel, cwd, out)
    in Cli::Commands::Gen => g then Cli::Gen.command(g, Cli.app(cwd), out)
    in Cli::Commands::Templates => c then Cli::Views.command(c.check, Cli.app(cwd), out)
    in Cli::Commands::Migrations => c then Cli::Migrations.command(c.check, Cli.app(cwd), out)
    in Cli::Commands::Routes => c then Cli.in_app(Cli.app(cwd), [Cli.quarz, "run", "--", "routes"] + c.args, out)
    in Cli::Commands::Migrate => c then Cli.in_app(Cli.app(cwd), [Cli.quarz, "run", "--", "migrate"] + c.args, out)
    in Cli::Commands::Rollback => c then Cli.in_app(Cli.app(cwd), [Cli.quarz, "run", "--", "rollback"] + c.args, out)
    in Cli::Commands::Status => c then Cli.in_app(Cli.app(cwd), [Cli.quarz, "run", "--", "status"] + c.args, out)
    in Cli::Commands::Tests => c then Cli.in_app(Cli.app(cwd), [Cli.quarz, "test"] + c.args, out)
    in Cli::Commands::Server then Cli::Server.command(Cli.app(cwd), out)
    in Cli::Commands::Jobs
      # (A development command, as `server`: BEZEL_ENV=dev unless set.)
      env: Hash[String, String] = (ENV["BEZEL_ENV"]? || "").empty? ? {"BEZEL_ENV" => "dev"} : Hash[String, String].new
      Cli.in_app(Cli.app(cwd), [Cli.quarz, "run", "--", "jobs"], out, env)
    in Cli::Commands::Help => c
      out.print Cli.help_of(c.topic.first?)
      0
    else
      raise Cli::Error.new("no command")
    end
  end

  # The help of the command `name` (`gen`), or `bezel`'s.
  def self.help_of(name: String?) -> String
    case name
    when nil then Cli::Commands::Bezel.help
    when "new" then Cli::Commands::New.help
    when "gen" then Cli::Commands::Gen.help
    when "templates" then Cli::Commands::Templates.help
    when "migrations" then Cli::Commands::Migrations.help
    when "routes" then Cli::Commands::Routes.help
    when "migrate" then Cli::Commands::Migrate.help
    when "rollback" then Cli::Commands::Rollback.help
    when "status" then Cli::Commands::Status.help
    when "test" then Cli::Commands::Tests.help
    when "server" then Cli::Commands::Server.help
    when "jobs" then Cli::Commands::Jobs.help
    when "help" then Cli::Commands::Help.help
    # (`Cli::Commands::Help#validate` refused another name.)
    else Cli::Commands::Bezel.help
    end
  end

  # The `quarz` the tasks run: $QUARZ, or `quarz` on the PATH.
  def self.quarz -> String = ENV["QUARZ"]? || "quarz"

  # The application around `cwd`.
  def self.app(cwd: String) -> Cli::App
    dir = File.expand_path(cwd)
    while true
      manifest = File.join(dir, "Cog.toml")
      if File.file?(manifest) && File.directory?(File.join(dir, "src"))
        m = File.read(manifest).match(/^\s*name\s*=\s*"([^"]+)"/m)
        raise Cli::Error.new("#{manifest} has no name") if m.nil?
        name = m[1] || ""
        return Cli::App.new(dir, name, Cli.camel(name))
      end
      parent = File.dirname(dir)
      raise Cli::Error.new("no application here: no directory with a Cog.toml and src/ around #{cwd}") if parent == dir
      dir = parent
    end
  end

  # `shop_admin` or `shop-admin` as `ShopAdmin`.
  def self.camel(name: String) -> String = name.split(/[_\-]/).reject(&:empty?).map(&:capitalize).join

  # `ShopAdmin` or `shop-admin` as `shop_admin`.
  def self.snake(name: String) -> String = Rotor::Inflector.underscore(name).gsub("-", "_")

  # `s` quoted for `sh`.
  def self.quote(s: String) -> String = "'" + s.gsub("'", "'\\''") + "'"

  # Runs `command` in the application's directory, its standard output
  # copied to `out` line by line as it comes and its standard error the
  # terminal's; its status (1 when a signal ended it).
  def self.in_app(app: Cli::App, command: Array[String], out: IO, env: Hash[String, String] = Hash[String, String].new) -> Int
    child = Process.spawn(*command, chdir: app.root, stdout: :pipe, env: env)
    # (TERM reaches bezel alone: passed on, so that the child, a worker
    # say, ends with it instead of running on. Ctrl-C reaches both: bezel
    # waits for the child to end of it, copying what it prints meanwhile.
    # The traps are set once for the process, on the child running now.)
    CHILD.set(child)
    Cli.trap_once
    child.stdout.each_line do |line|
      out.print line
      out.flush
    end
    child.wait.code || 1
  end

  # The child `in_app` runs now, which the traps signal.
  CHILD = Atom[Process::Child?].new(nil)
  # Whether the traps are set.
  TRAPPED = Atom[Bool].new(false)

  # Sets, once for the process, the traps of `in_app`: TERM passed on to
  # its child, INT left to it (bezel waits for it to end).
  def self.trap_once -> Void
    first = false
    TRAPPED.update do |was|
      first = !was
      true
    end
    return unless first
    Signal.trap(:TERM) { CHILD.get&.signal(:TERM) }
    Signal.trap(:INT) { nil }
  end

  # The files under `root`/`dir`, as paths from `root`, in name order (a
  # directory's entries by name, a directory's own in its place): `Dir.glob`
  # with a directory as its base. `**/` does not enter links to
  # directories (one to a directory above would loop), links to files are
  # listed, as the compiler collects src/. A hidden file or directory (its
  # name starting with a dot) is listed with `hidden: true` (the compiler
  # builds them), skipped otherwise: a wildcard does not match a leading
  # dot, so each hidden directory found (a link to one is not entered) is
  # globbed in turn, as a base, never as part of a pattern (its name may
  # hold `[`, `*` or `{`).
  def self.files_under(root: String, dir: String, hidden: Bool = false) -> Array[String]
    found = Array::Builder[String].new
    pending = [dir]
    patterns = hidden ? ["**/*", "**/.*"] : ["**/*"]
    until pending.empty?
      d = pending[0]
      pending = pending[1...pending.size]
      Dir.glob(patterns, base: File.join(root, d)).each do |inside|
        # (`.*` also names `.` itself.)
        next if inside == "." || inside.end_with?("/.")
        rel = File.join(d, inside)
        full = File.join(root, rel)
        if File.directory?(full)
          pending = pending.push(rel) if hidden && !File.symlink?(full) && File.basename(rel).start_with?(".")
        else
          found << rel
        end
      end
    end
    found.to_a.sort_by { |f| f.split("/") }
  end

  # Writes `content` to `path` under `root`, which must not exist yet.
  def self.create(root: String, path: String, content: String, out: IO) -> Void
    full = File.join(root, path)
    raise Cli::Error.new("#{path} exists already") if File.exist?(full)
    Dir.mkdir_p(File.dirname(full))
    File.write(full, content)
    out.puts "  create  #{path}"
  end

  # Writes `content` to `path` under `root` when it differs from what is
  # there.
  def self.update(root: String, path: String, content: String, out: IO) -> Void
    full = File.join(root, path)
    return if File.exist?(full) && File.read(full) == content
    verb = File.exist?(full) ? "update" : "create"
    Dir.mkdir_p(File.dirname(full))
    File.write(full, content)
    out.puts "  #{verb}  #{path}"
  end
end
