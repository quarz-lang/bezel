# `bezel server`: the application run with `quarz run` in its directory
# (`BEZEL_ENV=dev` unless set), its output on the terminal, and run again
# when a source, a template or the manifest changes.
module Cli::Server
  # How often the files are looked at.
  POLL = 500.ms
  # How long the application has to stop after TERM before KILL.
  STOP_GRACE = 5.seconds

  # Runs the command until SIGINT or SIGTERM.
  def self.command(args: Array[String], app: Cli::App, out: IO) -> Int
    raise Cli::Error.new("server takes no arguments, not #{args.join(" ")}") unless args.empty?
    stop = Channel[Nil].new
    Signal.trap(:INT) { stop.close }
    Signal.trap(:TERM) { stop.close }
    none: Hash[String, String] = {}
    Cli::Server.serve(app, out, stop, none)
  end

  # Serves until `stop` is closed; `env` adds to the application's
  # environment.
  def self.serve(app: Cli::App, out: IO, stop: Channel[Nil], env: Hash[String, String]) -> Int
    child_env = env.key?("BEZEL_ENV") || !(ENV["BEZEL_ENV"]? || "").empty? ? env : env.put("BEZEL_ENV", "dev")
    child: Process::Child? = nil
    begin
      while true
        # (Before starting: the templates compiled and the migrations
        # listed, as `bezel templates` and `bezel migrations` would.)
        ready = Cli::Server.prepare(app, out)
        seen = Cli::Server.snapshot(app)
        if ready
          out.puts "bezel: starting #{app.name} (#{Cli.quarz} run)"
          out.flush
          child = Process.spawn(Cli.quarz, "run", chdir: app.root, env: child_env)
        end
        reason = Cli::Server.wait_for_change(app, seen, stop, child)
        return 0 if reason == :stop
        Cli::Server.stop_child(child, out)
        child = nil
        out.puts(reason == :exited ? "bezel: #{app.name} exited; waiting for a change" : "bezel: a file changed; restarting")
        out.flush
        if reason == :exited
          # (Wait for the change before starting again.)
          return 0 if Cli::Server.wait_for_change(app, Cli::Server.snapshot(app), stop, nil) == :stop
        end
      end
    ensure
      Task.uncancellable { Cli::Server.stop_child(child, out) }
    end
  end

  # Compiles the templates and lists the migrations; false (the error
  # printed) when that fails, so that the application is not started.
  def self.prepare(app: Cli::App, out: IO) -> Bool
    Cli::Views.write(app, out)
    Cli.update(app.root, "src/migrations.qz", Cli::Migrations.list(app), out)
    true
  rescue Cli::Error => e
    STDERR.puts "bezel: #{e.message}"
    false
  rescue Bezel::Templates::Error => e
    STDERR.puts "bezel: #{e.message}"
    false
  end

  # The files whose change restarts the application, with their
  # modification times.
  def self.snapshot(app: Cli::App) -> Hash[String, Time]
    seen: Hash[String, Time] = {}
    Dir.glob(["src/**/*.qz", "src/**/*.html.bz", "Cog.toml", "Cog.local.toml"], app.root).each do |f|
      path = File.join(app.root, f)
      begin
        seen = seen.put(f, File.mtime(path))
      rescue SystemCallError
        # (Removed meanwhile.)
      end
    end
    seen
  end

  # Waits until a watched file changes (`:changed`), the child exits
  # (`:exited`), or `stop` is closed (`:stop`).
  def self.wait_for_change(app: Cli::App, seen: Hash[String, Time], stop: Channel[Nil], child: Process::Child?) -> Symbol
    while true
      begin
        Channel.select do |s|
          s.receive(stop) { |_| nil }
          s.after(POLL) { nil }
        end
      rescue Channel::Closed
        return :stop
      end
      return :changed if Cli::Server.snapshot(app) != seen
      return :exited if child && !child.running?
    end
  end

  # Stops `child`: TERM, then KILL after `STOP_GRACE`.
  def self.stop_child(child: Process::Child?, out: IO) -> Void
    return if child.nil? || !child.running?
    child.signal(:TERM)
    begin
      Task.timeout(STOP_GRACE) { child.wait }
    rescue Task::Timeout
      child.kill
      child.wait
    end
    nil
  end
end
