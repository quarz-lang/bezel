# `bezel templates [--check]`: each directory of src/views/ (but
# `generated`) holding `*.html.bz` templates is compiled into
# src/views/generated/<dir>.qz, the module `<App>::<Dir>View` with a
# method per template (src/views/user/show.html.bz is
# `Shop::UserView.show`).
module Cli::Views
  # Runs the command.
  def self.command(args: Array[String], app: Cli::App, out: IO) -> Int
    check = args == ["--check"]
    raise Cli::Error.new("templates takes --check or nothing, not #{args.join(" ")}") unless check || args.empty?
    check ? Cli::Views.check(app, out) : Cli::Views.write(app, out)
  end

  # The generated files, by path from the root, for the templates there
  # are now.
  def self.compile(app: Cli::App) -> Hash[String, String]
    out: Hash[String, String] = {}
    views = File.join(app.root, "src", "views")
    return out unless File.directory?(views)
    Dir.children(views).sort.each do |dir|
      next if dir == "generated" || !File.directory?(File.join(views, dir))
      files = Dir.children(File.join(views, dir)).select { |f| f.end_with?(".html.bz") }.sort
      next if files.empty?
      raise Cli::Error.new("src/views/#{dir}: a views directory is named in snake_case") unless dir.match?(/\A[a-z][a-z0-9_]*\z/)
      sources = files.map do |f|
        name = f.delete_suffix(".html.bz")
        raise Cli::Error.new("src/views/#{dir}/#{f}: a template's name is a method's (snake_case)") unless name.match?(/\A[a-z_][a-z0-9_]*\z/)
        rel = "src/views/#{dir}/#{f}"
        Bezel::Templates::Source.new(rel, name, File.read(File.join(app.root, rel)))
      end
      mod = "#{app.module_name}::#{Cli.camel(dir)}View"
      out = out.put("src/views/generated/#{dir}.qz", Bezel::Templates.compile_module(mod, sources))
    end
    out
  end

  # The generated files there are now, by path from the root.
  def self.existing(app: Cli::App) -> Array[String]
    gen = File.join(app.root, "src", "views", "generated")
    none: Array[String] = []
    return none unless File.directory?(gen)
    Dir.children(gen).select { |f| f.end_with?(".qz") }.sort.map { |f| "src/views/generated/#{f}" }
  end

  # Writes what changed and removes what has no templates any more.
  def self.write(app: Cli::App, out: IO) -> Int
    files = Cli::Views.compile(app)
    files.each { |path, content| Cli.update(app.root, path, content, out) }
    Cli::Views.existing(app).each do |path|
      next if files.key?(path)
      File.delete(File.join(app.root, path))
      out.puts "  remove  #{path}"
    end
    0
  end

  # Fails (1) naming each generated file that is stale, missing or left
  # over.
  def self.check(app: Cli::App, out: IO) -> Int
    files = Cli::Views.compile(app)
    stale = Array::Builder[String].new
    files.each do |path, content|
      full = File.join(app.root, path)
      stale << "#{path} is stale" if !File.exist?(full) || File.read(full) != content
    end
    Cli::Views.existing(app).each { |path| stale << "#{path} has no templates" unless files.key?(path) }
    problems = stale.to_a
    return 0 if problems.empty?
    problems.each { |p| STDERR.puts "bezel: #{p}" }
    STDERR.puts "bezel: run `bezel templates`"
    1
  end
end

# `bezel migrations [--check]`: src/migrations.qz lists the classes of
# src/migrations/<version>_<name>.qz in version order
# (`<App>::Migrations.all`, which src/main.qz gives `Bezel.main`).
module Cli::Migrations
  # Runs the command.
  def self.command(args: Array[String], app: Cli::App, out: IO) -> Int
    check = args == ["--check"]
    raise Cli::Error.new("migrations takes --check or nothing, not #{args.join(" ")}") unless check || args.empty?
    content = Cli::Migrations.list(app)
    path = File.join(app.root, "src", "migrations.qz")
    if check
      return 0 if File.exist?(path) && File.read(path) == content
      STDERR.puts "bezel: src/migrations.qz is stale: run `bezel migrations`"
      return 1
    end
    Cli.update(app.root, "src/migrations.qz", content, out)
    0
  end

  # The migrations of src/migrations/: version and class, in version
  # order.
  def self.found(app: Cli::App) -> Array[[Int, String]]
    dir = File.join(app.root, "src", "migrations")
    rows = Array::Builder[[Int, String]].new
    return rows.to_a unless File.directory?(dir)
    Dir.children(dir).select { |f| f.end_with?(".qz") }.sort.each do |f|
      m = f.match(/\A([0-9]{14})_[a-z0-9_]+\.qz\z/)
      raise Cli::Error.new("src/migrations/#{f}: a migration's file is <14-digit version>_<snake_name>.qz") if m.nil?
      c = File.read(File.join(dir, f)).match(/^class\s+([A-Za-z0-9_:]+)\s*<\s*Rotor::Migration\b/m)
      raise Cli::Error.new("src/migrations/#{f} declares no `class ... < Rotor::Migration`") if c.nil?
      rows << [(m[1] || "0").to_i, c[1] || ""]
    end
    rows.to_a.sort_by { |r| r[0] }
  end

  # The content of src/migrations.qz.
  def self.list(app: Cli::App) -> String
    classes = Cli::Migrations.found(app).map { |r| r[1] }
    <<~QZ
      # Generated by `bezel migrations` from src/migrations/: do not edit;
      # `bezel gen migration NAME` adds one and writes this file again.

      # The application's migrations.
      module #{app.module_name}::Migrations
        # The migrations, oldest first.
        def self.all -> Array[Type[Rotor::Migration]] = [#{classes.join(", ")}]
      end
    QZ
  end
end
