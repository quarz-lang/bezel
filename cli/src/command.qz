# The `bezel` command's arguments, declared with the standard library's
# `CommandLine`: one class per command, below `Cli::Commands::Bezel`.
# `Cli.run` parses with them and runs the command given.
module Cli::Commands
  # `bezel new NAME [--bezel PATH]`.
  class New < CommandLine
    program "bezel new"
    about "A new application in the directory NAME."
    option :bezel, String, default: nil, arg: "PATH", help: "the bezel checkout to depend on (its root)"
    rest :name, min: 1, max: 1, arg: "NAME"
  end

  # `bezel gen controller NAME [ACTION...]`.
  class GenController < CommandLine
    program "bezel gen controller"
    banner "usage: bezel gen controller NAME [ACTION...]"
    about "A controller with an action and a template per ACTION (index)."
    rest :args, min: 1, arg: "NAME"
  end

  # `bezel gen model NAME [FIELD:TYPE...]`.
  class GenModel < CommandLine
    program "bezel gen model"
    banner "usage: bezel gen model NAME [FIELD:TYPE...]"
    about "A rotor model, its changeset and its migration."
    rest :args, min: 1, arg: "NAME"
  end

  # `bezel gen migration NAME [--version VERSION]`.
  class GenMigration < CommandLine
    program "bezel gen migration"
    about "An empty migration."
    option :version, String, default: nil, arg: "VERSION", help: "its version (by default the time now, UTC)"
    rest :name, min: 1, max: 1, arg: "NAME"
  end

  # `bezel gen job NAME [FIELD:TYPE...]`.
  class GenJob < CommandLine
    program "bezel gen job"
    banner "usage: bezel gen job NAME [FIELD:TYPE...]"
    about "A divider job, with arguments of those fields."
    rest :args, min: 1, arg: "NAME"
  end

  # `bezel gen resource NAME FIELD:TYPE...`.
  class GenResource < CommandLine
    program "bezel gen resource"
    banner "usage: bezel gen resource NAME FIELD:TYPE..."
    about "A model, its migration, a controller of the seven actions, its views, and its routes."
    rest :args, min: 1, arg: "NAME"

    def validate -> Void
      error("needs at least one FIELD:TYPE") if args.size < 2
    end
  end

  # `bezel gen KIND ...`.
  class Gen < CommandLine
    program "bezel gen"
    about "Generate code into the application.\n\nFIELD:TYPE types: string, text, integer, float, boolean, time."
    command :controller, GenController
    command :model, GenModel
    command :migration, GenMigration
    command :job, GenJob
    command :resource, GenResource
  end

  # `bezel templates [--check]`.
  class Templates < CommandLine
    program "bezel templates"
    about "Compile src/views/*/*.html.bz into src/views/generated/."
    flag :check, help: "only say whether the generated files are up to date"
  end

  # `bezel migrations [--check]`.
  class Migrations < CommandLine
    program "bezel migrations"
    about "Write src/migrations.qz, the list of src/migrations/."
    flag :check, help: "only say whether src/migrations.qz is up to date"
  end

  # `bezel routes`: `quarz run -- routes` with the arguments as given.
  class Routes < CommandLine
    program "bezel routes"
    about "Print the routes."
    rest :args, raw: true, arg: "ARGS"
  end

  # `bezel migrate [--to VERSION]`.
  class Migrate < CommandLine
    program "bezel migrate"
    about "Run the pending migrations (DATABASE_URL): [--to VERSION]."
    rest :args, raw: true, arg: "ARGS"
  end

  # `bezel rollback [--steps N | --to VERSION]`.
  class Rollback < CommandLine
    program "bezel rollback"
    about "Roll migrations back: [--steps N | --to VERSION]."
    rest :args, raw: true, arg: "ARGS"
  end

  # `bezel status`.
  class Status < CommandLine
    program "bezel status"
    about "Each migration, up or pending."
    rest :args, raw: true, arg: "ARGS"
  end

  # `bezel test [ARGS...]`: `quarz test` with the arguments as given.
  class Tests < CommandLine
    program "bezel test"
    about "Run the tests (quarz test, with ARGS)."
    rest :args, raw: true, arg: "ARGS"
  end

  # `bezel server`.
  class Server < CommandLine
    program "bezel server"
    about "Run the application (BEZEL_ENV=dev unless set), and again when a source or template changes."
  end

  # `bezel jobs`.
  class Jobs < CommandLine
    program "bezel jobs"
    about "Run the application's jobs: a divider worker (BEZEL_ENV=dev unless set)."
  end

  # `bezel help [COMMAND]`.
  class Help < CommandLine
    program "bezel help"
    about "Print this help, or a command's."
    rest :topic, max: 1, arg: "COMMAND"

    # The commands `help` knows.
    NAMES = ["new", "gen", "templates", "migrations", "routes", "migrate", "rollback", "status", "test", "server", "jobs",
             "help"]

    def validate -> Void
      t = topic.first?
      error("unknown command '#{t}' (one of #{NAMES.join(", ")})") if !t.nil? && !NAMES.include?(t)
    end
  end

  # The `bezel` command.
  class Bezel < CommandLine
    program "bezel"
    about "Generators and tasks for a bezel application. Commands but `new` run in the\napplication around the current directory (its Cog.toml)."
    command :new, New
    command :gen, Gen
    command :templates, Templates
    command :migrations, Migrations
    command :routes, Routes
    command :migrate, Migrate
    command :rollback, Rollback
    command :status, Status
    command :test, Tests
    command :server, Server
    command :jobs, Jobs
    command :help, Cli::Commands::Help
  end
end
