# `bezel gen controller|model|migration|resource`. Each generator makes
# its files and routes first, then writes them: when a later step fails
# (a template elsewhere that does not compile), what it wrote is taken
# back.
module Cli::Gen
  # The field types `gen model` and `gen resource` take, as Quarz types.
  TYPES = {"string" => "String", "text" => "String", "integer" => "Int", "int" => "Int", "float" => "Float",
           "boolean" => "Bool", "bool" => "Bool", "time" => "Time", "datetime" => "Time"}

  # A model's field: its name, Quarz type, and whether it is long text.
  data Field = (name: String, type: String, text: Bool)

  # The line of the router `gen` adds its routes before.
  MARKER = "# bezel gen: routes"

  # Runs the command.
  def self.command(args: Array[String], app: Cli::App, out: IO) -> Int
    kind = args.first?
    rest = args.empty? ? args : args[1...args.size]
    case kind
    when "controller" then Cli::Gen.controller(rest, app, out)
    when "model" then Cli::Gen.model(rest, app, out)
    when "migration" then Cli::Gen.migration_command(rest, app, out)
    when "resource" then Cli::Gen.resource(rest, app, out)
    else raise Cli::Error.new("gen takes controller, model, migration or resource, not #{(kind || "nothing").inspect}")
    end
  end

  # The snake_case name of `arg` (`UserProfile` or `user_profile`).
  def self.name_of(arg: String?, what: String) -> String
    raise Cli::Error.new("gen #{what} needs a NAME") if arg.nil?
    n = Cli.snake(arg)
    raise Cli::Error.new("#{arg.inspect} is not a name (letters, digits and _)") unless n.match?(/\A[a-z][a-z0-9_]*\z/)
    # (The class name must give the name back, as `form_for` derives a
    # form's parameter key from it: `x_1` is X1, read back `x1`.)
    unless Cli.snake(Cli.camel(n)) == n
      raise Cli::Error.new("#{n}: its class #{Cli.camel(n)} reads back as #{Cli.snake(Cli.camel(n))}; use that name")
    end
    n
  end

  # The fields of `specs` (`title:string`).
  def self.fields(specs: Array[String]) -> Array[Field]
    seen: Set[String] = Set.new
    specs.map do |spec|
      name, _, type = spec.partition(":")
      t = TYPES[type]?
      raise Cli::Error.new("#{spec.inspect}: a field is NAME:TYPE, the type one of #{TYPES.keys.join(", ")}") if t.nil?
      raise Cli::Error.new("#{name.inspect} is not a field name (snake_case)") unless name.match?(/\A[a-z][a-z0-9_]*\z/)
      raise Cli::Error.new("#{name}: id, created_at and updated_at are the model's own") if ["id", "created_at", "updated_at"].include?(name)
      raise Cli::Error.new("#{name} is given twice") if seen.include?(name)
      seen = seen.add(name)
      Field.new(name, t, type == "text")
    end
  end

  # Fails when the application declares `name` (`Shop::Post`) already:
  # a line of src/ starting `class`, `module`, `data`, `enum` or `type`
  # (after `abstract`) and naming it whole, or naming its last part at
  # the first level inside a top-level `module Shop ... end` (the only
  # place a nested declaration is the application's own: modules are not
  # reopened). (A text scan: a heredoc's line may be taken for a
  # declaration, which the message names.)
  def self.undeclared(app: Cli::App, name: String) -> Void
    decl = "[ \\t]*(abstract[ \\t]+)?(class|module|data|enum|type)[ \\t]+"
    tail = "([^A-Za-z0-9_:].*)?\\z"
    whole = Regexp.new("\\A" + decl + Regexp.escape(name) + tail)
    last = name.split("::").last? || name
    nested = Regexp.new("\\A" + decl + Regexp.escape(last) + tail)
    opens = Regexp.new("\\Amodule[ \\t]+" + Regexp.escape(app.module_name) + "[ \\t]*(#.*)?\\z")
    Dir.glob("src/**/*.qz", app.root).each do |f|
      full = File.join(app.root, f)
      # (As the compiler: files only, not a directory or a dangling link.)
      next unless File.file?(full)
      inside = false
      level: String? = nil
      File.read(full).split("\n").each do |raw|
        line = raw.delete_suffix("\r")
        found = line.match?(whole)
        if inside
          if line.match?(/\Aend\b/)
            inside = false
          elsif !line.strip.empty? && !line.strip.start_with?("#")
            indent = line[0, line.size - line.lstrip.size]
            level = indent if level.nil?
            found = true if indent == level && line.match?(nested)
          end
        elsif line.match?(opens)
          inside = true
          level = nil
        end
        raise Cli::Error.new("#{name} is declared already (#{f})") if found
      end
    end
  end

  # Names an action cannot have: `Bezel::Controller`'s and `Object`'s
  # methods.
  RESERVED_ACTIONS = ["dispatch", "halt", "initialize", "json", "put_flash", "put_status", "redirect", "render", "repo",
                      "send_file", "text", "controller_plugs", "class", "dup", "hash", "inspect", "instance_exec", "tap",
                      "then", "to_s"]

  # Writes `files` (path from the root, content), none of which may
  # exist, adds `routes` to the router, then recompiles the templates
  # and the migrations' list when `files` holds some; takes everything
  # back when a step fails.
  def self.apply(app: Cli::App, files: Array[[String, String]], routes: Array[String], out: IO) -> Void
    files.each { |f| raise Cli::Error.new("#{f[0]} exists already") if File.exist?(File.join(app.root, f[0])) }
    router = File.join(app.root, "src", "router.qz")
    old_router = File.exist?(router) ? File.read(router) : nil
    new_router = routes.empty? ? nil : Cli::Gen.with_routes(old_router || "", routes)
    created = Array::Builder[String].new
    # (The directories it makes, to take back too: deepest last.)
    made_dirs: Array[String] = []
    files.each do |f|
      d = File.dirname(File.join(app.root, f[0]))
      while !File.exist?(d) && !made_dirs.include?(d)
        made_dirs = made_dirs.push(d)
        d = File.dirname(d)
      end
    end
    begin
      files.each do |f|
        Cli.create(app.root, f[0], f[1], out)
        created << f[0]
      end
      nr = new_router
      if nr
        File.write(router, nr)
        out.puts "  update  src/router.qz"
      end
      Cli::Views.write(app, out) if files.any? { |f| f[0].end_with?(".html.bz") }
      none: Array[String] = []
      Cli::Migrations.command(none, app, out) if files.any? { |f| f[0].start_with?("src/migrations/") }
    rescue Exception => e
      # (Each undoing step's own error would hide `e`: ignored.)
      created.to_a.each do |p|
        begin
          next unless File.exist?(File.join(app.root, p))
          File.delete(File.join(app.root, p))
          out.puts "  remove  #{p}"
        rescue SystemCallError
        end
      end
      made_dirs.sort_by { |d| -d.size }.each do |d|
        begin
          if File.directory?(d) && Dir.empty?(d)
            Dir.rmdir(d)
            out.puts "  remove  #{d.delete_prefix(app.root + "/")}/"
          end
        rescue SystemCallError
          # (The original error is the one to report.)
        end
      end
      orig = old_router
      begin
        File.write(router, orig) if orig && !new_router.nil?
      rescue SystemCallError
      end
      raise e
    end
    if !routes.empty? && new_router.nil?
      out.puts "Add to the router (src/router.qz has no `#{MARKER}` line):"
      routes.each { |l| out.puts "  #{l}" }
    end
  end

  # `text` (the router) with `lines` added before its marker line, at its
  # indentation; nil when it has no marker.
  def self.with_routes(text: String, lines: Array[String]) -> String?
    at = text.index(MARKER)
    return nil if at.nil?
    line_start = (text[0, at].rindex("\n") || -1) + 1
    indent = text[line_start, at - line_start]
    return nil unless indent.strip.empty?
    added = lines.map { |l| "#{indent}#{l}\n" }.join
    text[0, line_start] + added + text[line_start, text.size - line_start]
  end

  # `gen controller NAME [ACTION...]`.
  def self.controller(args: Array[String], app: Cli::App, out: IO) -> Int
    n = Cli::Gen.name_of(args.first?, "controller")
    raise Cli::Error.new("#{n}: src/views/#{n}/ is not for a controller's templates") if n == "generated" || n == "layouts"
    actions = args.size > 1 ? args[1...args.size] : ["index"]
    actions.each do |a|
      raise Cli::Error.new("#{a.inspect} is not an action name (snake_case)") unless a.match?(/\A[a-z][a-z0-9_]*\z/)
    end
    raise Cli::Error.new("an action is given twice") unless actions.uniq.size == actions.size
    actions.each { |a| raise Cli::Error.new("#{a}: a controller's own method, not an action's name") if RESERVED_ACTIONS.include?(a) }
    m = app.module_name
    cls = "#{m}::#{Cli.camel(n)}Controller"
    view = "#{m}::#{Cli.camel(n)}View"
    Cli::Gen.undeclared(app, cls)
    Cli::Gen.undeclared(app, view)
    defs = actions.map do |a|
      "  def #{a}(conn: Bezel::Conn) -> Bezel::Conn\n" +
        "    render(conn, #{m}::LayoutsView.app(conn, #{Cli.camel(n).inspect}, #{view}.#{a}(conn)))\n" +
        "  end\n"
    end
    files: Array[[String, String]] = [["src/controllers/#{n}_controller.qz",
                                       "# The #{n} pages.\nclass #{cls} < Bezel::Controller\n  controller\n\n#{defs.join("\n")}end\n"]]
    actions.each do |a|
      tpl: [String, String] = ["src/views/#{n}/#{a}.html.bz",
                               "{@args conn: Bezel::Conn}\n<h1>#{Cli.camel(n)}: #{a}</h1>\n<p>This page is src/views/#{n}/#{a}.html.bz.</p>\n"]
      files = files.push(tpl)
    end
    routes = actions.map { |a| "get \"/#{n}#{a == "index" ? "" : "/#{a}"}\", #{cls}, :#{a}" }
    Cli::Gen.apply(app, files, routes, out)
    0
  end

  # `gen migration NAME [--version V]`: an empty migration.
  def self.migration_command(args: Array[String], app: Cli::App, out: IO) -> Int
    version: String? = nil
    names = Array::Builder[String].new
    i = 0
    while i < args.size
      if args[i] == "--version"
        raise Cli::Error.new("--version needs a value") if i + 1 >= args.size
        version = args[i + 1]
        i += 2
      else
        names << args[i]
        i += 1
      end
    end
    given = names.to_a
    raise Cli::Error.new("gen migration takes one NAME") unless given.size == 1
    none: Array[String] = []
    Cli::Gen.apply(app, [Cli::Gen.migration(app, Cli::Gen.name_of(given[0], "migration"), "", version)], none, out)
    0
  end

  # The version of a new migration: the UTC time now, or one after the
  # latest when that is not later (two made within a second).
  def self.next_version(found: Array[[Int, String]]) -> String
    now = Time.now.utc.strftime("%Y%m%d%H%M%S").to_i
    latest = found.empty? ? 0 : found[found.size - 1][0]
    (now > latest ? now : latest + 1).to_s
  end

  # The migration `name` (its `change` body `body`): its path and
  # content.
  def self.migration(app: Cli::App, name: String, body: String, version: String?) -> [String, String]
    found = Cli::Migrations.found(app)
    v = version || Cli::Gen.next_version(found)
    raise Cli::Error.new("#{v.inspect} is not a version (14 digits, a UTC time, not starting with 0)") unless v.match?(/\A[1-9][0-9]{13}\z/)
    cls = "#{app.module_name}::Migrations::#{Cli.camel(name)}"
    found.each do |row|
      raise Cli::Error.new("#{cls} exists already") if row[1] == cls
      raise Cli::Error.new("a migration has the version #{v} already") if row[0] == v.to_i
    end
    content = "# #{Cli.camel(name)}.\n" +
              "class #{cls} < Rotor::Migration\n" +
              "  version #{v}\n\n" +
              "  def change -> Void\n" +
              body +
              "  end\nend\n"
    ["src/migrations/#{v}_#{name}.qz", content]
  end

  # `gen model NAME [FIELD:TYPE...]` (NAME singular).
  def self.model(args: Array[String], app: Cli::App, out: IO) -> Int
    n = Cli::Gen.name_of(args.first?, "model")
    fields = Cli::Gen.fields(args.size > 1 ? args[1...args.size] : Array[String].new)
    none: Array[String] = []
    Cli::Gen.apply(app, Cli::Gen.model_files(app, n, fields), none, out)
    0
  end

  # The model `n`, with its changeset, and its migration.
  def self.model_files(app: Cli::App, n: String, fields: Array[Field]) -> Array[[String, String]]
    m = app.module_name
    cls = "#{m}::#{Cli.camel(n)}"
    Cli::Gen.undeclared(app, cls)
    raise Cli::Error.new("#{n}: #{cls} would be the application's own (Config, Router, Endpoint, Migrations)") if ["config", "router", "endpoint", "migrations"].include?(n)
    table = Rotor::Inflector.pluralize(n)
    columns = fields.map { |f| "    column :#{f.name}, #{f.type}\n" }.join
    names = fields.map { |f| ":#{f.name}" }.join(", ")
    human = n.gsub("_", " ")
    content = "# A #{human}.\n" +
              "class #{cls} < Rotor::Model\n" +
              "  table #{table.inspect} do\n" +
              "    column :id, Int, primary: true\n" +
              columns +
              "    timestamps\n" +
              "  end\n\n" +
              "  # A changeset of `params` (a form's) for a new #{human}.\n" +
              "  def self.changeset(params: Hash[String, Object?]) -> Rotor::Changeset[#{cls}]\n" +
              "    Rotor::Changeset.cast(#{cls}, params, [#{names}]).validate_required([#{names}])\n" +
              "  end\n\n" +
              "  # A changeset of `params` for this #{human}.\n" +
              "  def changeset(params: Hash[String, Object?]) -> Rotor::Changeset[#{cls}]\n" +
              "    Rotor::Changeset.cast(self, params, [#{names}]).validate_required([#{names}])\n" +
              "  end\n" +
              "end\n"
    body = "    create_table :#{table} do |t|\n" +
           fields.map { |f| "      t.column :#{f.name}, #{f.type}\n" }.join +
           "      t.timestamps\n    end\n"
    [Cli::Gen.migration(app, "create_#{table}", body, nil), ["src/models/#{n}.qz", content]]
  end

  # `gen resource NAME [FIELD:TYPE...]` (NAME singular): the model, its
  # migration, a controller of the seven actions, its views (DSL code in
  # src/views/<plural>_view.qz) and `resources` in the router.
  def self.resource(args: Array[String], app: Cli::App, out: IO) -> Int
    n = Cli::Gen.name_of(args.first?, "resource")
    fields = Cli::Gen.fields(args.size > 1 ? args[1...args.size] : Array[String].new)
    raise Cli::Error.new("gen resource needs at least one FIELD:TYPE") if fields.empty?
    plural = Rotor::Inflector.pluralize(n)
    raise Cli::Error.new("#{n}: its plural is the same word; name it otherwise") if plural == n
    # (The router names a resource's routes from its path's plural.)
    back = Rotor::Inflector.singularize(plural)
    unless back == n
      raise Cli::Error.new("#{n}: the router would name its routes `#{back}` (from the plural `#{plural}`); give a name whose plural singularizes back to it")
    end
    Cli::Gen.undeclared(app, "#{app.module_name}::#{Cli.camel(plural)}Controller")
    Cli::Gen.undeclared(app, "#{app.module_name}::#{Cli.camel(plural)}View")
    ctl: [String, String] = ["src/controllers/#{plural}_controller.qz", Cli::Resource.controller(app, n, plural)]
    views: [String, String] = ["src/views/#{plural}_view.qz", Cli::Resource.views(app, n, plural, fields)]
    files = Cli::Gen.model_files(app, n, fields).push(ctl).push(views)
    raise Cli::Error.new("src/views/#{plural}/ exists already") if File.exist?(File.join(app.root, "src", "views", plural))
    Cli::Gen.apply(app, files, ["resources \"/#{plural}\", #{app.module_name}::#{Cli.camel(plural)}Controller"], out)
    0
  end
end
