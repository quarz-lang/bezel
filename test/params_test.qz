require "test"

class ParamsTest < Test::Case
  def test_query_flat_and_last_wins
    ps = Bezel::Params.from_query("a=1&b=x+y&a=2&c=%41")
    assert_equal("2", ps.fetch("a"))
    assert_equal("x y", ps.fetch("b"))
    assert_equal("A", ps.fetch("c"))
    assert_equal(["a", "b", "c"], ps.keys)
  end

  def test_query_nesting
    ps = Bezel::Params.from_query("user[email]=a%40b&user[name]=Ann&tags[]=x&tags[]=y&deep[a][b]=1")
    assert_equal("a@b", ps["user"].fetch("email"))
    assert_equal("Ann", ps["user"].fetch("name"))
    assert_equal(["x", "y"], ps.array("tags"))
    assert_equal("1", ps["deep"]["a"].fetch("b"))
  end

  def test_list_of_maps
    ps = Bezel::Params.from_query("items[][id]=1&items[][qty]=2&items[][id]=3")
    plain = ps.to_h["items"]
    assert_equal("[{\"id\" => \"1\", \"qty\" => \"2\"}, {\"id\" => \"3\"}]", plain.inspect)
  end

  def test_unclosed_bracket_is_a_plain_name
    ps = Bezel::Params.from_query("a[b=1&[x]=2")
    assert_equal("1", ps.fetch("a[b"))
    assert_equal("2", ps.fetch("[x]"))
  end

  def test_bad_percent_encoding_is_bad_request
    e = assert_raise(Bezel::BadRequest) { Bezel::Params.from_query("a=%ff") }
    assert_equal(400, e.as(Bezel::BadRequest).status)
  end

  def test_typed_readers
    ps = Bezel::Params.from_query("n=12&neg=-3&f=1.5&b=on&no=0&empty=&s=abc&big=99999999999999999999")
    assert_equal(12, ps.int("n"))
    assert_equal(-3, ps.int("neg"))
    assert_equal(1.5, ps.float("f"))
    assert_true(ps.bool("b"))
    assert_false(ps.bool("no"))
    assert_false(ps.bool("missing"))
    assert_nil(ps.int?("empty"))
    assert_nil(ps.int?("missing"))
    assert_raise(Bezel::BadRequest) { ps.int("s") }
    assert_raise(Bezel::BadRequest) { ps.int("missing") }
    assert_raise(Bezel::BadRequest) { ps.int("big") }
    assert_raise(Bezel::BadRequest) { ps.float("s") }
    assert_raise(Bezel::BadRequest) { ps.bool("s") }
    assert_raise(Bezel::BadRequest) { ps.fetch("missing") }
    assert_equal("d", ps.fetch("missing", "d"))
    assert_raise(Bezel::BadRequest) { ps["s"] }
    assert_nil(ps["s"]?)
  end

  def test_json
    ps = Bezel::Params.from_json(JSON.parse("{\"id\": 3, \"ok\": true, \"none\": null, \"user\": {\"email\": \"e\"}, \"tags\": [\"a\", 2]}"))
    assert_equal(3, ps.int("id"))
    assert_true(ps.bool("ok"))
    assert_false(ps.key?("none"))
    assert_equal("e", ps["user"].fetch("email"))
    assert_equal(["a", "2"], ps.array("tags"))
    arr = Bezel::Params.from_json(JSON.parse("[1, 2]"))
    assert_equal(["1", "2"], arr.array("_json"))
  end

  def test_merge_later_wins_and_maps_merge
    a = Bezel::Params.from_query("id=1&user[name]=a&x=1")
    b = Bezel::Params.from_query("id=2&user[email]=e")
    m = a.merge(b)
    assert_equal("2", m.fetch("id"))
    assert_equal("a", m["user"].fetch("name"))
    assert_equal("e", m["user"].fetch("email"))
    assert_equal("1", m.fetch("x"))
    assert_equal("9", m.merge(Bezel::Params.of({"id" => "9"})).fetch("id"))
  end

  def test_array_errors
    ps = Bezel::Params.from_query("m[a]=1&l[][a]=1")
    assert_raise(Bezel::BadRequest) { ps.array("m") }
    assert_raise(Bezel::BadRequest) { ps.array("l") }
    assert_true(ps.array("missing").empty?)
  end

  def test_rack_list_of_maps
    ps = Bezel::Params.from_query("a[][b][c]=1&a[][b][d]=2&a[][b][c]=3")
    assert_equal("[{\"b\" => {\"c\" => \"1\", \"d\" => \"2\"}}, {\"b\" => {\"c\" => \"3\"}}]", ps.to_h["a"].inspect)
  end

  def test_conflicts_are_bad_requests
    ["a=1&a[]=2", "a[]=1&a[b]=2", "a[b]=1&a=2&a[c]=3", "a[][]=1", "a[b]=1&a[]=2"].each do |q|
      assert_raise(Bezel::BadRequest) { Bezel::Params.from_query(q) }
    end
    assert_equal("2", Bezel::Params.from_query("a[]=1&a=2").fetch("a"))
  end

  def test_depth_is_limited
    deep = "a" + "[b]" * 32 + "=1"
    assert_nothing_raised { Bezel::Params.from_query(deep) }
    assert_raise(Bezel::BadRequest) { Bezel::Params.from_query("a" + "[b]" * 33 + "=1") }
    assert_raise(Bezel::BadRequest) { Bezel::Params.from_query("a" + "[b]" * 15_000 + "=1") }
  end

  def test_large_forms_are_linear
    list = (0...40_000).map { |i| "t[]=#{i}" }.join("&")
    map = (0...40_000).map { |i| "u[k#{i}]=#{i}" }.join("&")
    started = Time.monotonic
    ps = Bezel::Params.from_query(list + "&" + map)
    assert_equal(40_000, ps.array("t").size)
    assert_equal(40_000, ps["u"].size)
    assert_compare(Time.monotonic - started, :<, 3.seconds)
  end
end
