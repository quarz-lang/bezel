require "json"
require "test"

class ConfigTest < Test::Case
  def load(environ: Hash[String, String], settings: Hash[Symbol, Bezel::Settings] = {}) -> Bezel::Config
    Bezel::Config.load("shop", settings, {"BEZEL_ENV" => "dev"}.merge(environ), quiet: true)
  end

  def test_unset_env_is_prod
    e = assert_raise(Bezel::ConfigError) { Bezel::Config.load("shop", environ: Hash[String, String].new, quiet: true) }
    assert_match(/SECRET_KEY_BASE is required in prod/, e.message)
    c = Bezel::Config.load("shop", environ: {"SECRET_KEY_BASE" => "s" * 64}, quiet: true)
    assert_true(c.prod?)
  end

  def test_dev_defaults
    c = load({})
    assert_equal(:dev, c.env)
    assert_true(c.dev?)
    assert_equal("127.0.0.1", c.host)
    assert_equal(4000, c.port)
    assert_nil(c.database_url)
    assert_equal(10, c.pool_size)
    assert_equal(:info, c.log_level)
    assert_equal(Bezel::Config.dev_secret(:dev), c.secret_key_base)
    assert_equal(64, c.secret_key_base.size)
    assert_nil(c.tls)
  end

  # bezel#99: loopback outside prod; a secret no one can compute: dev's
  # kept in tmp/dev_secret across loads, test's one per process.
  def test_dev_host_and_secret
    prod = Bezel::Config.load("shop", environ: {"SECRET_KEY_BASE" => "s" * 64}, quiet: true)
    assert_equal("0.0.0.0", prod.host)
    assert_equal("127.0.0.1", load({"BEZEL_ENV" => "test"}).host)
    assert_equal("0.0.0.0", load({"HOST" => "0.0.0.0"}).host)
    dev = load({}).secret_key_base
    # bezel#86: a secret, read from the file without its newline.
    assert_equal("#<Bytes::Secret>", dev.inspect)
    assert_false(dev == Bytes::Secret.of(Digest::SHA256.hexdigest("bezel dev secret for shop").to_bytes))
    assert_equal(dev, load({}).secret_key_base)
    assert_equal(dev, Bytes::Secret.of(File.read(Bezel::Config::DEV_SECRET_PATH).strip.to_bytes))
    assert_match(/\A[0-9a-f]{64}\z/, dev.expose_bytes.decode)
    # Readable by its owner alone (GNU stat, as on CI's Linux).
    stat = Process.run("stat", "-c", "%a", Bezel::Config::DEV_SECRET_PATH)
    assert_equal("600", stat.stdout.strip) if stat.success?
    # Made at once by several tasks: one secret, the file's, for all.
    File.delete(Bezel::Config::DEV_SECRET_PATH)
    got = Task.scope do |scope|
      tasks = 4.times.map { scope.spawn { Bezel::Config.dev_secret(:dev) } }.to_a
      tasks.map(&:await)
    end
    assert_true(got.all? { |g| g == got[0] })
    assert_equal(got[0], Bytes::Secret.of(File.read(Bezel::Config::DEV_SECRET_PATH).strip.to_bytes))
    dev = got[0]
    t = load({"BEZEL_ENV" => "test"}).secret_key_base
    assert_equal(t, load({"BEZEL_ENV" => "test"}).secret_key_base)
    assert_false(t == dev)
  end

  def test_environment_over_settings
    s = Bezel::Settings.new(host: "127.0.0.1", port: 5000, database_url: "postgres://localhost/dev", log_level: :debug)
    c = load({"PORT" => "6000", "TRUSTED_PROXIES" => "10.0.0.0/8, ::1"}, {dev: s})
    assert_equal("127.0.0.1", c.host)
    assert_equal(6000, c.port)
    assert_equal("postgres://localhost/dev", c.database_url)
    assert_equal(["10.0.0.0/8", "::1"], c.trusted_proxies)
    assert_equal(:debug, c.log_level)
    assert_true(c.log?(:debug))
    t = load({"BEZEL_ENV" => "test"}, {dev: s})
    assert_equal(4000, t.port)
    # The password hashes' cost: the default, or the settings'.
    assert_equal(Crypto::Argon2::Params::DEFAULT, c.password_params)
    cheap = Crypto::Argon2::Params.new(memory_kib: 64, iterations: 1, parallelism: 1)
    p = load({}, {dev: Bezel::Settings.new(password_params: cheap)})
    assert_equal(cheap, p.password_params)
    assert_match(/password_params: #<Crypto::Argon2::Params m=64 t=1 p=1>/, p.inspect)
  end

  def test_a_task_needs_no_secret
    c = Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod", "DATABASE_URL" => "postgres://db/shop"})
    assert_equal(:prod, c.env)
    assert_equal("postgres://db/shop", c.database_url)
    assert_true(c.task?)
    assert_equal(Bytes::Secret.of(Bezel::Config::TASK_SECRET.to_bytes), c.secret_key_base)
    # One given is kept; one too short is not.
    given = "s" * 64
    kept = Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => given})
    assert_equal(Bytes::Secret.of(given.to_bytes), kept.secret_key_base)
    assert_false(kept.task?)
    assert_true(Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => "short"}).task?)
    # In dev and test, the server's derived secret; settings are read.
    dev = Bezel::Config.for_task("shop", {dev: Bezel::Settings.new(port: 5001)}, environ: {"BEZEL_ENV" => "dev"})
    assert_equal(Bezel::Config.dev_secret(:dev), dev.secret_key_base)
    assert_equal(5001, dev.port)
    assert_false(dev.task?)
    # (A short one in dev is refused, as `load` refuses it.)
    assert_raise(Bezel::ConfigError) { Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "dev", "SECRET_KEY_BASE" => "short"}) }
    # The placeholder signs nothing, and is no application's secret.
    task = Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod"})
    e = assert_raise(Bezel::ConfigError) { Bezel::Keys.derive(task.secret_key_base, "bezel token") }
    assert_match(/no SECRET_KEY_BASE of 64 bytes or more/, e.message)
    assert_raise(Bezel::ConfigError) { load({"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => Bezel::Config::TASK_SECRET}) }
    assert_equal(32, Bezel::Keys.derive(Bytes::Secret.of(("s" * 64).to_bytes), "bezel token").size)
    # The rest is checked as `load` checks it.
    assert_raise(Bezel::ConfigError) { Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod", "PORT" => "x"}) }
  end

  # A derived key is a secret, made without a plain Bytes, the same one
  # for every caller; one wiped is derived again.
  def test_keys_are_secrets
    plain = "k" * 64
    secret = Bytes::Secret.of(plain.to_bytes)
    k = Bezel::Keys.derive(secret, "a test purpose")
    assert_equal("#<Bytes::Secret>", k.inspect)
    assert_true(k.equal?(Bezel::Keys.derive(secret, "a test purpose")))
    assert_equal(Digest::PBKDF2.sha256(plain, "a test purpose", Bezel::Keys::ITERATIONS, 32), k.expose_bytes)
    k.wipe
    again = Bezel::Keys.derive(secret, "a test purpose")
    assert_false(again.wiped?)
    assert_false(again.equal?(k))
    assert_equal(again, Bytes::Secret.of(Digest::PBKDF2.sha256(secret, "a test purpose", Bezel::Keys::ITERATIONS, 32)))
  end

  def test_prod_needs_a_secret
    e = assert_raise(Bezel::ConfigError) { load({"BEZEL_ENV" => "prod"}) }
    assert_match(/SECRET_KEY_BASE is required/, e.message)
    short = assert_raise(Bezel::ConfigError) { load({"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => "x" * 63}) }
    assert_match(/at least 64 bytes/, short.message)
    assert_false(short.message.include?("xxx"))
    ok = load({"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => "s" * 64})
    assert_true(ok.prod?)
    assert_false(ok.inspect.include?("ssss"))
    assert_match(/secret_key_base: <hidden>/, ok.inspect)
  end

  def test_inspect_hides_the_database_url
    c = load({"DATABASE_URL" => "postgres://u:pw@db/x"})
    assert_false(c.inspect.include?("pw"))
    assert_match(/database_url: \(set\)/, c.to_s)
  end

  # bezel#86: the settings an application's config gives hide the URL too.
  def test_settings_hide_the_database_url
    s = Bezel::Settings.new(host: "127.0.0.1", database_url: "postgres://app:hunter2@db/app")
    [s.inspect, s.to_s, [s].inspect].each do |text|
      assert_false(text.include?("hunter2"), text)
      assert_match(/database_url: \(set\)/, text)
    end
    assert_match(/host: "127.0.0.1"/, s.inspect)
    assert_match(/database_url: nil/, Bezel::Settings.new.inspect)
    # The value itself is as given.
    assert_equal("postgres://app:hunter2@db/app", s.database_url)
  end

  def test_bad_values
    assert_raise(Bezel::ConfigError) { load({"BEZEL_ENV" => "staging"}) }
    assert_raise(Bezel::ConfigError) { load({"PORT" => "http"}) }
    assert_raise(Bezel::ConfigError) { load({"PORT" => "70000"}) }
    assert_raise(Bezel::ConfigError) { load({"POOL_SIZE" => "0"}) }
    assert_raise(Bezel::ConfigError) { load({"LOG_LEVEL" => "loud"}) }
    e = assert_raise(Bezel::ConfigError) { load({"TLS_CERT" => "c.pem"}) }
    assert_match(/TLS_KEY is missing/, e.message)
    assert_raise(Bezel::ConfigError) { Bezel::Config.load("", environ: Hash[String, String].new, quiet: true) }
  end

  def test_levels
    c = load({"LOG_LEVEL" => "WARN"})
    assert_equal(:warn, c.log_level)
    assert_false(c.log?(:info))
    assert_true(c.log?(:error))
  end

  # bezel#86: keys derived from a base are those of before the base was a
  # secret, so sessions and tokens made before still open. The values
  # were computed on bezel main (d6e6b8e, Keys.derive over a String) and
  # by Python's hashlib.pbkdf2_hmac, not by this code.
  def test_derived_keys_are_unchanged
    base = Bytes::Secret.of(("0123456789abcdef" * 4).to_bytes)
    assert_equal("51967a81f10f5baef77fb6a69eedd5ec0f711cf55e466844a9075eef122fcde3",
                 Bezel::Keys.derive(base, "bezel session cookie").expose_bytes.hex)
    assert_equal("eaf78e9e29e69455edc41867fa0e2b4be1cf42a23aaabc1292e228f0c0f5bcd5",
                 Bezel::Keys.derive(base, "bezel token").expose_bytes.hex)
    c = load({"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => "0123456789abcdef" * 4})
    assert_equal(Bezel::Keys.derive(base, "bezel token"), Bezel::Keys.derive(c.secret_key_base, "bezel token"))
  end

  # task? is computed from the secret, however the configuration was
  # made: `with` the placeholder is refused by start; a task's
  # configuration given a real secret is not.
  def test_task_follows_the_secret
    real = load({"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => "r" * 64})
    assert_false(real.task?)
    fake = real.with(secret_key_base: Bytes::Secret.of(Bezel::Config::TASK_SECRET.to_bytes))
    assert_true(fake.task?)
    e = assert_raise(Bezel::ConfigError) { Bezel.start(ConfigTestEndpoint, config: fake) }
    assert_match(/task's configuration .* cannot serve/, e.message)
    task = Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod"})
    assert_true(task.task?)
    assert_false(task.with(secret_key_base: Bytes::Secret.of(("r" * 64).to_bytes)).task?)
  end

  # The base is a secret: to_h shows it as one, and JSON refuses it.
  def test_the_secret_key_base_is_a_secret
    c = load({"BEZEL_ENV" => "prod", "SECRET_KEY_BASE" => "k" * 64})
    assert_false(c.to_h.inspect.include?("k" * 64), c.to_h.inspect)
    assert_raise(JSON::GeneratorError) { JSON.generate(c) }
    assert_equal("#<Bytes::Secret>", load({"BEZEL_ENV" => "test"}).secret_key_base.inspect)
  end

  def test_checked_at_load
    p = assert_raise(Bezel::ConfigError) { load({"TRUSTED_PROXIES" => "not an address"}) }
    assert_match(/TRUSTED_PROXIES/, p.message)
    t = assert_raise(Bezel::ConfigError) { load({"TLS_CERT" => "/nonexistent/c.pem", "TLS_KEY" => "/nonexistent/k.pem"}) }
    assert_match(/cannot be read/, t.message)
    d = assert_raise(Bezel::ConfigError) { load({"DATABASE_URL" => "mysql://u:hunter2@h/d"}) }
    assert_match(/DATABASE_URL/, d.message)
    assert_false(d.message.include?("hunter2"))
    slash = assert_raise(Bezel::ConfigError) { load({"DATABASE_URL" => "postgres://u:se/cret@h/d"}) }
    assert_false(slash.message.include?("cret"))
  end

  # bezel#117: DATABASE_URL is checked against `environ`, whose libpq
  # variables pg reads; a bad one is named, its value never shown.
  def test_database_url_against_environ
    e = assert_raise(Bezel::ConfigError) { load({"DATABASE_URL" => "postgres://localhost/shop", "PGPORT" => "x-secret"}) }
    assert_equal("PGPORT: not a number from 1 to 65535", e.message)
    assert_false(e.message.include?("x-secret"))
    assert_equal("postgres://localhost/shop", load({"DATABASE_URL" => "postgres://localhost/shop"}).database_url)
  end

  # A stray libpq variable in the process's environment does not reach a
  # load given its own `environ:` (a child with PGPORT=x).
  def test_the_process_environment_does_not_reach_load
    out = Process.sh("cd test/fixtures/config_stray_pg && PGPORT=x PGSSLMODE=nonsense exec \"${QUARZ:-quarz}\" run")
    assert_true(out.success?, out.stdout + out.stderr)
    assert_equal("postgres://localhost/shop\n", out.stdout)
  end
end

# An endpoint for start's refusal (it never serves).
class ConfigTestEndpoint < Bezel::Endpoint
  def self.plugs -> Array[Bezel::Plug] = [Bezel.plug { |conn| conn.text("never") }]
end
