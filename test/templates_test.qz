require "test"
require_relative "templates/support"
require_relative "templates/corpus"

# The template compiler: the corpus in test/templates (each template, the
# module `bezel templates` makes of them, test/templates/corpus.qz, and
# what each renders, `<name>.html`), and the errors.
class TemplatesTest < Test::Case
  NAMES = ["attrs", "basic", "components", "layout", "text"]

  def dir -> String = File.join(File.dirname(__FILE__), "templates")

  def source(name: String) -> Bezel::Templates::Source
    Bezel::Templates::Source.new("test/templates/#{name}.html.bz", name, File.read(File.join(dir, "#{name}.html.bz")))
  end

  # The rendered page is `<name>.html`; with BEZEL_UPDATE_CORPUS=1, writes
  # it instead (check the new one by hand).
  def check_page(name: String, page: Bezel::Html) -> Void
    path = File.join(dir, "#{name}.html")
    if ENV["BEZEL_UPDATE_CORPUS"]? == "1"
      File.write(path, page.to_s)
      return
    end
    assert_equal(File.read(path), page.to_s)
  end

  def test_the_corpus_compiles_to_corpus_qz
    out = Bezel::Templates.compile_module("Corpus", NAMES.map { |n| source(n) })
    path = File.join(dir, "corpus.qz")
    if ENV["BEZEL_UPDATE_CORPUS"]? == "1"
      File.write(path, out)
      return
    end
    assert_equal(File.read(path), out)
  end

  def test_basic
    check_page("basic", Corpus.basic("Ann & Bob", ["<one>", "two"]))
    assert_equal("<h1 class=\"title\">Hello, x!</h1>\n<p>Tom &amp; Jerry say &lt;hi&gt;.</p>\n\n<p>Nothing yet.</p>",
                 Corpus.basic("x", []).to_s)
  end

  def test_attrs
    check_page("attrs", Corpus.attrs(true, 20, "red", "/search"))
    out = Corpus.attrs(false, 5, nil, "/s").to_s
    assert(out.include?("<div id=\"box\" class=\"box\" data-id=\"7\" data-kind=\"none\""))
    assert(!out.include?("disabled"))
  end

  def test_attrs_url_checked_by_the_dsl
    assert_raise(ArgumentError) { Corpus.attrs(false, 5, nil, "javascript:alert(1)") }
  end

  def test_components
    check_page("components", Corpus.components(User.new(7, "Ann", "ann@example.com"), ["a", "", "<b>"]))
  end

  def test_layout
    conn = Bezel::Conn.build(HTTP::Server::Request.get("/"))
    check_page("layout", Corpus.layout(conn, "Users", Bezel.html { |h| h.p("Hi") }))
  end

  def test_text
    check_page("text", Corpus.text("\nx < y", "<b>raw</b>", 3, nil))
  end

  def test_the_header_names_digests
    src = source("basic")
    out = Bezel::Templates.compile_module("Corpus", [src])
    assert_equal({"test/templates/basic.html.bz" => Bezel::Templates.digest(src.text)}, Bezel::Templates.digests(out))
  end

  # The message of compiling `text`, which must fail.
  def error_of(text: String) -> String
    e = assert_raise(Bezel::Templates::Error) do
      Bezel::Templates.compile(Bezel::Templates::Source.new("v/t.html.bz", "t", text))
    end
    e.message
  end

  def test_errors_name_the_line
    assert_equal("v/t.html.bz:2: </p> does not close <span> (line 2)", error_of("<p>\n<span>x</p>"))
    [
      ["<div>\n\n<p>x", "v/t.html.bz:3: <p> is not closed"],
      ["<div>\n<p>x</p>", "v/t.html.bz:1: <div> is not closed"],
      ["<p>x</p>\n</div>", "v/t.html.bz:2: </div> closes no element"],
      ["<blink>x</blink>", "v/t.html.bz:1: <blink> is not an element the DSL writes"],
      ["<p\n  colour=\"red\">x</p>", "v/t.html.bz:2: <p> has no attribute colour (a custom one has a - in its name)"],
      ["<p onclick=\"x()\"></p>", "v/t.html.bz:1: <p> has no attribute onclick (a custom one has a - in its name)"],
      ["<p on-x=\"y\"></p>", "v/t.html.bz:1: on-x: event handler attributes are refused (no inline script)"],
      ["<input disabled=\"disabled\">", "v/t.html.bz:1: disabled of <input> is boolean: bare (disabled) or an expression (disabled={...})"],
      ["<td colspan=\"two\"></td>", "v/t.html.bz:1: colspan of <td> needs an integer, not \"two\""],
      ["<p id=\"a\" id=\"b\"></p>", "v/t.html.bz:1: id is given twice"],
      ["<p>\n{x</p>", "v/t.html.bz:2: { is not closed (a { in a text is written {\"{\"})"],
      ["<p>{ }</p>", "v/t.html.bz:1: {} holds no expression"],
      ["<p>x</p>\n{@args x: Int}", "v/t.html.bz:2: {@args ...} comes before the rest of the template"],
      ["{@args h: Int}", "v/t.html.bz:1: a parameter cannot be named `h` (the builder's name)"],
      ["{@foo}", "v/t.html.bz:1: @foo is not a directive (only {@args ...})"],
      ["<li :for={x in xs}>x</li>", "v/t.html.bz:1: :for is written {pattern <- expr}"],
      ["<li :for={h <- xs}>x</li>", "v/t.html.bz:1: :for cannot name a variable `h` (the builder's name)"],
      ["<li :each={xs}>x</li>", "v/t.html.bz:1: :each is not a special attribute (:for, :if)"],
      ["<li :if=\"x\">x</li>", "v/t.html.bz:1: :if takes an expression ({...})"],
      ["<p>\n  <:footer>x</:footer></p>", "v/t.html.bz:2: <:footer> is a slot: it goes directly inside a component"],
      ["<.card><:f>a</:f><:f>b</:f></.card>", "v/t.html.bz:1: f is given twice"],
      ["<.card>\n<:f x=\"1\">a</:f></.card>", "v/t.html.bz:2: <:f> takes no attributes"],
      ["<script>x", "v/t.html.bz:1: <script> is not closed"],
      ["<!-- x", "v/t.html.bz:1: the comment is not closed (-->)"],
      ["<!DOCTYPE html5>", "v/t.html.bz:1: only <!DOCTYPE html> is written"],
      ["<p title=\"x>y</p>", "v/t.html.bz:1: the value of title is not closed (\")"],
      ["<p class>x</p>", "v/t.html.bz:1: class needs a value"],
      ["<td colspan>x</td>", "v/t.html.bz:1: colspan of <td> needs an integer"]
    ].each do |pair|
      assert_equal(pair[1], error_of(pair[0]))
    end
  end

  def lit(text: String) -> String = Bezel::Templates.literal(text)

  # The code `text` compiles to (the statements in the block).
  def code_of(text: String) -> String
    Bezel::Templates.compile(Bezel::Templates::Source.new("v/t.html.bz", "t", text))
  end

  def test_entities
    assert(code_of("<p title=\"a&copy;b\">&copy; &mdash;&#8212;&#x2014;</p>").include?("h.p(#{lit("\u00a9 \u2014\u2014\u2014")}, title: #{lit("a\u00a9b")})"))
    assert_equal("v/t.html.bz:2: &foo; is not a character reference a template knows (write the character, or &#NNNN;)", error_of("<p>\nx &foo; y</p>"))
    assert_equal("v/t.html.bz:1: &#0; is not a character", error_of("<p>&#0;</p>"))
    assert_equal("v/t.html.bz:1: &#xD800; is not a character", error_of("<p title=\"&#xD800;\"></p>"))
    assert_equal("v/t.html.bz:1: &#99999999; is not a character", error_of("<p>&#99999999;</p>"))
    # (Without a semicolon, an ampersand is text.)
    assert(code_of("<p>a & b &copy 1</p>").include?("h.p(\"a & b &copy 1\")"))
  end

  def test_whitespace_is_ascii
    assert(code_of("<p>a\n&nbsp;&nbsp;b&#10;&#32;c</p>").include?("h.p(#{lit("a\n\u00a0\u00a0b\n c")})"))
    assert(code_of("&nbsp;<p>x</p>").include?("h.text(#{lit("\u00a0")})"))
  end

  def test_the_template_is_trimmed
    out = code_of("\n  Hello\n  world\n")
    assert(out.include?("h.text(#{lit("Hello\nworld")})"))
    assert(code_of("<p>x</p>\n  tail\n").include?("h.text(#{lit("\ntail")})"))
    assert(code_of("<!DOCTYPE html>\nHello").include?("h.doctype\n      h.text(\"Hello\")"))
  end

  def test_code_is_one_expression
    assert(code_of("<div title={a if b}>x</div>").include?("h.div(\"x\", title: (a if b))"))
    assert(code_of("<p :if={a and b}>x</p>").include?("if (a and b)"))
    assert(code_of("<.panel title={a, b}/>").include?("Panel.new(title: (a, b))"))
    assert_equal("v/t.html.bz:1: a # comment cannot be in {...}", error_of("<p>{x # note}</p>"))
  end

  def test_braces_skip_regexps
    assert(code_of("<p>{x.gsub(/\"/, \"\")}</p>").include?("h.put((x.gsub(/\"/, \"\")))"))
    assert(code_of("<p>{x.gsub(/}/, \"\")}</p>").include?("h.put((x.gsub(/}/, \"\")))"))
    assert(code_of("<p>{a / b} \"</p>").include?("h.put((a / b))"))
  end

  def test_late_errors_are_template_errors
    assert_equal("v/t.html.bz:1: colspan of <td> needs an integer, not \"99999999999999999999\"", error_of("<td colspan=\"99999999999999999999\"></td>"))
    assert_equal("v/t.html.bz:2: a <script> cannot hold <!--: it hides its end tag", error_of("<p></p>\n<script><!-- x --></script>"))
    assert_equal("v/t.html.bz:1: a <script> cannot hold <script: it hides its end tag", error_of("<script>document.write(\"<script>\")</script>"))
  end

  def test_end_tags_end_at_the_name
    # (`</scripts>` does not end the script, and the DSL refuses it in one.)
    assert_equal("v/t.html.bz:1: a <script> cannot hold </script", error_of("<script>a</scripts></script>"))
    assert(code_of("<script>a</script\n><p>b</p>").include?("h.script(\"a\")"))
    assert(code_of("<title>a</title ><p>b</p>").include?("h.title(\"a\")"))
  end

  def test_h_cannot_be_a_parameter
    ["{@args *h: Array[Int]}", "{@args **h: Hash[Symbol, Int]}", "{@args &h: () -> Void}", "{@args a: Int, h: Int}"].each do |t|
      assert_equal("v/t.html.bz:1: a parameter cannot be named `h` (the builder's name)", error_of(t))
    end
    assert(code_of("{@args hh: Int}").include?("def self.t(hh: Int)"))
  end

  def test_second_review
    # (`:for`'s list and attribute code are one expression.)
    assert(code_of("<li :for={i <- 1..3}>x</li>").include?("(1..3).each do |i|"))
    assert(code_of("<li :for={i <- a||b}>x</li>").include?("(a||b).each do |i|"))
    assert(code_of("<li :for={i <- -x}>x</li>").include?("(-x).each do |i|"))
    assert(code_of("<li :for={i <- Shop::User.all}>x</li>").include?("Shop::User.all.each do |i|"))
    assert(code_of("<p>{a?b:c}</p>").include?("h.put((a?b:c))"))
    # (What the DSL would refuse at render time.)
    assert_equal("v/t.html.bz:1: a <script> cannot hold </script", error_of("<script>var a = \"</scripts>\";</script>"))
    assert_equal("v/t.html.bz:1: a <style> cannot hold </style", error_of("<style>a::after{content:\"</styles>\"}</style>"))
    assert_equal("v/t.html.bz:2: a <textarea> cannot hold </textarea", error_of("<textarea>\n</textareas></textarea>"))
    # (Lines as written.)
    assert_equal("v/t.html.bz:3: &bogus; is not a character reference a template knows (write the character, or &#NNNN;)", error_of("\n\n&bogus;"))
    assert_equal("v/t.html.bz:4: &bogus; is not a character reference a template knows (write the character, or &#NNNN;)", error_of("<p>a\n\n\n&bogus;</p>"))
    assert_equal("v/t.html.bz:2: &bogus; is not a character reference a template knows (write the character, or &#NNNN;)", error_of("<pre>\n&bogus;</pre>"))
    assert_equal("v/t.html.bz:5: &bogus; is not a character reference a template knows (write the character, or &#NNNN;)", error_of("<.card>\n\n<:foot>x</:foot>\n\n&bogus;</.card>"))
    assert_equal("v/t.html.bz:2: &bogus; is not a character reference a template knows (write the character, or &#NNNN;)", error_of("<p title=\n\"&bogus;\"></p>"))
    # (Whitespace inside `pre` is kept in components too.)
    assert(code_of("<pre><.card>  a\n\n   b  </.card></pre>").include?("h.text(#{lit("  a\n\n   b  ")})"))
    # (The scanner.)
    assert(code_of("{@args n: Int}\n<p>{n / 2}{n/2}{1 + @x /2}{N /2}</p>").include?("h.put((n / 2))"))
    assert(code_of("<p>{xs.reduce(:/)}</p>").include?("h.put((xs.reduce(:/)))"))
    assert(code_of("<p>{%q(\")}</p>").include?("h.put((%q(\")))"))
    assert(code_of("<p>{%q|}|}</p>").include?("h.put((%q|}|))"))
    assert(code_of("<p>{%r{/}}</p>").include?("h.put((%r{/}))"))
    assert(code_of("<p>{a % b}</p>").include?("h.put((a % b))"))
    assert_equal("v/t.html.bz:1: a # comment cannot be in {...}", error_of("<p>{\"\#{x #c}\"}</p>"))
    # (Component names are in lowercase; long numeric references.)
    assert_equal("v/t.html.bz:1: <.UserCard> is not a component name (<.card>, <.admin.user_card>)", error_of("<.UserCard/>"))
    assert(code_of("<p>&#00000065;</p>").include?("h.p(\"A\")"))
  end

  def test_third_review
    amb = "the compiler cannot tell how Quarz reads a / or % (or \\) in {...}: write `a / b` or `f(/x/)`, on one line"
    assert_equal("v/t.html.bz:1: #{amb}", error_of("<p>{items.size /2}</p><p>a/b</p>"))
    assert_equal("v/t.html.bz:1: #{amb}", error_of("<p>Total: {puts %|}|, 0)); puts(:INJECTED); z = '{'</p>"))
    assert_equal("v/t.html.bz:1: #{amb}", error_of("<p>{a.empty? /2}</p>"))
    assert(code_of("<p>{a.empty? / 2}</p>").include?("h.put((a.empty? / 2))"))
    assert(code_of("<p>{c ? a:/x}/ : b}</p>").include?("h.put((c ? a:/x}/ : b))"))
    assert(code_of("<p>{x if /}/ =~ y}</p>").include?("h.put((x if /}/ =~ y))"))
    assert(code_of("<p>{%(\#{f(\")\")})}</p>").include?("h.put((%(\#{f(\")\")})))"))
    assert(code_of("<p>{%|\#{a || b}|}</p>").include?("h.put((%|\#{a || b}|))"))
    heredoc = "v/t.html.bz:1: a heredoc cannot be in {...} (write `<< x` with a space for the operator)"
    assert_equal(heredoc, error_of("{@args x: String}<p>{<<~end}<b>{x}</b></p>"))
    assert_equal(heredoc, error_of("<p>{raw(<<-X)}</p>"))
    assert(code_of("<p>{xs << y}</p>").include?("h.put((xs << y))"))
    assert_equal("v/t.html.bz:1: __END__ or =begin cannot start a line in {...}", error_of("<p>{a +\n__END__\n}</p>"))
    assert_equal("v/t.html.bz:1: &#146; is a control character (write the character meant)", error_of("<p>&#146;</p>"))
    assert_equal("v/t.html.bz:1: &#13; is a control character (write the character meant)", error_of("<p>&#13;</p>"))
    assert_equal("v/t.html.bz:4: a <script> cannot hold <!--: it hides its end tag", error_of("<script>\nvar a = 1;\n\n<!-- x\n</script>"))
    assert_equal("v/t.html.bz:3: a <style> cannot hold </style", error_of("<style>\n\na{x:\"</styles>\"}</style>"))
    assert_equal("v/t.html.bz:2: :for is written {pattern <- expr}", error_of("<li\n  :for={x in xs}>x</li>"))
  end

  def test_fourth_review
    amb = "v/t.html.bz:1: the compiler cannot tell how Quarz reads a / or % (or \\) in {...}: write `a / b` or `f(/x/)`, on one line"
    # (`b"..."` does not interpolate: the `}` inside it is its own.)
    assert(code_of("<p>{b\"\#{\".size}</p>").include?("h.put((b\"\#{\".size))"))
    # (After a keyword that is no value, a `/` starts a literal.)
    assert(code_of("<p>{begin / \"[\"}]/ end}</p>").include?("h.put((begin / \"[\"}]/ end))"))
    assert(code_of("<p>{x.class /}/}</p>").include?("h.put((x.class /}/))"))
    assert(code_of("<p>{self / 2}</p>").include?("h.put((self / 2))"))
    assert_equal(amb, error_of("<p>{total\n  / count}</p>"))
    assert_equal(amb, error_of("<p>{a \\\n/}/}</p>"))
    assert(code_of("<p>{1../}/}</p>").include?("h.put((1../}/))"))
    assert(code_of("<p>{x / /}/}</p>").include?("h.put((x / /}/))"))
    assert(code_of("<p>{f(\"a\":/}/)}</p>").include?("h.put((f(\"a\":/}/)))"))
    assert_equal(amb, error_of("<p>{f(a?:/)}/}</p>"))
    assert_equal(amb, error_of("<p>{1?/}/}</p>"))
    assert_equal(amb, error_of("<p>{x + @a?/}/}</p>"))
    assert_equal(amb, error_of("<p>{café /}/}</p>"))
    assert(code_of("<p>{f(fé:/}/)}</p>").include?("h.put((f(fé:/}/)))"))
    assert(code_of("<p>{éif / 2}</p>").include?("h.put((éif / 2))"))
    assert(code_of("<p>{x = %\f}\f}</p>").include?("h.put((x = %\f}\f))"))
    assert(code_of("<p>{a %= 2}</p>").include?("h.put((a %= 2))"))
    assert_equal("v/t.html.bz:1: :for's pattern is names, commas, parentheses and braces", error_of("<p :for={f(\" <- '\") <- list}>x</p>it's"))
    assert_equal("v/t.html.bz:1: { is not closed (a { in a text is written {\"{\"})", error_of("{@args / }/"))
    assert_equal("v/t.html.bz:1: :for's pattern is names, commas, parentheses and braces", error_of("<p :for={\"a\" <- list}>x</p>"))
    assert(code_of("<p :for={x <- f(\" <- \")}>x</p>").include?("(f(\" <- \")).each do |x|"))
  end

  def test_module_sources_are_checked
    a = Bezel::Templates::Source.new("v/a b.html.bz", "a", "<p>a</p>")
    assert_equal({"v/a b.html.bz" => Bezel::Templates.digest("<p>a</p>")}, Bezel::Templates.digests(Bezel::Templates.compile_module("V", [a])))
    assert_raise(ArgumentError) { Bezel::Templates.compile_module("V", [a, Bezel::Templates::Source.new("v/b", "a", "")]) }
    assert_raise(ArgumentError) { Bezel::Templates.compile_module("V", [Bezel::Templates::Source.new("v/a\nputs 1", "a", "")]) }
  end

  def test_names_are_checked
    assert_raise(ArgumentError) { Bezel::Templates.compile(Bezel::Templates::Source.new("t", "Show", "")) }
    assert_raise(ArgumentError) { Bezel::Templates.compile_module("user_view", []) }
  end

  def test_literals_escape_interpolation
    assert_equal("\"a\\\#{b}\\\\\\\"\\n\\u{1}\"", Bezel::Templates.literal("a\#{b}\\\"\n\u{1}"))
  end

  def test_braces_skip_strings
    out = Bezel::Templates.compile(Bezel::Templates::Source.new("t", "t", "<p>{\"}\" + \"\#{\"{\"}\" + '}'}</p>"))
    assert(out.include?("h.put((\"}\" + \"\#{\"{\"}\" + '}'))"))
  end

  def test_raw_only_as_a_whole_call
    out = Bezel::Templates.compile(Bezel::Templates::Source.new("t", "t", "<p>{raw(a) + raw(b)}</p>"))
    assert(out.include?("h.put((raw(a) + raw(b)))"))
  end
end
