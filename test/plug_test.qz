require "test"

class PlugTestTag
  include Bezel::Plug
  @tag: String
  def initialize(@tag: String); end
  def call(conn: Bezel::Conn) -> Bezel::Conn
    seen = conn.resp_headers["x-seen"] || ""
    conn.put_resp_header("x-seen", seen + @tag)
  end
end

class PlugTestController < Bezel::Controller
  controller
end

# A bearer token on one action only.
class PlugTestReports < Bezel::Controller
  AUTH = Bezel::Plug::BearerAuth.new(token: "t0ken", realm: "reports")

  plug :bearer_auth, only: [:export]

  def index(conn: Bezel::Conn) -> Bezel::Conn = text(conn, "reports")
  def export(conn: Bezel::Conn) -> Bezel::Conn = text(conn, "data")

  private def bearer_auth(conn: Bezel::Conn) -> Bezel::Conn = AUTH.call(conn)
end

class PlugTest < Test::Case
  def req(target: String = "/") -> HTTP::Server::Request = HTTP::Server::Request.get(target)

  def form(target: String, body: String) -> HTTP::Server::Request
    HTTP::Server::Request.post(target, body, HTTP::Headers.of({"Content-Type" => "application/x-www-form-urlencoded"}))
  end

  def json_post(target: String, body: String) -> HTTP::Server::Request
    HTTP::Server::Request.post(target, body, HTTP::Headers.of({"Content-Type" => "application/json"}))
  end

  def static_dir -> String = File.join(File.dirname(__FILE__), "fixtures", "static")

  def test_run_in_order_and_halt
    plugs: Array[Bezel::Plug] = [PlugTestTag.new("a"), PlugTestTag.new("b"),
                                 Bezel.plug { |c| c.halt }, PlugTestTag.new("c")]
    out = Bezel::Plug.run(plugs, Bezel::Conn.build(req))
    assert_equal("ab", out.resp_headers["x-seen"])
    assert_true(out.halted?)
  end

  def test_pipeline_wraps_the_rest
    events = Atom.new(Array[String].new)
    rec = Bezel::Plug::Logger.new(->(e: Bezel::LogEvent) { events.update { |es| es.push(e.to_s) }; nil })
    inner: Array[Bezel::Plug] = [rec]
    plugs: Array[Bezel::Plug] = [Bezel::Pipeline.new(inner), Bezel.plug { |c| c.text("x", status: 201) }]
    out = Bezel::Plug.run(plugs, Bezel::Conn.build(req("/p")))
    assert_equal(201, out.status)
    assert_equal(1, events.value.size)
    assert_match(/\AGET \/p -> 201 in /, events.value[0])
  end

  # bezel#100: the ids do not come from Random: the same seed twice gives
  # two different ids.
  def test_request_id_not_from_random
    srand(7)
    a = Bezel::Plug::RequestId.generate
    srand(7)
    b = Bezel::Plug::RequestId.generate
    assert_false(a == b)
    assert_equal(22, a.size)
  end

  def test_request_id
    out = Bezel::Plug::RequestId.new.call(Bezel::Conn.build(req))
    id = out.request_id || ""
    assert_equal(22, id.size)
    assert_equal(id, out.resp_headers["x-request-id"])
    given = "abcdefghijklmnopqrstuvwxyz"
    kept = Bezel::Plug::RequestId.new.call(Bezel::Conn.build(HTTP::Server::Request.get("/", HTTP::Headers.of({"X-Request-Id" => given}))))
    assert_equal(given, kept.request_id)
    bad = Bezel::Plug::RequestId.new.call(Bezel::Conn.build(HTTP::Server::Request.get("/", HTTP::Headers.of({"X-Request-Id" => "short"}))))
    assert_false(bad.request_id == "short")
  end

  # The connection's text body, nil for another.
  def text_of(conn: Bezel::Conn) -> String?
    case conn.resp_body
    in HTTP::Content::Text(text:) then text
    else nil
    end
  end

  def bearer(auth: Bezel::Plug::BearerAuth, header: String?) -> Bezel::Conn
    headers = header ? HTTP::Headers.of({"Authorization" => header}) : HTTP::Headers.empty
    auth.call(Bezel::Conn.build(HTTP::Server::Request.get("/", headers)))
  end

  # bezel#86: the plug's inspect shows whether a token is set, not it.
  def test_bearer_auth_hides_its_token
    auth = Bezel::Plug::BearerAuth.new(token: "s3cret-token", realm: "api")
    [auth.inspect, auth.to_s, [auth].inspect].each do |text|
      assert_false(text.include?("s3cret-token"), text)
    end
    assert_equal("#<Bezel::Plug::BearerAuth realm: \"api\", token: (set)>", auth.inspect)
    assert_equal("#<Bezel::Plug::BearerAuth realm: \"api\", token: nil>", Bezel::Plug::BearerAuth.new(token: nil, realm: "api").inspect)
  end

  # bezel#87: a connection and its session show no header value, no
  # parameter value and no session value.
  def test_conn_and_session_inspect
    req = HTTP::Server::Request.get("/a?password=hunter2&q=x",
                                    HTTP::Headers.of({"Authorization" => "Bearer t0k3n", "Cookie" => "sid=c00kie"}))
    conn = Bezel::Conn.build(req)
    conn = conn.with(session: conn.session.put("_csrf_token", "s3cr3t").put("user_id", "42"))
    [conn.inspect, conn.to_s, [conn].inspect, conn.session.inspect, conn.session.to_s].each do |text|
      ["hunter2", "t0k3n", "c00kie", "s3cr3t", "42"].each { |v| assert_false(text.include?(v), "#{v} in #{text}") }
    end
    assert_equal("#<Bezel::Session keys: [\"_csrf_token\", \"user_id\"], changed: true, dropped: false, loaded: false>",
                 conn.session.inspect)
    assert_match(/\A#<Bezel::Conn GET "\/a", params: \["password", "q"\], /, conn.inspect)
  end

  def test_bearer_auth
    auth = Bezel::Plug::BearerAuth.new(token: "s3cret-token", realm: "api")
    # The token, the scheme in any case: through, unchanged.
    ["Bearer s3cret-token", "bearer s3cret-token", "BEARER  s3cret-token "].each do |h|
      c = bearer(auth, h)
      assert_false(c.halted?, h)
      assert_equal(200, c.status)
      assert_nil(c.resp_headers["www-authenticate"])
    end
    # Refused: another token of the same length or another, none, another
    # scheme, an empty one.
    ["Bearer s3cret-tokeN", "Bearer s3cret", "Bearer s3cret-token-longer", nil, "Basic s3cret-token", "Bearer", "Bearer ", "s3cret-token"].each do |h|
      c = bearer(auth, h)
      assert_true(c.halted?, h.inspect)
      assert_equal(401, c.status, h.inspect)
      assert_equal("Bearer realm=\"api\"", c.resp_headers["www-authenticate"])
      assert_equal("Unauthorized", text_of(c))
    end
    # A nil or empty configured token refuses everything, an empty
    # header's too.
    [nil, ""].each do |t|
      none = Bezel::Plug::BearerAuth.new(token: t, realm: "api")
      ["Bearer ", "Bearer", "Bearer x", nil].each { |h| assert_equal(401, bearer(none, h).status, "#{t.inspect} #{h.inspect}") }
    end
    # A controller's plug line, on one action.
    plain = Bezel::Conn.build(HTTP::Server::Request.get("/"))
    assert_equal("reports", text_of(PlugTestReports.new.dispatch(:index, plain)))
    assert_equal(401, PlugTestReports.new.dispatch(:export, plain).status)
    given = Bezel::Conn.build(HTTP::Server::Request.get("/", HTTP::Headers.of({"Authorization" => "Bearer t0ken"})))
    assert_equal("data", text_of(PlugTestReports.new.dispatch(:export, given)))
    # The realm is a quoted string.
    odd = Bezel::Plug::BearerAuth.new(token: "t", realm: "a \"b\" \\ c")
    assert_equal("Bearer realm=\"a \\\"b\\\" \\\\ c\"", bearer(odd, nil).resp_headers["www-authenticate"])
  end

  def test_logger_reports_exceptions_and_escapes
    events = Atom.new(Array[String].new)
    rec = Bezel::Plug::Logger.new(->(e: Bezel::LogEvent) { events.update { |es| es.push(e.to_s) }; nil })
    plugs: Array[Bezel::Plug] = [rec, Bezel.plug { |c| raise Bezel::Forbidden.new }]
    out = Bezel::Plug.run(plugs, Bezel::Conn.build(req("/a%0Ab")))
    assert_true(out.error.is_a?(Bezel::Forbidden))
    assert_true(out.halted?)
    assert_match(/\AGET \/a\\x0ab -> 403 in [0-9]+\.[0-9]ms\z/, events.value[0])
    boom: Array[Bezel::Plug] = [rec, Bezel.plug { |c| raise "boom" }]
    assert_true(Bezel::Plug.run(boom, Bezel::Conn.build(req)).error.is_a?(RuntimeError))
    assert_match(/-> 500 in /, events.value[1])
    none: Array[Bezel::Plug] = [rec, Bezel::Plug::Head.new]
    Bezel::Plug.run(none, Bezel::Conn.build(HTTP::Server::Request.head("/x")))
    assert_match(/\AHEAD \/x -> 404 in /, events.value[2])
  end

  # bezel#101: C1 controls, U+2028 and U+2029 are escaped as C0 ones are.
  def test_logger_escapes_c1_and_separators
    events = Atom.new(Array[String].new)
    rec = Bezel::Plug::Logger.new(->(e: Bezel::LogEvent) { events.update { |es| es.push(e.to_s) }; nil })
    plugs: Array[Bezel::Plug] = [rec, Bezel.plug { |c| c.text("x") }]
    # U+009B, U+0085, U+2028 and U+2029, percent-encoded.
    Bezel::Plug.run(plugs, Bezel::Conn.build(req("/a%C2%9Bb%C2%85c%E2%80%A8d%E2%80%A9e")))
    assert_match(/\AGET \/a\\u009bb\\u0085c\\u2028d\\u2029e -> 200 in /, events.value[0])
  end

  def test_logger_silent_above_info
    events = Atom.new(Array[String].new)
    rec = Bezel::Plug::Logger.new(->(e: Bezel::LogEvent) { events.update { |es| es.push(e.to_s) }; nil })
    app = Bezel::App.new(Bezel::Config.load("t", environ: {"BEZEL_ENV" => "test", "LOG_LEVEL" => "warn"}))
    plugs: Array[Bezel::Plug] = [rec, Bezel.plug { |c| c.text("x") }]
    Bezel::Plug.run(plugs, Bezel::Conn.build(req, app))
    assert_equal(0, events.value.size)
  end

  def test_static_serves_files
    s = Bezel::Plug::Static.new(at: "/", from: static_dir)
    out = s.call(Bezel::Conn.build(req("/css/app.css")))
    assert_true(out.halted?)
    assert_equal(200, out.status)
    assert_equal("text/css; charset=utf-8", out.resp_headers["content-type"])
    assert_equal("public, max-age=0", out.resp_headers["cache-control"])
    case out.resp_body
    in HTTP::Content::Binary(bytes:) then assert_equal("body { color: red; }\n", bytes.decode)
    else flunk("not a binary body")
    end
    etag = out.resp_headers["etag"] || ""
    assert_match(/\AW\/"[0-9a-f]+-[0-9a-f]+"\z/, etag)
    again = s.call(Bezel::Conn.build(HTTP::Server::Request.get("/css/app.css", HTTP::Headers.of({"If-None-Match" => etag}))))
    assert_equal(304, again.status)
    lm = out.resp_headers["last-modified"] || ""
    assert_match(/ GMT\z/, lm)
    since = s.call(Bezel::Conn.build(HTTP::Server::Request.get("/css/app.css", HTTP::Headers.of({"If-Modified-Since" => lm}))))
    assert_equal(304, since.status)
  end

  # `If-Modified-Since` is read as an HTTP date in each of its forms,
  # and answered 304 when the file is not later than it.
  def test_static_if_modified_since_is_a_date
    s = Bezel::Plug::Static.new(at: "/", from: static_dir)
    status = ->(since: String) do
      s.call(Bezel::Conn.build(HTTP::Server::Request.get("/css/app.css", HTTP::Headers.of({"If-Modified-Since" => since})))).status
    end
    lm = s.call(Bezel::Conn.build(req("/css/app.css"))).resp_headers["last-modified"] || ""
    mtime = Time.httpdate(lm)
    assert_equal(File.mtime(File.join(static_dir, "css/app.css")).utc.httpdate, lm)
    # RFC 850 and asctime, the forms a recipient must accept.
    assert_equal(304, status.call(mtime.strftime("%A, %d-%b-%y %H:%M:%S GMT")))
    assert_equal(304, status.call(mtime.strftime("%a %b %e %H:%M:%S %Y")))
    # Later than the file: not modified since; earlier: modified.
    assert_equal(304, status.call((mtime + 1.second).httpdate))
    assert_equal(304, status.call((mtime + 365.days).httpdate))
    assert_equal(200, status.call((mtime - 1.second).httpdate))
    # Not a date: ignored.
    assert_equal(200, status.call("yesterday"))
    assert_equal(200, status.call(lm.downcase))
    # If-None-Match decides when both are given.
    both = HTTP::Headers.of({"If-None-Match" => "\"other\"", "If-Modified-Since" => lm})
    assert_equal(200, s.call(Bezel::Conn.build(HTTP::Server::Request.get("/css/app.css", both))).status)
  end

  def test_static_refuses_and_passes
    s = Bezel::Plug::Static.new(at: "/assets", from: static_dir, only: ["css", "robots.txt"])
    ["/assets/.env", "/assets/.hidden/x.txt", "/assets/css/../robots.txt", "/assets/css", "/assets/",
     "/assets/index.html", "/robots.txt", "/assets/css//app.css", "/assets/nope.css"].each do |path|
      out = s.call(Bezel::Conn.build(req(path)))
      assert_false(out.halted?, path)
    end
    post = s.call(Bezel::Conn.build(HTTP::Server::Request.post("/assets/robots.txt")))
    assert_false(post.halted?)
    assert_true(s.call(Bezel::Conn.build(req("/assets/robots.txt"))).halted?)
    head = s.call(Bezel::Conn.build(HTTP::Server::Request.head("/assets/robots.txt")))
    assert_equal(200, head.status)
  end

  def test_static_encoded_traversal
    s = Bezel::Plug::Static.new(at: "/", from: File.join(static_dir, "css"))
    out = s.call(Bezel::Conn.build(req("/%2e%2e/robots.txt")))
    assert_false(out.halted?)
    out2 = s.call(Bezel::Conn.build(req("/..%2frobots.txt")))
    assert_false(out2.halted?)
  end

  def test_parsers_form_and_json
    p = Bezel::Plug::Parsers.new
    c = p.call(Bezel::Conn.build(form("/u?id=1&a=q", "user[name]=Ann&a=b")))
    assert_equal("Ann", c.params["user"].fetch("name"))
    assert_equal("b", c.params.fetch("a"))
    assert_equal("1", c.params.fetch("id"))
    assert_false(c.body_params.key?("id"))
    j = p.call(Bezel::Conn.build(json_post("/u", "{\"n\": 5}")))
    assert_equal(5, j.params.int("n"))
  end

  def test_parsers_errors
    p = Bezel::Plug::Parsers.new(max_body: 4)
    e = assert_raise(Bezel::PayloadTooLarge) { p.call(Bezel::Conn.build(form("/", "a=12345"))) }
    assert_equal(413, e.as(HTTP::Error).status)
    j = Bezel::Plug::Parsers.new
    assert_raise(Bezel::BadRequest) { j.call(Bezel::Conn.build(json_post("/", "{nope"))) }
    strict = Bezel::Plug::Parsers.new(pass: ["text/*"])
    xml = HTTP::Server::Request.post("/", "<a/>", HTTP::Headers.of({"Content-Type" => "application/xml"}))
    e2 = assert_raise(Bezel::UnsupportedMediaType) { strict.call(Bezel::Conn.build(xml)) }
    assert_equal(415, e2.as(HTTP::Error).status)
    txt = HTTP::Server::Request.post("/", "hi", HTTP::Headers.of({"Content-Type" => "text/plain"}))
    assert_false(strict.call(Bezel::Conn.build(txt)).halted?)
    loose = Bezel::Plug::Parsers.new
    assert_equal("<a/>", loose.call(Bezel::Conn.build(xml)).request.body.read)
    assert_raise(ArgumentError) { Bezel::Plug::Parsers.new(parsers: [:multipart]) }
  end

  def test_method_override
    plugs: Array[Bezel::Plug] = [Bezel::Plug::Parsers.new, Bezel::Plug::MethodOverride.new]
    assert_equal("PATCH", Bezel::Plug.run(plugs, Bezel::Conn.build(form("/x", "_method=patch"))).method)
    assert_equal("POST", Bezel::Plug.run(plugs, Bezel::Conn.build(form("/x", "_method=get"))).method)
    assert_equal("POST", Bezel::Plug.run(plugs, Bezel::Conn.build(form("/x?_method=delete", ""))).method)
    get = HTTP::Server::Request.get("/x?_method=delete")
    assert_equal("GET", Bezel::Plug.run(plugs, Bezel::Conn.build(get)).method)
  end

  def test_head
    c = Bezel::Plug::Head.new.call(Bezel::Conn.build(HTTP::Server::Request.head("/")))
    assert_equal("GET", c.method)
  end

  def test_timeout
    t = Bezel::Plug::Timeout.new(20.ms)
    slow: Array[Bezel::Plug] = [t, Bezel.plug { |c| Task.sleep(2.seconds); c.text("late") }]
    late = Bezel::Plug.run(slow, Bezel::Conn.build(req))
    assert_true(late.error.is_a?(Bezel::TimeoutError))
    assert_equal(503, late.final_status)
    inner: Array[Bezel::Plug] = [t, Bezel.plug { |c| Task.timeout(1.ms) { Task.sleep(1.second) }; c.text("x") }]
    own = Bezel::Plug.run(inner, Bezel::Conn.build(req))
    assert_true(own.error.is_a?(Task::Timeout))
    assert_equal(500, own.final_status)
    fast: Array[Bezel::Plug] = [t, Bezel.plug { |c| c.text("ok") }]
    assert_equal(200, Bezel::Plug.run(fast, Bezel::Conn.build(req)).status)
  end

  def test_parsers_without_a_body
    p = Bezel::Plug::Parsers.new(pass: ["text/*"])
    bare = HTTP::Server::Request.new("DELETE", "/x", "/x", "", "HTTP/1.1",
      HTTP::Headers.of({"Content-Type" => "application/json"}), HTTP::Body.new(HTTP::Reader.of(Bytes.new), nil, false, 1000), nil, {}, HTTP::Proxies.none, false, false)
    assert_false(p.call(Bezel::Conn.build(bare)).halted?)
    xml = bare.with(headers: HTTP::Headers.of({"Content-Type" => "application/xml"}))
    assert_false(p.call(Bezel::Conn.build(xml)).halted?)
  end

  def test_a_wrap_sees_errors_as_conn_error
    plugs: Array[Bezel::Plug] = [PlugTestPages.new, Bezel.plug { |c| raise Bezel::NotFound.new }]
    out = Bezel::Plug.run(plugs, Bezel::Conn.build(req))
    assert_nil(out.error)
    assert_equal(404, out.final_status)
    assert_equal("x-pages", out.resp_headers["x-seen"])
  end

  def accept(header: String?, formats: Array[String] = ["html", "json"], target: String = "/") -> Symbol?
    h = header ? HTTP::Headers.of({"Accept" => header}) : HTTP::Headers.empty
    Bezel::Plug::Accepts.new(formats).call(Bezel::Conn.build(HTTP::Server::Request.get(target, h))).format
  end

  def test_accepts
    assert_equal(:html, accept(nil))
    assert_equal(:html, accept("*/*"))
    assert_equal(:json, accept("application/json"))
    assert_equal(:json, accept("text/html;q=0.5, application/json"))
    assert_equal(:html, accept("text/html, application/json"))
    assert_equal(:html, accept("text/*"))
    assert_equal(:json, accept("application/json, text/*;q=0"))
    assert_equal(:json, accept("*/*, text/html;q=0"))
    assert_equal(:json, accept("application/*"))
    assert_equal(:html, accept("application/xhtml+xml"))
    assert_raise(Bezel::NotAcceptable) { accept("text/html;q=0, application/xhtml+xml") }
    assert_equal(:json, accept(nil, target: "/?_format=json"))
    assert_raise(Bezel::NotAcceptable) { accept("image/png") }
    assert_raise(Bezel::NotAcceptable) { accept("text/html;q=0") }
    assert_raise(Bezel::NotAcceptable) { accept(nil, target: "/?_format=xml") }
    assert_raise(ArgumentError) { Bezel::Plug::Accepts.new(["yaml"]) }
  end

  # bezel#113: formats given with `types:`, their parameters, and the
  # media type chosen to answer with.
  PROFILE = "application/ld+json; profile=\"https://example.com/profile\""
  DOC = {"doc" => ["application/vnd.example+json", PROFILE]}

  def chosen(header: String?, formats: Array[String] = ["html", "doc"], target: String = "/",
             types: Hash[String, Array[String]] = DOC) -> [String, String]
    h = header ? HTTP::Headers.of({"Accept" => header}) : HTTP::Headers.empty
    c = Bezel::Plug::Accepts.new(formats, types: types).call(Bezel::Conn.build(HTTP::Server::Request.get(target, h)))
    [c.format.inspect, c.format_type || ""]
  end

  def test_accepts_types
    assert_equal([":doc", "application/vnd.example+json"], chosen("application/vnd.example+json"))
    # The type asked for is the one answered, parameters as listed.
    assert_equal([":doc", PROFILE], chosen("application/ld+json; profile=\"https://example.com/profile\""))
    assert_equal([":doc", PROFILE], chosen("application/ld+json;PROFILE=https://example.com/profile;q=0.9, text/html;q=0.5"))
    # A listed parameter is required, and equal.
    assert_equal([":html", "text/html"], chosen("application/ld+json, text/html;q=0.1"))
    assert_raise(Bezel::NotAcceptable) { chosen("application/ld+json; profile=\"https://example.com/other\"") }
    # A parameter the listed type does not name is ignored.
    assert_equal([":doc", "application/vnd.example+json"], chosen("application/vnd.example+json; version=2"))
    # A quoted value holding `,` and `;`.
    tricky = {"doc" => ["application/ld+json; profile=\"https://example.com/a,b;c\""]}
    assert_equal([":doc", "application/ld+json; profile=\"https://example.com/a,b;c\""],
                 chosen("text/html;q=0.2, application/ld+json; profile=\"https://example.com/a,b;c\"", types: tricky))
    assert_equal([":html", "text/html"], chosen("text/html;q=0.2, application/ld+json; profile=\"https://example.com/a\"", types: tricky))
    # Wildcards: the first listed; equal qualities: the earlier listed.
    assert_equal([":doc", "application/vnd.example+json"], chosen("application/*", formats: ["doc", "html"]))
    assert_equal([":doc", "application/vnd.example+json"], chosen("*/*", formats: ["doc"]))
    assert_equal([":doc", "application/vnd.example+json"],
                 chosen("application/ld+json; profile=\"https://example.com/profile\", application/vnd.example+json"))
    assert_equal([":doc", PROFILE],
                 chosen("application/ld+json; profile=\"https://example.com/profile\", application/vnd.example+json;q=0.5"))
    # No Accept, and `_format`: the first listed.
    assert_equal([":doc", "application/vnd.example+json"], chosen(nil, formats: ["doc", "html"]))
    assert_equal([":doc", "application/vnd.example+json"], chosen("text/html", target: "/?_format=doc"))
    # Refused by name.
    assert_raise(Bezel::NotAcceptable) { chosen("application/vnd.example+json;q=0, application/ld+json;q=0", formats: ["doc"]) }
    # Built-in formats: their first type; replaced by types:.
    assert_equal([":json", "application/json"], chosen("application/json", formats: ["json"]))
    assert_equal([":xml", "application/xml"], chosen("*/*", formats: ["xml"]))
    assert_equal([":xml", "text/xml"], chosen("text/xml", formats: ["xml"]))
    assert_equal([":json", "application/vnd.example+json"],
                 chosen("application/vnd.example+json", formats: ["json"], types: {"json" => ["application/vnd.example+json"]}))
    # What types: refuses.
    ["application", "application/*", "a/b/c", "application/x; q=1", "application/x; p", "application/x; p=\"open"].each do |t|
      assert_raise(ArgumentError) { Bezel::Plug::Accepts.new(["doc"], types: {"doc" => [t]}) }
    end
    assert_raise(ArgumentError) { Bezel::Plug::Accepts.new(["Doc"], types: {"Doc" => ["application/x"]}) }
    assert_raise(ArgumentError) { Bezel::Plug::Accepts.new(["doc"], types: {"doc" => Array[String].new}) }
  end

  def test_respond
    h = HTTP::Headers.of({"Accept" => PROFILE})
    c = Bezel::Plug::Accepts.new(["doc"], types: DOC).call(Bezel::Conn.build(HTTP::Server::Request.get("/", h)))
    out = c.respond("{}", status: 201)
    assert_equal([PROFILE, "201", "true"], [out.resp_headers["content-type"] || "", out.status.to_s, out.halted?.to_s])
    assert_equal("application/vnd.example+json", c.with(format_type: "application/vnd.example+json").respond(b"\x00").resp_headers["content-type"])
    e = assert_raise(ArgumentError) { Bezel::Conn.build(HTTP::Server::Request.get("/")).respond("{}") }
    assert_equal("respond: no media type was chosen for the request (no Bezel::Plug::Accepts ran)", e.message)
  end

  def test_controller_helpers
    c = Bezel::Conn.build(req)
    ctl = PlugTestController.new
    sent = ctl.send_file(c, File.join(static_dir, "robots.txt"))
    assert_equal("text/plain; charset=utf-8", sent.resp_headers["content-type"])
    assert_true(sent.halted?)
    assert_raise(Bezel::NotFound) { ctl.send_file(c, File.join(static_dir, "nope.txt")) }
    assert_equal(422, ctl.put_status(c, 422).status)
    assert_equal("/x", ctl.redirect(c, to: "/x").resp_headers["location"])
    assert_true(ctl.halt(c).halted?)
    e = assert_raise(Bezel::ConfigError) { ctl.repo(c) }
    assert_match(/has no database/, e.message)
    assert_equal("hi", ctl.put_flash(c, :info, "hi").flash.kept[:info])
  end
end

# A wrap answering a later plug's NotFound with a page of its own.
class PlugTestPages
  include Bezel::Plug
  def initialize; end
  def call(conn: Bezel::Conn) -> Bezel::Conn = conn
  def wrap(conn: Bezel::Conn, rest: (Bezel::Conn) -> Bezel::Conn) -> Bezel::Conn
    out = rest.call(conn)
    e = out.error
    return out unless e.is_a?(Bezel::NotFound)
    out.with(error: nil).put_resp_header("x-seen", "x-pages").html("<p>none</p>", status: 404)
  end
end
