require "test"

class SecEndpoint < Bezel::Endpoint
  def self.plugs -> Array[Bezel::Plug]
    [Bezel::Plug::Parsers.new,
     Bezel::Plug::MethodOverride.new,
     Bezel::Plug::Session.new(key: "_sec"),
     Bezel::Plug::Flash.new,
     Bezel::Plug::CSRF.new,
     Bezel::Plug::SecureHeaders.new(csp: "default-src 'self'"),
     Bezel.plug do |conn|
       case [conn.method, conn.path]
       in ["GET", "/login"] then conn.put_session("user_id", conn.params.fetch("id")).text("in")
       in ["GET", "/me"] then conn.text("user #{conn.session["user_id"] || "-"}")
       in ["GET", "/logout"] then conn.put_session(conn.session.drop).text("out")
       in ["GET", "/relogin"] then conn.put_session(conn.session.drop).put_session("user_id", "9").put_flash(:info, "welcome").text("re")
       in ["GET", "/renew"] then conn.put_session(conn.session.renew).text("renewed")
       in ["GET", "/renew-token"] then (c2 = conn.put_session(conn.session.renew); c2.text(c2.csrf_token || ""))
       in ["GET", "/drop-token"] then (c3 = conn.put_session(conn.session.drop); c3.text(c3.csrf_token || ""))
       in ["GET", "/secret"] then conn.text(conn.session["_csrf_token"] || "-")
       in ["GET", "/big"] then conn.put_session("blob", "x" * 5000).text("big")
       in ["GET", "/flash"] then conn.put_flash(:info, "saved").redirect("/next")
       in ["GET", "/next"] then conn.text("flash #{conn.flash[:info] || "-"}")
       in ["GET", "/form"] then conn.html(Bezel.html(conn) { |h| h.link("Delete", to: "/thing", method: :delete) })
       in ["GET", "/token"] then conn.text(conn.csrf_token || "")
       in ["POST", "/thing"] then conn.text("posted")
       in ["DELETE", "/thing"] then conn.text("deleted")
       else conn
       end
     end]
  end

  def self.on_error(error: Exception, conn: Bezel::Conn) -> Void = nil
end

class NoSessionEndpoint < Bezel::Endpoint
  def self.plugs -> Array[Bezel::Plug] = [Bezel::Plug::CSRF.new, Bezel.plug { |c| c.text("x") }]
  def self.on_error(error: Exception, conn: Bezel::Conn) -> Void = nil
end

# The requests of one test, through a `Bezel::Testing::Client` (which
# keeps the cookies) with the CSRF check on and the Host `shop.example`.
class SecJar
  @client: Bezel::Testing::Client

  def initialize(app: Bezel::App = Bezel::Testing.app("sec", skip_csrf: false))
    @client = Bezel::Testing::Client.new(SecEndpoint, app)
  end

  def request(method: String, path: String, body: String = "", headers: Hash[String, String] = {}) -> HTTP::Server::Response
    h = headers
    h = h.put("Content-Type", "application/x-www-form-urlencoded") unless body.empty?
    h = h.put("Host", "shop.example") unless h.key?("Host")
    @client.request(method, path, body, h)
  end
end

class SecurityTest < Test::Case
  def text_of(res: HTTP::Server::Response) -> String = Bezel::Testing.body_of(res)

  def app(env: String) -> Bezel::App
    Bezel::App.new(Bezel::Config.load("sec", environ: {"BEZEL_ENV" => env, "SECRET_KEY_BASE" => "k" * 64}, quiet: true))
  end

  def test_session_round_trip_and_drop
    jar = SecJar.new
    assert_equal("user -", text_of(jar.request("GET", "/me")))
    jar.request("GET", "/login?id=7")
    assert_equal("user 7", text_of(jar.request("GET", "/me")))
    secret = text_of(jar.request("GET", "/secret"))
    jar.request("GET", "/logout")
    assert_equal("user -", text_of(jar.request("GET", "/me")))
    # The CSRF secret is a new one: nothing of the old session is kept.
    after = text_of(jar.request("GET", "/secret"))
    assert_false(after == "-")
    assert_false(after == secret)
  end

  def test_cookie_attributes_per_environment
    dev = SecJar.new(app("dev")).request("GET", "/login?id=1").headers.all("set-cookie")
    sc = dev.find { |c| c.start_with?("_sec=") } || ""
    assert_match(/; Path=\/; HttpOnly; SameSite=Lax\z/, sc)
    prod = SecJar.new(app("prod")).request("GET", "/login?id=1").headers.all("set-cookie")
    assert_match(/; Path=\/; HttpOnly; Secure; SameSite=Lax\z/, prod.find { |c| c.start_with?("_sec=") } || "")
    # A request that changes nothing sets no cookie (once CSRF's token is kept).
    jar = SecJar.new
    jar.request("GET", "/me")
    assert_true(jar.request("GET", "/me").headers.all("set-cookie").empty?)
  end

  def test_tampered_or_foreign_cookies_read_as_empty
    jar = SecJar.new
    res = jar.request("GET", "/login?id=7")
    value = (res.headers.all("set-cookie").find { |c| c.start_with?("_sec=") } || "").partition(";")[0].partition("=")[2]
    flipped = value[0, value.size - 2] + (value[value.size - 2] == "A" ? "B" : "A") + value[value.size - 1]
    req = ->(cookie: String, a: Bezel::App) {
      text_of(SecEndpoint.call(HTTP::Server::Request.get("/me", HTTP::Headers.of({"Cookie" => "_sec=#{cookie}"})), a))
    }
    assert_equal("user 7", req.call(value, Bezel::App.test("sec")))
    assert_equal("user -", req.call(flipped, Bezel::App.test("sec")))
    assert_equal("user -", req.call("not-base64!", Bezel::App.test("sec")))
    # Another secret cannot read it.
    assert_equal("user -", req.call(value, app("test")))
  end

  def test_session_too_large
    res = SecJar.new.request("GET", "/big")
    assert_equal(500, res.status)
    assert_match(/session cookie _sec would take/, text_of(res))
  end

  def test_flash_lives_one_request
    jar = SecJar.new
    jar.request("GET", "/flash")
    assert_equal("flash saved", text_of(jar.request("GET", "/next")))
    assert_equal("flash -", text_of(jar.request("GET", "/next")))
  end

  def test_csrf
    jar = SecJar.new
    token = text_of(jar.request("GET", "/token"))
    assert_true(token.size > 40)
    # Masked: another request gives another text for the same secret.
    other = text_of(jar.request("GET", "/token"))
    assert_false(token == other)
    assert_equal(403, jar.request("POST", "/thing", "a=1").status)
    assert_equal(403, jar.request("POST", "/thing", "_csrf_token=nope").status)
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token}").status)
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{other}").status)
    assert_equal(200, jar.request("POST", "/thing", "a=1", {"X-CSRF-Token" => token}).status)
    # Another session's token is refused.
    stranger = SecJar.new
    stranger.request("GET", "/token")
    assert_equal(403, stranger.request("POST", "/thing", "_csrf_token=#{token}").status)
    # Origin and Sec-Fetch-Site.
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Origin" => "http://shop.example"}).status)
    assert_equal(403, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Origin" => "https://evil.example"}).status)
    assert_equal(403, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Origin" => "null"}).status)
    assert_equal(403, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Sec-Fetch-Site" => "cross-site"}).status)
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Sec-Fetch-Site" => "same-origin"}).status)
    # A form from Bezel.html(conn) carries a good token.
    page = text_of(jar.request("GET", "/form"))
    m = page.match(/name="_csrf_token" value="([^"]+)"/)
    assert(m)
    form_token = m ? (m[1] || "") : ""
    assert_equal("deleted", text_of(jar.request("POST", "/thing", "_method=delete&_csrf_token=#{form_token}")))
    # GET needs none.
    assert_equal(200, SecJar.new.request("GET", "/me").status)
  end

  def test_csrf_needs_a_session
    res = NoSessionEndpoint.call(HTTP::Server::Request.get("/"))
    assert_equal(500, res.status)
    assert_match(/needs Plug::Session/, text_of(res))
  end

  def test_secure_headers
    res = SecJar.new.request("GET", "/me")
    assert_equal("nosniff", res.headers["x-content-type-options"])
    assert_equal("SAMEORIGIN", res.headers["x-frame-options"])
    assert_equal("strict-origin-when-cross-origin", res.headers["referrer-policy"])
    assert_equal("default-src 'self'", res.headers["content-security-policy"])
    assert_nil(res.headers["strict-transport-security"])
    c = Bezel::Plug::SecureHeaders.new(frame_options: nil, hsts: 31_536_000).call(Bezel::Conn.build(HTTP::Server::Request.get("/")))
    assert_nil(c.resp_headers["x-frame-options"])
    assert_equal("max-age=31536000; includeSubDomains", c.resp_headers["strict-transport-security"])
  end

  def host(h: String?) -> Bezel::Conn
    hs = h ? HTTP::Headers.of({"Host" => h}) : HTTP::Headers.empty
    Bezel::Plug::HostAuthorization.new(["shop.example", ".cdn.example", "[::1]"]).call(Bezel::Conn.build(HTTP::Server::Request.get("/", hs)))
  end

  def test_host_authorization
    ["shop.example", "SHOP.example:443", "cdn.example", "a.b.cdn.example", "[::1]:8080"].each do |ok|
      assert_false(host(ok).halted?)
    end
    ["evil.example", "shop.example.evil", "xcdn.example", "", "127.0.0.1"].each do |bad|
      assert_raise(Bezel::Forbidden) { host(bad) }
    end
    assert_raise(Bezel::Forbidden) { host(nil) }
  end

  def test_password
    h = Bezel::Password.hash("pw", iterations: 1000)
    assert_match(/\A\$pbkdf2-sha256\$1000\$[A-Za-z0-9_\-]{22}\$[A-Za-z0-9_\-]{43}\z/, h)
    assert_true(Bezel::Password.verify("pw", h))
    assert_false(Bezel::Password.verify("pW", h))
    assert_false(h == Bezel::Password.hash("pw", iterations: 1000))
    assert_false(Bezel::Password.verify("pw", "garbage"))
    assert_false(Bezel::Password.verify("pw", "$pbkdf2-sha256$1000$!!$!!"))
    assert_true(Bezel::Password.needs_rehash?(h))
    assert_false(Bezel::Password.needs_rehash?(h, 1000))
    assert_raise(ArgumentError) { Bezel::Password.hash("pw", iterations: 10) }
  end

  def test_token
    c = Bezel::Config.load("t", environ: {"BEZEL_ENV" => "test"}, quiet: true)
    other = Bezel::Config.load("t", environ: {"BEZEL_ENV" => "test", "SECRET_KEY_BASE" => "z" * 64}, quiet: true)
    t = Bezel::Token.sign(c, "reset", "42", expires_in: 1.hour)
    assert_equal("42", Bezel::Token.verify(c, "reset", t))
    assert_nil(Bezel::Token.verify(c, "confirm", t))
    assert_nil(Bezel::Token.verify(other, "reset", t))
    assert_nil(Bezel::Token.verify(c, "reset", t + "x"))
    assert_nil(Bezel::Token.verify(c, "reset", "garbage"))
    payload, _, mac = t.partition(".")
    forged = Base64.urlsafe_encode("{\"d\":\"1\",\"e\":\"9999999999\"}", padding: false)
    assert_nil(Bezel::Token.verify(c, "reset", "#{forged}.#{mac}"))
    expired = Bezel::Token.sign(c, "reset", "42", expires_in: 0.seconds)
    assert_nil(Bezel::Token.verify(c, "reset", expired))
  end

  def test_constant_time_compare_and_cookies
    assert_true(Bezel::Keys.same?("abc", "abc"))
    assert_false(Bezel::Keys.same?("abc", "abd"))
    assert_false(Bezel::Keys.same?("abc", "ab"))
    assert_equal({"a" => "1", "b" => "x y"}, Bezel::Cookies.parse("a=1; b=\"x y\"; a=2; junk"))
    assert_raise(ArgumentError) { Bezel::Cookies.set_cookie("a b", "x") }
    assert_raise(ArgumentError) { Bezel::Cookies.set_cookie("a", "x;y") }
  end

  def test_drop_then_put_starts_a_new_session
    jar = SecJar.new
    jar.request("GET", "/login?id=7")
    jar.request("GET", "/relogin")
    assert_equal("flash welcome", text_of(jar.request("GET", "/next")))
    assert_equal("user 9", text_of(jar.request("GET", "/me")))
  end

  def test_renew_rotates_the_csrf_secret
    jar = SecJar.new
    first = text_of(jar.request("GET", "/secret"))
    assert_false(first == "-")
    jar.request("GET", "/renew")
    second = text_of(jar.request("GET", "/secret"))
    assert_false(second == "-")
    assert_false(first == second)
  end

  def test_max_age_is_kept_in_the_cookie
    store = Bezel::Session::CookieStore.new(key: "_m", max_age: 3600)
    conn = Bezel::Conn.build(HTTP::Server::Request.get("/"))
    saved = store.save(conn, Bezel::Session.new({"a" => "1"}, true))
    cookie = (saved.resp_headers["set-cookie"] || "").partition(";")[0]
    back = store.load(Bezel::Conn.build(HTTP::Server::Request.get("/", HTTP::Headers.of({"Cookie" => cookie}))))
    assert_equal({"a" => "1"}, back.values)
    expired = Bezel::Session::CookieStore.new(key: "_m", max_age: 0)
    saved0 = expired.save(conn, Bezel::Session.new({"a" => "1"}, true))
    cookie0 = (saved0.resp_headers["set-cookie"] || "").partition(";")[0]
    assert_true(expired.load(Bezel::Conn.build(HTTP::Server::Request.get("/", HTTP::Headers.of({"Cookie" => cookie0})))).values.empty?)
    # A store without max_age reads a cookie with an expiry it did not set as values.
    plain = Bezel::Session::CookieStore.new(key: "_m")
    assert_equal({"a" => "1"}, plain.load(Bezel::Conn.build(HTTP::Server::Request.get("/", HTTP::Headers.of({"Cookie" => cookie})))).values)
  end

  def test_password_bounds
    good = Bezel::Password.hash("pw", iterations: 1000)
    ["$pbkdf2-sha256$0000$AAAAAAAAAAAAAAAAAAAAAA$" + "A" * 43, "$pbkdf2-sha256$0999$AAAAAAAAAAAAAAAAAAAAAA$" + "A" * 43,
     "$pbkdf2-sha256$999999999$AAAAAAAAAAAAAAAAAAAAAA$" + "A" * 43, good + "A"].each do |bad|
      assert_false(Bezel::Password.verify("pw", bad))
    end
    assert_raise(ArgumentError) { Bezel::Password.hash("pw", iterations: 10_000_000) }
  end

  def test_token_fingerprint
    c = Bezel::Config.load("t", environ: {"BEZEL_ENV" => "test"}, quiet: true)
    t = Bezel::Token.sign(c, "reset", "42", expires_in: 1.hour, fingerprint: "hash-1")
    assert_equal("42", Bezel::Token.verify(c, "reset", t, fingerprint: "hash-1"))
    assert_nil(Bezel::Token.verify(c, "reset", t, fingerprint: "hash-2"))
    assert_nil(Bezel::Token.verify(c, "reset", t))
  end

  def test_host_with_a_bad_port_is_refused
    ["shop.example:evil.com", "shop.example:", "Shop.Example:abc", "shop.example:123456", "shop.example/x"].each do |bad|
      assert_raise(Bezel::Forbidden) { host(bad) }
    end
  end

  def test_origin_with_a_default_port
    jar = SecJar.new
    token = text_of(jar.request("GET", "/token", headers: {"Host" => "shop.example:80"}))
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Host" => "shop.example:80", "Origin" => "http://shop.example"}).status)
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Host" => "shop.example", "Origin" => "http://shop.example:80"}).status)
    assert_equal(403, jar.request("POST", "/thing", "_csrf_token=#{token}", {"Host" => "shop.example", "Origin" => "http://shop.example:8080"}).status)
  end

  def test_tokens_rendered_after_renew_or_drop_hold
    jar = SecJar.new
    jar.request("GET", "/me")
    before = text_of(jar.request("GET", "/token"))
    token = text_of(jar.request("GET", "/renew-token"))
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token}").status)
    assert_equal(403, jar.request("POST", "/thing", "_csrf_token=#{before}").status)
    token2 = text_of(jar.request("GET", "/drop-token"))
    assert_false(token2.empty?)
    assert_equal(200, jar.request("POST", "/thing", "_csrf_token=#{token2}").status)
  end

  def test_host_names_are_ascii_and_ports_real
    ["Kiosk.example", "bücher.example", "shop.example:65536", "shop.example:080"].each do |bad|
      assert_raise(Bezel::Forbidden) { host(bad) }
    end
    assert_false(host("shop.example:65535").halted?)
  end

  def test_cookie_store_arguments
    assert_raise(ArgumentError) { Bezel::Session::CookieStore.new(key: "_m", max_age: -5) }
    store = Bezel::Session::CookieStore.new(key: "_m")
    conn = Bezel::Conn.build(HTTP::Server::Request.get("/"))
    assert_raise(ArgumentError) { store.save(conn, Bezel::Session.new({"_bezel_expires" => "1"}, true)) }
  end
end
