require "test"

class ServerTestApp < Bezel::Endpoint
  def self.plugs -> Array[Bezel::Plug]
    [Bezel::Plug::RequestId.new,
     Bezel::Plug::Parsers.new,
     Bezel.plug do |conn|
       if conn.path == "/echo"
         conn.json(JSON.parse("{\"name\": #{JSON.generate(conn.params.fetch("name"))}}"))
       else
         conn
       end
     end]
  end
end

class ServerTest < Test::Case
  def test_through_a_real_server
    app = Bezel::App.new(Bezel::Config.load("server_test", environ: {"BEZEL_ENV" => "test", "HOST" => "127.0.0.1"}))
    server = Bezel.server(ServerTestApp, app, port: 0)
    port = server.local_address.port
    Task.scope do |s|
      s.spawn { server.serve }
      client = HTTP::Client.new(proxy: nil)
      res = client.post("http://127.0.0.1:#{port}/echo", "name=Ann", "application/x-www-form-urlencoded")
      assert_equal(200, res.status)
      assert_equal("Ann", res.json["name"].as_s)
      assert_equal(22, (res.headers["x-request-id"] || "").size)
      missing = client.get("http://127.0.0.1:#{port}/nothing")
      assert_equal(404, missing.status)
      missing.close
      client.close
      server.shutdown(timeout: 1.second)
    end
  end

  def test_start_refuses_a_task_s_configuration
    # (Local and on a free port, should the check ever regress.)
    task = Bezel::Config.for_task("server_test_app", environ: {"BEZEL_ENV" => "prod", "HOST" => "127.0.0.1", "PORT" => "0"})
    e = assert_raise(Bezel::ConfigError) { Bezel.start(ServerTestApp, config: task) }
    assert_match(/task's configuration .* cannot serve/, e.message)
    # Through `Bezel.main`: a message and status 1, not a trace.
    assert_equal(1, Bezel.main(["server"], ServerTestApp, config: task))
  end

  def test_start_stops_on_term
    probe = TCPServer.new("127.0.0.1", 0)
    port = probe.local_address.port
    probe.close
    c = Bezel::Config.load("start_test", environ: {"BEZEL_ENV" => "test", "HOST" => "127.0.0.1", "PORT" => port.to_s})
    out = Task.scope do |s|
      t = s.spawn do
        Bezel.start(ServerTestApp, config: c, grace: 1.second)
        "stopped"
      end
      # (The traps are set before the server answers.)
      up = false
      100.times do
        break if up
        begin
          HTTP::Client.new(timeout: 1.second, proxy: nil).get("http://127.0.0.1:#{port}/nothing").close
          up = true
        rescue HTTP::Client::Error
          Task.sleep(50.ms)
        end
      end
      assert_true(up)
      Process.run("kill", "-TERM", Process.pid.to_s)
      t.await
    end
    assert_equal("stopped", out)
  end

  # bezel#112: Bezel.serve, for several servers and services.
  def two_servers -> Array[HTTP::Server]
    app = Bezel::App.new(Bezel::Config.load("serve_test", environ: {"BEZEL_ENV" => "test", "HOST" => "127.0.0.1"}))
    [Bezel.server(ServerTestApp, app, port: 0), Bezel.server(ServerTestApp, app, port: 0)]
  end

  # A service that runs until its shutdown, recording the grace it got;
  # `fail` makes its run raise, `bad_shutdown` its shutdown.
  def fake_service(graces: Atom[Array[Duration]], *, fail: Bool = false, bad_shutdown: Bool = false) -> Bezel::Service
    stop = Channel[Nil].new
    Bezel.service(run: -> {
      if fail
        Task.sleep(50.ms)
        raise ArgumentError.new("the service failed")
      end
      stop.receive?
      nil
    }, shutdown: ->(g: Duration) {
      graces.update { |a| a + [g] }
      raise ArgumentError.new("cannot stop") if bad_shutdown
      stop.close
      nil
    })
  end

  def up?(port: Int) -> Bool
    100.times do
      begin
        HTTP::Client.new(timeout: 1.second, proxy: nil).get("http://127.0.0.1:#{port}/nothing").close
        return true
      rescue HTTP::Client::Error
        Task.sleep(50.ms)
      end
    end
    false
  end

  def test_serve_stops_servers_and_services_on_term
    servers = two_servers
    ports = servers.map { |srv| srv.local_address.port }
    graces = Atom[Array[Duration]].new([])
    svc = fake_service(graces)
    out = Task.scope do |s|
      t = s.spawn do
        Bezel.serve(servers, grace: 2.seconds, also: [svc])
        "stopped"
      end
      assert_true(ports.all? { |port| up?(port) })
      Process.run("kill", "-TERM", Process.pid.to_s)
      t.await
    end
    assert_equal("stopped", out)
    assert_equal([2.seconds], graces.get)
    # Both stopped: nothing answers any more.
    ports.each do |port|
      assert_raise(HTTP::Client::Error) { HTTP::Client.new(timeout: 1.second, proxy: nil).get("http://127.0.0.1:#{port}/") }
    end
  end

  # One task that raises shuts the others down, and its error is raised
  # again once all have stopped.
  def test_serve_a_failing_service_stops_the_servers
    servers = two_servers
    graces = Atom[Array[Duration]].new([])
    other = fake_service(graces)
    e = assert_raise(ArgumentError) { Bezel.serve(servers, grace: 1.second, also: [fake_service(graces, fail: true), other]) }
    assert_equal("the service failed", e.message)
    assert_equal(2, graces.get.size)
  end

  # A server already shut down (its serve returns at once) ends the
  # others too.
  def test_serve_with_a_server_already_shut_down
    servers = two_servers
    servers[0].shutdown(timeout: 1.second)
    graces = Atom[Array[Duration]].new([])
    Bezel.serve(servers, grace: 1.second, also: [fake_service(graces)])
    assert_equal([1.second], graces.get)
  end

  # A service whose shutdown raises is reported, and its run cancelled
  # after the grace plus 10 seconds: serve still returns.
  def test_serve_a_shutdown_that_raises
    graces = Atom[Array[Duration]].new([])
    servers = two_servers
    servers[0].shutdown(timeout: 1.second)
    started = Time.now
    Bezel.serve(servers, grace: 100.ms, also: [fake_service(graces, bad_shutdown: true)])
    assert_equal(1, graces.get.size)
    assert_true(Time.now - started < 30.seconds)
  end

  def test_serve_needs_something
    assert_raise(ArgumentError) { Bezel.serve(Array[HTTP::Server].new) }
  end
end
