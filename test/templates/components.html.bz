{args user: User, notes: Array[String]}
<Panel title={user.name} class="wide">
  <p>{user.email}</p>
  <:footer>
    <a href={"/users/#{user.id}"}>Edit</a>
  </:footer>
</Panel>
<Ui::Badge label="new" />
<Panel title="Notes">
  <p :for={n in notes} :if={!n.empty?}>{n}</p>
</Panel>
<Panel :for={n, i in notes.each_with_index.to_a} title={"Note #{i.to_s}"}>{n}</Panel>
