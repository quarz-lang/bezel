{args code: String, html: String, n: Int, missing: String?}
<pre>
  line one
    {code}
</pre>
<textarea name="body">
{code} &amp; more</textarea>
<p>
  A <b>bold</b>
  <i>move</i>, {n} items{missing}.
</p>
<p>{raw(html)} and {"{"}braces{"}"}</p>
<p>{Bezel::Html.raw("<em>safe</em>")}</p>
<p title={code if n > 0}>{code.gsub(/[<"}]/, "") + "#{n / 3}"} &copy;&nbsp;2026 &mdash;&#x21;</p>
