  # Renders test/templates/components.html.bz.
  def self.components(user: User, notes: Array[String]) -> Bezel::Html
    Bezel.html do |h|
      __bz_slot_1 = h.capture do
        h.a("Edit", href: ("/users/#{user.id}"))  # components.html.bz:5
      end
      h.component(Panel.new(title: user.name, class_name: "wide", footer: __bz_slot_1)) do  # components.html.bz:2
        h.p do
          h.put(user.email)  # components.html.bz:3
        end
      end
      h.text("\n")
      h.component(Ui::Badge.new(label: "new"))  # components.html.bz:8
      h.text("\n")
      h.component(Panel.new(title: "Notes")) do  # components.html.bz:9
        notes.each do |n|  # components.html.bz:10
          if (!n.empty?)  # components.html.bz:10
            h.p do
              h.put(n)  # components.html.bz:10
            end
          end
        end
      end
      h.text("\n")
      notes.each_with_index.to_a.each do |n, i|  # components.html.bz:12
        h.component(Panel.new(title: ("Note #{i.to_s}"))) do  # components.html.bz:12
          h.put(n)  # components.html.bz:12
        end
      end
    end
  end

