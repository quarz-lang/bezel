# What `Bezel::Plug::Logger` reports of one request.
data LogEvent(
  # The method (`"GET"`).
  method: String,
  # The path, without the query (which may carry a token).
  path: String,
  # The response's status (500 for an exception).
  status: Int,
  # The time from the endpoint taking the request to the response.
  duration: Duration,
  # The request's id, or nil.
  request_id: String?
)
  # One line: `GET /users -> 200 in 1.2ms [id]`.
  def to_s -> String
    "#{method} #{path} -> #{status} in #{duration}#{request_id ? " [#{request_id}]" : ""}"
  end
end

# Logs one line per request, once the rest of the pipeline has answered
# (with the status, or 500 when it raised): to standard error, or to
# `on_event` when given (for structured logs). Lines are written at the
# `info` level, so a LOG_LEVEL of `warn` or `error` silences them.
# The path is written percent-decoded, as `Conn#path`; control
# characters in it are escaped, so that a request cannot forge a line.
class Plug::Logger
  include Plug

  @on_event: (shareable (LogEvent) -> Void)?

  # The plug, reporting to `on_event` when given, else to standard error.
  def initialize(@on_event: (shareable (LogEvent) -> Void)? = nil); end

  def call(conn: Conn) -> Conn = conn

  def wrap(conn: Conn, rest: (Conn) -> Conn) -> Conn
    return rest.call(conn) unless conn.config.log?(:info)
    begin
      out = rest.call(conn)
    rescue HTTP::Error => e
      report(conn, e.status)
      raise e
    rescue StandardError => e
      report(conn, 500)
      raise e
    end
    report(out, out.status)
    out
  end

  # :nodoc:
  def report(conn: Conn, status: Int) -> Void
    path = conn.path.gsub(/[\x00-\x1f\x7f]/) { |c| "\\x#{c.ord.to_s(16).rjust(2, "0")}" }
    event = LogEvent.new(conn.method, path, status, Time.monotonic - conn.started, conn.request_id)
    f = @on_event
    if f
      f.call(event)
    else
      STDERR.puts event.to_s
    end
  end
end
