# Runs a `HEAD` request as a `GET`, so that the routes and actions of
# `GET` answer it (the server sends no body for it).
class Plug::Head
  include Plug

  # The plug.
  def initialize; end

  def call(conn: Conn) -> Conn
    conn.method == "HEAD" ? conn.with(request: conn.request.with(method: "GET")) : conn
  end
end
