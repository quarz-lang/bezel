# Gives each request an id: the request's `X-Request-Id` when it is a
# sane one (20 to 200 characters of letters, digits, `+`, `/`, `=`, `_`
# and `-`, as a proxy in front makes), else a new random one. The id is
# `Conn#request_id` and goes back in the response's `X-Request-Id`, so
# that a log line and a client's report can be matched.
#
# ```
# conn = Bezel::Plug::RequestId.new.call(Bezel::Conn.build(HTTP::Server::Request.get("/")))
# (conn.request_id || "").size                             # => 22
# conn.resp_headers["x-request-id"] == conn.request_id      # => true
# ```
class Plug::RequestId
  include Plug

  @header: String

  # The plug, reading and writing the header `header`.
  def initialize(@header: String = "x-request-id"); end

  # The header read and written.
  def header -> String = @header

  def call(conn: Conn) -> Conn
    given = conn.header(header)
    id = given && Plug::RequestId.valid?(given) ? given : Plug::RequestId.generate
    conn.with(request_id: id).put_resp_header(header, id)
  end

  # Whether `id` may be kept.
  def self.valid?(id: String) -> Bool = id.size >= 20 && id.size <= 200 && id.match?(/\A[A-Za-z0-9+\/=_-]+\z/)

  # A new id: 16 random bytes in URL-safe Base64.
  def self.generate -> String = Base64.urlsafe_encode(Random.bytes(16), padding: false)
end
