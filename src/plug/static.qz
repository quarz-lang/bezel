# Serves the files under the directory `from` at the path `at`
# (`at: "/", from: "priv/static"` serves `priv/static/app.css` as
# `/app.css`), for `GET` and `HEAD`; any other request, or a path with no
# such file, goes on to the next plug. A directory is never listed.
#
# Refused (passed on, so the router answers them): a path segment that
# is empty, `.` or `..`, that begins with `.` (`.env`, `.git`), or that
# holds `\`, a NUL or a control character. With `only:`, the first
# segment must be one of those names (`["css", "js", "favicon.ico"]`).
#
# Each file is answered with its `Content-Type` (by its extension), an
# `ETag` (from its size and modification time), `Last-Modified` and
# `Cache-Control` (`cache_control:`); a request whose `If-None-Match`
# has the `ETag`, or (without `If-None-Match`) whose `If-Modified-Since`
# is the `Last-Modified` sent, is answered `304 Not Modified`.
class Plug::Static
  include Plug

  @at: String
  @from: String
  @only: Array[String]
  @cache_control: String

  # Serves `from`'s files under `at`.
  def initialize(*, at: String, from: String, only: Array[String] = [],
                 cache_control: String = "public, max-age=0")
    raise ArgumentError.new("at: must begin with `/`, not #{at.inspect}") unless at.start_with?("/")
    @at = at.end_with?("/") ? at : at + "/"
    @from = from
    @only = only
    @cache_control = cache_control
  end

  # The content types by extension.
  TYPES = {
    "html" => "text/html; charset=utf-8", "htm" => "text/html; charset=utf-8",
    "css" => "text/css; charset=utf-8", "js" => "text/javascript; charset=utf-8",
    "mjs" => "text/javascript; charset=utf-8", "json" => "application/json",
    "map" => "application/json", "txt" => "text/plain; charset=utf-8",
    "xml" => "application/xml", "svg" => "image/svg+xml", "png" => "image/png",
    "jpg" => "image/jpeg", "jpeg" => "image/jpeg", "gif" => "image/gif",
    "webp" => "image/webp", "avif" => "image/avif", "ico" => "image/vnd.microsoft.icon",
    "woff" => "font/woff", "woff2" => "font/woff2", "ttf" => "font/ttf", "otf" => "font/otf",
    "pdf" => "application/pdf", "wasm" => "application/wasm", "webmanifest" => "application/manifest+json",
    "mp4" => "video/mp4", "webm" => "video/webm", "mp3" => "audio/mpeg", "ogg" => "audio/ogg",
    "zip" => "application/zip", "gz" => "application/gzip", "csv" => "text/csv; charset=utf-8"
  }

  def call(conn: Conn) -> Conn
    m = conn.method
    return conn unless m == "GET" || m == "HEAD"
    segments = segments_of(conn.path)
    return conn if segments.nil?
    file = File.join(@from, *segments)
    return conn unless File.file?(file) && File.readable?(file)
    size = File.size(file)
    mtime = File.mtime(file).utc
    etag = "W/\"#{size.to_s(16)}-#{mtime.to_i.to_s(16)}\""
    modified = Plug::Static.http_date(mtime)
    conn = conn.put_resp_header("etag", etag).put_resp_header("last-modified", modified)
                .put_resp_header("cache-control", @cache_control)
    if Plug::Static.fresh?(conn, etag, modified)
      return conn.send_resp(304, HTTP::Content::Empty)
    end
    ext = File.extname(file).delete_prefix(".").downcase
    type = TYPES[ext]? || "application/octet-stream"
    conn.send_resp(200, HTTP::Content::Binary.new(File.read_bytes(file)), type)
  end

  # :nodoc:
  # The segments of `path` under `at`, or nil when it is not under it or
  # holds one refused.
  def segments_of(path: String) -> Array[String]?
    return nil unless path.start_with?(@at)
    rest = path.delete_prefix(@at)
    return nil if rest.empty?
    segments = rest.split("/", -1)
    ok = segments.all? do |s|
      !s.empty? && !s.start_with?(".") && !s.include?("\\") && !s.match?(/[\x00-\x1f\x7f]/)
    end
    return nil unless ok
    return nil unless @only.empty? || @only.include?(segments[0])
    segments
  end

  # :nodoc:
  def self.fresh?(conn: Conn, etag: String, modified: String) -> Bool
    inm = conn.header("if-none-match")
    if inm
      tags = inm.split(",").map { |t| t.strip.delete_prefix("W/") }
      return tags.include?("*") || tags.include?(etag.delete_prefix("W/"))
    end
    conn.header("if-modified-since") == modified
  end

  # `time` as an HTTP date: `Sun, 06 Nov 1994 08:49:37 GMT`.
  def self.http_date(time: Time) -> String = time.utc.strftime("%a, %d %b %Y %H:%M:%S GMT")
end
