# What an application's `config/<env>.qz` gives for one environment
# (MyApp::Config.dev returns one): every setting optional, the
# environment variables taking precedence over it. Secrets are not here:
# SECRET_KEY_BASE comes from the environment only. Its [inspect] and
# [to_s] do not show the database's URL, which holds its password.
data Settings(
  # The address to listen on.
  host: String? = nil,
  # The port.
  port: Int? = nil,
  # The database (`postgres://...`); nil for an application without one.
  database_url: String? = nil,
  # The proxies whose `X-Forwarded-*` headers are believed (addresses or
  # networks, as [HTTP::Server]'s `trusted_proxies:`).
  trusted_proxies: Array[String]? = nil,
  # `:debug`, `:info`, `:warn` or `:error`.
  log_level: Symbol? = nil,
  # The size of the database's connection pool.
  pool_size: Int? = nil,
  # The cost of [Bezel::Password]'s hashes (`Crypto::Argon2::Params::DEFAULT`
  # when nil).
  password_params: Crypto::Argon2::Params? = nil,
  # Parameter names the error pages hide beside [Bezel::Params::FILTERED]
  # (a [String] is a part of the name, in any case; a [Regexp] a
  # pattern): [Bezel::Params#filtered].
  filter_parameters: Array[String | Regexp]? = nil
)
  # The settings without the database's URL.
  def inspect -> String
    "#<Bezel::Settings host: #{host.inspect}, port: #{port.inspect}, " +
      "database_url: #{database_url ? "(set)" : "nil"}, trusted_proxies: #{trusted_proxies.inspect}, " +
      "log_level: #{log_level.inspect}, pool_size: #{pool_size.inspect}, password_params: #{password_params.inspect}, " +
      "filter_parameters: #{filter_parameters.inspect}>"
  end

  # As [inspect].
  def to_s -> String = inspect
end

# An application's settings, for one environment: what [Config.load]
# makes of the environment variables over the application's [Settings].
#
# | Variable | Setting | Default |
# |---|---|---|
# | BEZEL_ENV | [env]: `dev`, `test` or `prod` | `prod`: set `BEZEL_ENV=dev` when developing ([Bezel::App.test] sets `test`) |
# | HOST, PORT | where the server listens | `127.0.0.1` in `dev` and `test`, `0.0.0.0` in `prod`; `4000` |
# | DATABASE_URL | the database, a [PG::Pool] behind [Rotor::Repo] | none |
# | POOL_SIZE | the pool's connections | 10 |
# | SECRET_KEY_BASE | the key sessions and tokens derive theirs from, 64 bytes or more | required in `prod`; in `dev`, a random one kept in `tmp/dev_secret` (made on first use, announced); in `test`, a random one per process |
# | TRUSTED_PROXIES | proxies, separated by commas | none |
# | TLS_CERT, TLS_KEY | paths of the certificate chain and its key (PEM): HTTPS | none (behind a proxy) |
# | LOG_LEVEL | `debug`, `info`, `warn` or `error` | `info` |
# | (none) | [password_params]: the cost of [Bezel::Password]'s hashes | `Crypto::Argon2::Params::DEFAULT` |
# | (none) | [filter_parameters]: parameter names the error pages hide beside [Bezel::Params::FILTERED] | none |
#
# A value that does not parse (a port, a level, a proxy, a database
# URL, a certificate and its key, which are read), or a missing one that
# is required, is a [Bezel::ConfigError] when the configuration is
# loaded, before the server starts. Its [inspect] and [to_s] do not show the secret or the
# database's URL.
#
# ```
# c = Bezel::Config.load("shop", environ: {"BEZEL_ENV" => "test", "PORT" => "8080"})
# c.env                   # => :test
# c.port                  # => 8080
# c.secret_key_base.size  # => 64
# ```
data Config(
  # The application's name (`my_app`).
  app: String,
  # `:dev`, `:test` or `:prod`.
  env: Symbol,
  # The address to listen on.
  host: String,
  # The port.
  port: Int,
  # The database's URL, or nil.
  database_url: String?,
  # The size of the database's connection pool.
  pool_size: Int,
  # The key sessions and tokens derive theirs from, a [Bytes::Secret]
  # (bezel#86): `to_h` shows it as `#<Bytes::Secret>`, and
  # `JSON.generate` of a configuration raises `JSON::GeneratorError`.
  secret_key_base: Bytes::Secret,
  # The trusted proxies.
  trusted_proxies: Array[String],
  # The path of the certificate chain, for HTTPS.
  tls_cert: String?,
  # The path of the certificate's key, for HTTPS.
  tls_key: String?,
  # `:debug`, `:info`, `:warn` or `:error`.
  log_level: Symbol,
  # The cost of [Bezel::Password]'s hashes.
  password_params: Crypto::Argon2::Params = Crypto::Argon2::Params::DEFAULT,
  # Parameter names the error pages hide beside [Bezel::Params::FILTERED]
  # ([Bezel::Params#filtered]).
  filter_parameters: Array[String | Regexp] = []
)
  # Whether [secret_key_base] is the public placeholder of a task's
  # configuration ([.for_task] in `prod` without SECRET_KEY_BASE,
  # [TASK_SECRET]): it signs nothing, so [Bezel.start] and
  # [Bezel::Keys.derive] refuse it. Computed from the secret (compared in
  # constant time), however the configuration was made (`with` too).
  def task? -> Bool = Crypto.secure_compare(secret_key_base, TASK_SECRET)

  # The levels, least severe first.
  LOG_LEVELS = [:debug, :info, :warn, :error]

  # The environments.
  ENVS = [:dev, :test, :prod]

  # The configuration of the application [app] from the environment
  # variables `environ` over the [Settings] its environment has in
  # `settings` (`{dev: MyApp::Config.dev, prod: MyApp::Config.prod}`).
  # A secret made for `dev` is announced on standard error, once per
  # load, unless `quiet`.
  #
  # A SECRET_KEY_BASE equal to `TASK_SECRET`, the placeholder of a task's
  # configuration, is refused: it is public. (`task:` is `for_task`'s.)
  def self.load(app: String, settings: Hash[Symbol, Settings] = {},
                environ: Hash[String, String] = ENV, quiet: Bool = false, task: Bool = false) -> Config
    raise ConfigError.new("the application's name is empty") if app.empty?
    env_name = Config.var(environ, "BEZEL_ENV") || "prod"
    env = env_name.to_sym
    unless ENVS.include?(env)
      raise ConfigError.new("BEZEL_ENV must be dev, test or prod, not #{env_name.inspect}")
    end
    s = settings[env]? || Settings.new
    # Loopback outside `prod` (bezel#99): a development server on every
    # interface shows its error pages, and its sessions, to the network.
    host = Config.var(environ, "HOST") || s.host || (env == :prod ? "0.0.0.0" : "127.0.0.1")
    port = Config.int_var(environ, "PORT") || s.port || 4000
    raise ConfigError.new("PORT must be within 0..65535, not #{port}") if port < 0 || port > 65_535
    pool_size = Config.int_var(environ, "POOL_SIZE") || s.pool_size || 10
    raise ConfigError.new("POOL_SIZE must be positive, not #{pool_size}") if pool_size < 1
    db = Config.var(environ, "DATABASE_URL") || s.database_url
    if db
      begin
        # (Against `environ`, as the rest of the configuration: pg takes
        # libpq's variables from it for what the URL omits, bezel#117.)
        PG.parse_url(db, env: environ)
      rescue ArgumentError => e
        # A libpq variable's own error names the variable and never its
        # value: kept. Otherwise not pg's message, which may quote the
        # URL and its password.
        raise ConfigError.new(e.message) if e.message.match?(/\APG[A-Z_]+: /)
        raise ConfigError.new("DATABASE_URL is not a postgres:// URL that pg reads (user, password, host, port, database and the parameters pg knows)")
      end
    end
    proxies = Config.var(environ, "TRUSTED_PROXIES")&.split(",")&.map(&:strip)&.reject(&:empty?) || s.trusted_proxies || []
    begin
      HTTP::Proxies.of(proxies)
    rescue ArgumentError => e
      raise ConfigError.new("TRUSTED_PROXIES: #{e.message}")
    end
    level_name = Config.var(environ, "LOG_LEVEL")
    level = level_name ? level_name.downcase.to_sym : (s.log_level || :info)
    unless LOG_LEVELS.include?(level)
      raise ConfigError.new("LOG_LEVEL must be debug, info, warn or error, not #{(level_name || level.to_s).inspect}")
    end
    cert = Config.var(environ, "TLS_CERT")
    key = Config.var(environ, "TLS_KEY")
    if cert.nil? != key.nil?
      raise ConfigError.new("TLS_CERT and TLS_KEY go together: #{cert ? "TLS_KEY" : "TLS_CERT"} is missing")
    end
    if cert && key
      [cert, key].each do |path|
        raise ConfigError.new("TLS file #{path.inspect} cannot be read") unless File.file?(path) && File.readable?(path)
      end
      begin
        TLS::ServerConfig.new(certificate: File.read_bytes(cert), private_key: File.read_bytes(key))
      rescue TLS::Error => e
        raise ConfigError.new("TLS_CERT/TLS_KEY: #{e.message}")
      end
    end
    given = Config.var(environ, "SECRET_KEY_BASE")
    secret: Bytes::Secret? = nil
    if given
      raise ConfigError.new("SECRET_KEY_BASE must be at least 64 bytes (it has #{given.bytesize})") if given.bytesize < 64
      if given == TASK_SECRET && !task
        raise ConfigError.new("SECRET_KEY_BASE is the placeholder of a task's configuration (Config::TASK_SECRET), which is public: set a secret of your own (`openssl rand -hex 32` gives one)")
      end
      # (A secret by type: ENV keeps the String it came as.)
      secret = Bytes::Secret.of(given.to_bytes)
    elsif env == :prod
      raise ConfigError.new("SECRET_KEY_BASE is required in prod (64 bytes or more; `openssl rand -hex 32` gives one); BEZEL_ENV is prod unless set to dev or test")
    else
      secret = Config.dev_secret(env)
      unless quiet || env == :test
        STDERR.puts "bezel: SECRET_KEY_BASE is not set; dev uses the random one in #{DEV_SECRET_PATH} " +
                    "(made on first use: keep tmp/ out of version control), not for production"
      end
    end
    Config.new(app, env, host, port, db, pool_size, secret.as(Bytes::Secret), proxies, cert, key, level,
               s.password_params || Crypto::Argon2::Params::DEFAULT, s.filter_parameters || [])
  end

  # The configuration of a task that serves no request (a migration, a
  # job worker): as [.load] makes it of the same environment and
  # settings, but SECRET_KEY_BASE is not required in `prod`, and the
  # secret of `dev` and `test` is not announced (it is the server's: in
  # `dev` the same file, so a task's tokens verify there). In `prod` without one (or
  # with one too short), its [secret_key_base] is a placeholder that signs
  # nothing: such a task must not make sessions or tokens.
  #
  # ```
  # c = Bezel::Config.for_task("shop", environ: {"BEZEL_ENV" => "prod"})
  # c.env                   # => :prod
  # c.task?                 # => true
  # ```
  def self.for_task(app: String, settings: Hash[Symbol, Settings] = {}, environ: Hash[String, String] = ENV) -> Config
    prod = (Config.var(environ, "BEZEL_ENV") || "prod") == "prod"
    given = Config.var(environ, "SECRET_KEY_BASE")
    env = !prod || (given && given.bytesize >= 64) ? environ : environ.put("SECRET_KEY_BASE", TASK_SECRET)
    Config.load(app, settings, environ: env, quiet: true, task: true)
  end

  # The placeholder secret of a task's configuration in `prod` without
  # SECRET_KEY_BASE (`for_task`): [Bezel::Keys.derive] refuses it, so
  # that nothing is signed with it, and `load` refuses it as the
  # application's.
  TASK_SECRET = "-" * 64

  # Where `dev` keeps its secret, relative to the application's
  # directory (the one it runs in).
  DEV_SECRET_PATH = "tmp/dev_secret"

  # A secret made once per process (`test`, and `dev` when its file cannot
  # be written).
  PROCESS_SECRET = Atom[Bytes::Secret?].new(nil)

  # The secret `dev` and `test` use without SECRET_KEY_BASE (bezel#99):
  # random, so that no one can compute it (a digest of the application's
  # name could be, and with it any session sealed). In `dev`, kept in
  # [DEV_SECRET_PATH], made on first use only when absent and readable by
  # its owner alone (`0o600`), so that sessions survive a restart and a
  # task's tokens verify in the server, however many processes start at
  # once; when the file cannot be kept, one per process, with a warning.
  # In `test`, one per process.
  #
  # A [Bytes::Secret]: the file's secret read with `File.read_secret`
  # (its newline left out), the per-process one drawn with
  # `Crypto.random_secret` (bezel#86).
  def self.dev_secret(env: Symbol) -> Bytes::Secret
    if env == :dev
      begin
        Dir.mkdir_p(File.dirname(DEV_SECRET_PATH))
        begin
          # Made only when absent, readable by this user alone: two
          # processes at first use (a server and a task) end with the one
          # secret the file holds, not each its own. (Its text, 64
          # hexadecimal digits, is a String while it is written: dev's
          # only.)
          File.open(DEV_SECRET_PATH, "wx", perm: 0o600) { |f| f.write(Crypto.random_bytes(32).hex + "\n") }
        rescue SystemCallError => e
          raise e unless File.exist?(DEV_SECRET_PATH)
        end
        # What the file holds (this process's or another's), once it is
        # whole.
        40.times do
          kept = File.read_secret(DEV_SECRET_PATH, chomp: true)
          return kept if kept.size >= 64
          Task.sleep(50.ms)
        end
        raise IOError.new("it holds no secret of 64 bytes")
      rescue IOError, SystemCallError => e
        STDERR.puts "bezel: #{DEV_SECRET_PATH} cannot be kept (#{e.message}); this process uses a secret of its own"
      end
    end
    loop do
      current = PROCESS_SECRET.get
      return current if current
      PROCESS_SECRET.compare_and_set(nil, Crypto.random_secret(64))
    end
  end

  # :nodoc:
  def self.var(environ: Hash[String, String], name: String) -> String?
    v = environ[name]?
    v.nil? || v.strip.empty? ? nil : v.strip
  end

  # :nodoc:
  def self.int_var(environ: Hash[String, String], name: String) -> Int?
    v = Config.var(environ, name)
    return nil if v.nil?
    raise ConfigError.new("#{name} must be an integer, not #{v.inspect}") unless v.match?(/\A[0-9]+\z/)
    begin
      v.to_i
    rescue OverflowError
      raise ConfigError.new("#{name} is out of range")
    end
  end

  # Whether this is `dev`.
  def dev? -> Bool = env == :dev
  # Whether this is `test`.
  def test? -> Bool = env == :test
  # Whether this is `prod`.
  def prod? -> Bool = env == :prod

  # Whether a message of `level` is logged at this configuration's level.
  def log?(level: Symbol) -> Bool
    (LOG_LEVELS.index(level) || 0) >= (LOG_LEVELS.index(log_level) || 0)
  end

  # The server's TLS settings, read from [tls_cert] and [tls_key], or nil
  # without them.
  def tls -> TLS::ServerConfig?
    cert = tls_cert
    key = tls_key
    return nil if cert.nil? || key.nil?
    TLS::ServerConfig.new(certificate: File.read_bytes(cert), private_key: File.read_bytes(key),
                          alpn: ["http/1.1"])
  end

  # The settings without the secret and the database's URL.
  def inspect -> String
    "#<Bezel::Config app: #{app.inspect}, env: #{env.inspect}, host: #{host.inspect}, port: #{port}, " +
      "database_url: #{database_url ? "(set)" : "nil"}, pool_size: #{pool_size}, secret_key_base: <hidden>, " +
      "trusted_proxies: #{trusted_proxies.inspect}, tls: #{tls_cert ? "on" : "off"}, log_level: #{log_level.inspect}, " +
      "password_params: #{password_params.inspect}, filter_parameters: #{filter_parameters.inspect}>"
  end

  # As [inspect].
  def to_s -> String = inspect
end
