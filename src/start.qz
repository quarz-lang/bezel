# Serves `endpoint` until the process is told to stop: loads the
# configuration (`Bezel::Config.load` over the application's `settings`,
# `{dev: MyApp::Config.dev, ...}`, its name taken from the endpoint's
# namespace, MyApp::Endpoint giving `my_app`; or `config` when given),
# opens the database's pool when there is a DATABASE_URL, and runs an
# `HTTP::Server` with the endpoint's handler on HOST:PORT (HTTPS with
# TLS_CERT and TLS_KEY).
#
# SIGTERM shuts the server down gracefully: no new connections, the
# requests in flight given `grace` to finish, then cancelled; SIGINT
# (Ctrl-C) does the same with one second. A second signal during the
# shutdown ends the process at once (status 1), for a request that
# never waits. Returns once the server has stopped and the pool is
# closed, with the default actions of SIGTERM and SIGINT back: traps the
# application set for them before are dropped, not restored. A task's
# configuration (`Config.for_task` in prod without SECRET_KEY_BASE) is
# refused at once (`Bezel::ConfigError`): it signs no session.
#
# ```quarz no_run
# # src/main.qz of an application
# class Store < Bezel::Endpoint
#   def self.plugs -> Array[Bezel::Plug] = [Bezel::Plug::Logger.new, Bezel.plug { |conn| conn.text("hi") }]
# end
#
# Bezel.start(Store, {prod: Bezel::Settings.new(port: 8080)})
# ```
public def start(endpoint: Type[Endpoint], settings: Hash[Symbol, Settings] = {}, *, config: Config? = nil,
                 grace: Duration = 30.seconds) -> Void
  c = config || Config.load(app_name(endpoint), settings)
  if c.secret_key_base == Config::TASK_SECRET
    raise ConfigError.new("#{c.app}: a task's configuration (Bezel::Config.for_task) cannot serve: its SECRET_KEY_BASE is the placeholder, which signs no session; set SECRET_KEY_BASE and use Bezel::Config.load")
  end
  pool = open_pool(c)
  begin
    srv = server(endpoint, App.new(c, pool))
    signals = Atom.new(0)
    Signal.trap(:TERM) do
      if signals.update { |n| n + 1 } > 1
        STDERR.puts "bezel: a second signal: exiting now"
        exit!(1)
      end
      srv.shutdown(timeout: grace)
    end
    Signal.trap(:INT) do
      if signals.update { |n| n + 1 } > 1
        STDERR.puts "bezel: a second signal: exiting now"
        exit!(1)
      end
      srv.shutdown(timeout: 1.second)
    end
    a = srv.local_address
    STDERR.puts "bezel: #{c.app} (#{c.env}) listening on #{c.tls_cert ? "https" : "http"}://#{a.host}:#{a.port}"
    Task.scope do |s|
      s.spawn { srv.serve }
    end
  ensure
    Signal.trap(:TERM, :default)
    Signal.trap(:INT, :default)
    pool&.close
  end
end

# The server `Bezel.start` runs, for `endpoint` in `app`, bound at once
# (`port` 0 picks a free port: a test reads it from `local_address`),
# not yet serving.
public def server(endpoint: Type[Endpoint], app: App, *, port: Int? = nil) -> HTTP::Server
  c = app.config
  HTTP::Server.new(endpoint.handler(app), host: c.host, port: port || c.port,
                   trusted_proxies: c.trusted_proxies, tls: c.tls)
end

# The application's name for `endpoint`: its outermost namespace in
# snake_case (MyApp::Endpoint is `my_app`).
public def app_name(endpoint: Type[Endpoint]) -> String
  Rotor::Inflector.underscore(endpoint.name.partition("::")[0])
end

# :nodoc:
# The pool of `config`'s database, or nil without one.
def open_pool(config: Config) -> PG::Pool?
  url = config.database_url
  url ? PG::Pool.new(url, config.pool_size) : nil
end
