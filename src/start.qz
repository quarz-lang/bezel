# Serves `endpoint` until the process is told to stop: loads the
# configuration ([Bezel::Config.load] over the application's `settings`,
# `{dev: MyApp::Config.dev, ...}`, its name taken from the endpoint's
# namespace, MyApp::Endpoint giving `my_app`; or `config` when given),
# opens the database's pool when there is a DATABASE_URL, and runs an
# [HTTP::Server] with the endpoint's handler on HOST:PORT (HTTPS with
# TLS_CERT and TLS_KEY).
#
# SIGTERM shuts the server down gracefully: no new connections, the
# requests in flight given `grace` to finish, then cancelled; SIGINT
# (Ctrl-C) does the same with one second. A second signal during the
# shutdown ends the process at once (status 1), for a request that
# never waits. Returns once the server has stopped and the pool is
# closed, with the default actions of SIGTERM and SIGINT back: traps the
# application set for them before are dropped, not restored. A task's
# configuration ([Config.for_task] in prod without SECRET_KEY_BASE) is
# refused at once ([Bezel::ConfigError]): it signs no session.
#
# ```quarz no_run
# # src/main.qz of an application
# class Store < Bezel::Endpoint
#   def self.plugs -> Array[Bezel::Plug] = [Bezel::Plug::Logger.new, Bezel.plug { |conn| conn.text("hi") }]
# end
#
# Bezel.start(Store, {prod: Bezel::Settings.new(port: 8080)})
# ```
public def start(endpoint: Type[Endpoint], settings: Hash[Symbol, Settings] = {}, *, config: Config? = nil,
                 grace: Duration = 30.seconds) -> Void
  c = config || Config.load(app_name(endpoint), settings)
  if c.secret_key_base == Config::TASK_SECRET
    raise ConfigError.new("#{c.app}: a task's configuration (Bezel::Config.for_task) cannot serve: its SECRET_KEY_BASE is the placeholder, which signs no session; set SECRET_KEY_BASE and use Bezel::Config.load")
  end
  pool = open_pool(c)
  begin
    srv = server(endpoint, App.new(c, pool))
    a = srv.local_address
    STDERR.puts "bezel: #{c.app} (#{c.env}) listening on #{c.tls_cert ? "https" : "http"}://#{a.host}:#{a.port}"
    serve([srv], grace: grace)
  ensure
    pool&.close
  end
end

# Something else a process runs and stops with its servers ([Bezel.serve]):
# `run` runs it until `shutdown` (given the grace) asks it to stop.
# [Bezel.service] makes one.
data Service = (run: shareable () -> Void, shutdown: shareable (Duration) -> Void)

# A [Service] of `run` and `shutdown`: a job worker, say
# (`Bezel.service(run: -> { worker.run }, shutdown: ->(g: Duration) { worker.shutdown(g) })`).
#
# ```quarz no_run
# stop = Channel[Nil].new
# Bezel.service(run: -> { stop.receive?; nil }, shutdown: ->(g: Duration) { stop.close; nil })
# ```
public def service(*, run: shareable () -> Void, shutdown: shareable (Duration) -> Void) -> Service = Service.new(run, shutdown)

# Serves `servers` and runs the services `also` until the process is told
# to stop, as [Bezel.start] does for its one server: for a process with
# several endpoints (each made with [Bezel.server], on its own port) and
# what else it runs (a job worker).
#
# Each server's `serve` and each service's `run` runs in a task of its
# own; a line `bezel: serving on HOST:PORT` (`bezel: serving on a UNIX
# socket`, `bezel: serving a server already shut down`) is printed for
# each server first. SIGTERM shuts them all down
# at once, each server with `grace` for its requests in flight
# ([HTTP::Server#shutdown]) and each service's `shutdown` given `grace`;
# SIGINT (Ctrl-C) does the same with one second. A second signal during
# the shutdown ends the process at once (status 1). When a server's
# `serve` or a service's `run` ends by itself or raises, the others are
# shut down as if SIGTERM had come (so a server already shut down, or
# given twice, ends them all at once). A service's `shutdown` that raises
# is reported on standard error (its class only) and the shutdown goes
# on; a task still running `grace` plus 10 seconds after the shutdown
# began is cancelled, the grace being the one the shutdown was given (one
# second after SIGINT; a task that never waits cannot be: the second
# signal ends the process). Returns once every task has ended, raising
# again the first exception one ended with, with the default actions of
# SIGTERM and SIGINT back (traps the application set for them before
# are dropped, not restored).
#
# ```quarz no_run
# class ShopFront < Bezel::Endpoint
#   def self.plugs -> Array[Bezel::Plug] = [Bezel.plug { |conn| conn.text("hi") }]
# end
#
# class ShopInternal < Bezel::Endpoint
#   def self.plugs -> Array[Bezel::Plug] = [Bezel.plug { |conn| conn.text("ok") }]
# end
#
# config = Bezel::Config.load("store", {prod: Bezel::Settings.new(port: 8080)})
# app = Bezel::App.new(config, Bezel.open_pool(config))
# stop = Channel[Nil].new
# jobs = Bezel.service(run: -> { stop.receive?; nil }, shutdown: ->(g: Duration) { stop.close; nil })
# Bezel.serve([Bezel.server(ShopFront, app), Bezel.server(ShopInternal, app, port: 8081)], grace: 25.seconds, also: [jobs])
# ```
#
# ## Raises
#
# [ArgumentError] when there is neither a server nor a service; the first
# exception a server or a service ended with.
public def serve(servers: Array[HTTP::Server], *, grace: Duration = 30.seconds, also: Array[Service] = []) -> Void
  raise ArgumentError.new("Bezel.serve: no server and no service") if servers.empty? && also.empty?
  stopping = Atom.new(false)
  signals = Atom.new(0)
  # The index of the first task that raised (-1: none).
  failed = Atom.new(-1)
  tasks: Array[Task[Nil]] = []
  # The tasks, for the watchdog; and the watchdog, once a shutdown began.
  running = Atom[Array[Task[Nil]]].new([])
  watchdog = Atom[Task[Nil]?].new(nil)
  # Stops everything once, with `g`, and starts the watchdog, which
  # cancels what still runs `g` plus 10 seconds later.
  stop: shareable (Duration) -> Void = ->(g: Duration) {
    if stopping.compare_and_set(false, true)
      watchdog.set(Task.spawn do
        Task.sleep(g + 10.seconds)
        running.get.each(&:cancel)
        nil
      end)
      servers.each { |srv| srv.shutdown(timeout: g) }
      also.each do |svc|
        Task.spawn do
          begin
            svc.shutdown.call(g)
          rescue StandardError => e
            STDERR.puts "bezel: a service's shutdown raised #{e.class.name}"
          end
          nil
        end
      end
    end
    nil
  }
  Signal.trap(:TERM) do
    if signals.update { |n| n + 1 } > 1
      STDERR.puts "bezel: a second signal: exiting now"
      exit!(1)
    end
    stop.call(grace)
  end
  Signal.trap(:INT) do
    if signals.update { |n| n + 1 } > 1
      STDERR.puts "bezel: a second signal: exiting now"
      exit!(1)
    end
    stop.call(1.second)
  end
  begin
    servers.each do |srv|
      text = begin
               a = srv.local_address
               "on " + (a.host.include?(":") ? "[#{a.host}]:#{a.port}" : "#{a.host}:#{a.port}")
             rescue ArgumentError
               "on a UNIX socket"
             rescue StandardError
               # (A server already shut down has no address to show:
               # quarz#1184.)
               "a server already shut down"
             end
      STDERR.puts "bezel: serving #{text}"
    end
    bodies: Array[shareable () -> Void] = servers.map { |srv| ->() { srv.serve } }
    bodies = bodies + also.map { |svc| svc.run }
    bodies.each_with_index do |body, i|
      tasks = tasks.push(Task.spawn do
        begin
          body.call
        rescue Task::Cancelled => c
          raise c
        rescue Exception => e
          failed.compare_and_set(-1, i)
          raise e
        ensure
          stop.call(grace)
        end
        nil
      end)
      running.set(tasks)
    end
    tasks.each do |t|
      begin
        t.await
      rescue Task::Cancelled => c
        # (The caller cancelled: not a task the watchdog cancelled.)
        raise c if Task.current.cancelled?
      rescue Exception
        nil
      end
    end
    if (i = failed.get) >= 0
      tasks[i].await
    end
    nil
  ensure
    # (Nothing outlives the call, should the caller be cancelled or a
    # task have raised.)
    watchdog.get&.cancel
    tasks.each(&:cancel)
    Signal.trap(:TERM, :default)
    Signal.trap(:INT, :default)
  end
end

# The server [Bezel.start] runs, for `endpoint` in `app`, bound at once
# (`port` 0 picks a free port: a test reads it from `local_address`),
# not yet serving.
public def server(endpoint: Type[Endpoint], app: App, *, port: Int? = nil) -> HTTP::Server
  c = app.config
  HTTP::Server.new(endpoint.handler(app), host: c.host, port: port || c.port,
                   trusted_proxies: c.trusted_proxies, tls: c.tls)
end

# The application's name for `endpoint`: its outermost namespace in
# snake_case (MyApp::Endpoint is `my_app`).
public def app_name(endpoint: Type[Endpoint]) -> String
  Rotor::Inflector.underscore(endpoint.name.partition("::")[0])
end

# The pool of `config`'s database (its DATABASE_URL, `pool_size`
# connections), or nil without one: the pool [Bezel.start] opens, for an
# application that builds its [App] and servers itself ([Bezel.serve]).
# Close it when done.
public def open_pool(config: Config) -> PG::Pool?
  url = config.database_url
  url ? PG::Pool.new(url, config.pool_size) : nil
end
