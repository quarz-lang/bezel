# The base of an application's controllers. A controller's actions are
# its public methods taking and returning a `Conn` (but the helpers
# below), which the router calls for its routes. Its body has one
# `controller` statement, which generates `dispatch` over the actions
# and runs the controller's plugs before them:
#
# ```
# class Pages < Bezel::Controller
#   controller do
#     plug :load_visitor, except: [:gone]
#   end
#
#   def home(conn: Bezel::Conn) -> Bezel::Conn = text(conn, "home #{conn.assign(:visitor)}")
#   def gone(conn: Bezel::Conn) -> Bezel::Conn = redirect(conn, to: "/")
#
#   private def load_visitor(conn: Bezel::Conn) -> Bezel::Conn = conn.assign(:visitor, "Ann")
# end
#
# c = Bezel::Conn.build(HTTP::Server::Request.get("/"))
# Pages.new.dispatch(:home, c).resp_body     # => HTTP::Content::Text(text: "home Ann")
# Pages.new.dispatch(:gone, c).status        # => 302
# ```
#
# The helpers answer, as `Conn`'s methods do, and halt. A controller has
# no state: the router makes one for each request (`make`), so its
# `initialize` takes no argument.
class Controller
  # A controller.
  def initialize; end

  # A controller of this class: what the router calls the action on.
  def self.make -> Controller = new

  # Runs `action` on `conn`, after the controller's plugs: generated by
  # the `controller` statement. Without one, every action is missing.
  def dispatch(action: Symbol, conn: Conn) -> Conn
    raise NotFound.new("#{self.class.name} has no `controller` statement: #{action} cannot be dispatched")
  end

  # Declares the controller: generates `dispatch` over its actions (its
  # public methods taking and returning a `Conn`, written or inherited,
  # but those of `Bezel::Controller` and the plugs), with no plugs.
  static def self.controller -> Void
    Controller.generate(self, [])
  end

  # Declares the controller and its plugs, which the block lists
  # (`plug :require_login, except: [:index]`): methods of the controller
  # (private ones too) taking and returning a `Conn`, run in order before
  # the action they apply to, until one halts. A plug method that does
  # not exist or has another signature, or an action named in `only:` or
  # `except:` that does not exist, is a compile error here.
  static def self.controller(&block: ControllerSpec.() -> Void) -> Void
    spec = ControllerSpec.new
    spec.instance_exec(&block)
    Controller.generate(self, spec.plugs)
  end

  # `conn` answered with the HTML `html` (`text/html`), and halted.
  def render(conn: Conn, html: String, status: Int = conn.status) -> Conn = conn.html(html, status: status)

  # `conn` answered with `value` as JSON, and halted.
  def json(conn: Conn, value: JSON::Value, status: Int = conn.status) -> Conn = conn.json(value, status: status)

  # `conn` answered with the text `text`, and halted.
  def text(conn: Conn, text: String, status: Int = conn.status) -> Conn = conn.text(text, status: status)

  # `conn` answered with a redirect to `to` (`302 Found`, or `status`; a
  # path of the application, a route helper's), and halted.
  def redirect(conn: Conn, *, to: String, status: Int = 302) -> Conn = conn.redirect(to, status: status)

  # `conn` answered with the file at `path` (its content type
  # `content_type`, else by its extension, as `Plug::Static` gives it), and
  # halted: `Bezel::NotFound` when there is no such file. The path is the
  # application's, never one from the request.
  def send_file(conn: Conn, path: String, content_type: String? = nil) -> Conn
    raise NotFound.new unless File.file?(path)
    type = content_type || Plug::Static::TYPES[File.extname(path).delete_prefix(".").downcase]? || "application/octet-stream"
    conn.send_resp(conn.status, HTTP::Content::Binary.new(File.read_bytes(path)), type)
  end

  # `conn` with `message` in the flash for the next request.
  def put_flash(conn: Conn, kind: Symbol, message: String) -> Conn = conn.put_flash(kind, message)

  # `conn` with the status `status`.
  def put_status(conn: Conn, status: Int) -> Conn = conn.put_status(status)

  # `conn`, halted.
  def halt(conn: Conn) -> Conn = conn.halt

  # The repository of the application's database: `Bezel::ConfigError`
  # when it has none (no DATABASE_URL).
  def repo(conn: Conn) -> Rotor::Repo = conn.repo

  # :nodoc:
  static def self.generate[T <: Controller](cls: Meta::ClassDef[T], plugs: Array[ControllerPlug]) -> Void
    own = Controller.methods.map(&:name)
    plug_names = plugs.map(&:method)
    actions = cls.methods.select do |m|
      m.params.size == 1 && m.params[0].type == Conn && m.params[0].kind == Meta::ParamKind::Required &&
        m.result == Conn && !own.include?(m.name) && !plug_names.include?(m.name)
    end.map(&:name)
    plugs.each do |p|
      (p.only + p.except).each do |a|
        raise ArgumentError.new("#{cls.name}: plug #{p.method.inspect} names #{a.inspect}, which is not an action (#{actions.map(&:inspect).join(", ")})") unless actions.include?(a)
      end
    end
    # The plugs: `__bezel_plug_<i>(action, conn)` runs plug i when it
    # applies, then the next unless it halted; the last returns the
    # connection.
    n = plugs.size
    cls.def_method("__bezel_plug_#{n}".to_sym, [:action, :conn], visibility: :private) do |a: Symbol, c: Conn| -> Conn
      c
    end
    i = n - 1
    while i >= 0
      p = plugs[i]
      only = p.only
      except = p.except
      h = cls.method_ref[(Conn) -> Conn](p.method)
      nxt = cls.method_ref[(Symbol, Conn) -> Conn]("__bezel_plug_#{i + 1}".to_sym)
      cls.def_method("__bezel_plug_#{i}".to_sym, [:action, :conn], visibility: :private) do |a: Symbol, c: Conn| -> Conn
        applies = (only.empty? || only.include?(a)) && !except.include?(a)
        out = applies ? h.bind(self).call(c) : c
        out.halted? ? out : nxt.bind(self).call(a, out)
      end
      i -= 1
    end
    # The actions: `__bezel_action_<k>(action, conn)` runs action k when
    # it is the one, else the next; past the last, NotFound.
    m = actions.size
    cls.def_method("__bezel_action_#{m}".to_sym, [:action, :conn], visibility: :private) do |a: Symbol, c: Conn| -> Conn
      raise NotFound.new("no action #{a}")
    end
    k = m - 1
    while k >= 0
      name = actions[k]
      act = cls.method_ref[(Conn) -> Conn](name)
      rest = cls.method_ref[(Symbol, Conn) -> Conn]("__bezel_action_#{k + 1}".to_sym)
      cls.def_method("__bezel_action_#{k}".to_sym, [:action, :conn], visibility: :private) do |a: Symbol, c: Conn| -> Conn
        a == name ? act.bind(self).call(c) : rest.bind(self).call(a, c)
      end
      k -= 1
    end
    first_plug = cls.method_ref[(Symbol, Conn) -> Conn](:__bezel_plug_0)
    first_action = cls.method_ref[(Symbol, Conn) -> Conn](:__bezel_action_0)
    known = actions
    cls.doc "Runs `action` (#{actions.map { |x| "`#{x}`" }.join(", ")}) on `conn`, after the controller's plugs."
    cls.def_method(:dispatch, [:action, :conn]) do |a: Symbol, c: Conn| -> Conn
      raise NotFound.new("no action #{a}") unless known.include?(a)
      out = first_plug.bind(self).call(a, c)
      out.halted? ? out : first_action.bind(self).call(a, out)
    end
  end
end

# A controller's plug, as its `controller` block declares it.
data ControllerPlug = (method: Symbol, only: Array[Symbol], except: Array[Symbol])

# What a controller's `controller` block runs on.
class ControllerSpec
  include DslScope

  var @plugs: Array[ControllerPlug] = []

  # A spec without plugs.
  def initialize; end

  # The plugs, in order.
  def plugs -> Array[ControllerPlug] = @plugs

  # Runs the controller's method `method` before the actions `only` names
  # (all when empty), but those `except` names.
  def plug(method: Symbol, *, only: Array[Symbol] = [], except: Array[Symbol] = []) -> Void
    raise ArgumentError.new("plug #{method.inspect}: only: and except: together") if !only.empty? && !except.empty?
    @plugs = @plugs.push(ControllerPlug.new(method, only, except))
  end
end
