# An application's router: a plug (the endpoint's last, usually) that
# matches a request to a route of its `routes` statement, runs the
# route's pipelines, and calls the route's action on its controller
# (`Controller#dispatch`, which runs the controller's plugs first).
#
# ```
# class ShopItems < Bezel::Controller
#   controller
#   def home(conn: Bezel::Conn) -> Bezel::Conn = text(conn, "home")
#   def show(conn: Bezel::Conn) -> Bezel::Conn = text(conn, "item #{conn.params.int("id")}")
# end
#
# class ShopRouter < Bezel::Router
#   def self.browser -> Array[Bezel::Plug] = [Bezel::Plug::Accepts.new(["html"])]
#
#   routes do
#     scope "/", pipeline: :browser do
#       get "/", ShopItems, :home, as: "home"
#       get "/items/{id}", ShopItems, :show, as: "item"
#     end
#   end
# end
#
# ShopRouter.item_path(id: 7)                  # => "/items/7"
# c = ShopRouter.new.call(Bezel::Conn.build(HTTP::Server::Request.get("/items/7")))
# c.resp_body                                   # => HTTP::Content::Text(text: "item 7")
# ```
#
# Matching is `HTTP::Router`'s: the most specific pattern wins, HEAD is
# served by a GET route, and a path that only other methods have is
# answered `405 Method Not Allowed` with Allow. A path no route has is
# passed on (the endpoint answers `404`). The path's parameters are merged
# into the parameters (`conn.params.int("id")`) and the request's
# `params`.
#
# The `routes` statement checks, where the router is compiled, that each
# route's controller has its action (a public method taking and returning
# a `Conn`) and each pipeline named is a class method of the router
# returning plugs. It generates the route helpers: for each named route,
# a class method `<name>_path` taking the pattern's parameters as
# keywords (`item_path(id: 7)`). A misspelt or missing keyword is a
# compile error; a value is an `Int` or a `String`, checked when the
# helper runs (`ArgumentError` for another, or for an empty, `.` or `..`
# segment), and percent-encoded. `with_query` adds a query, and
# `Conn#url` makes the path a URL.
#
# A controller whose dispatch does not cover the action routed to (a
# subclass's action under its superclass's dispatch) answers with an
# `ArgumentError` (a 500, reported to `on_error`).
abstract class Router
  include Plug

  @routes: HTTP::Routes[Route]
  @pipelines: Hash[Symbol, Array[Plug]]

  # The router, its pipelines' plugs made now, once.
  def initialize
    @routes = HTTP::Routes[Route].empty
    @pipelines = {}
    cls = router_class
    # (The `routes` statement refused conflicting routes already.)
    routes = HTTP::Routes[Route].empty
    cls.route_table.each { |r| routes = routes.add(r.method, r.pattern, r) }
    @routes = routes
    @pipelines = cls.pipeline_table
  end

  # The router's class (generated by `routes`, whose tables it reads).
  def router_class -> Type[Router] = Router

  # The routes, in order: generated by the `routes` statement.
  def self.route_table -> Array[Route] = []

  # :nodoc:
  # The pipelines the routes name, made: generated by `routes`.
  def self.pipeline_table -> Hash[Symbol, Array[Plug]] = {}

  # Declares the routes: the block runs where the router is compiled, on
  # a `RouteBuilder` (`scope`, `get`/`post`/`put`/`patch`/`delete`,
  # `resources`).
  static def self.routes(&block: RouteBuilder.() -> Void) -> Void
    b = RouteBuilder.new
    b.instance_exec(&block)
    table = b.routes
    table.each do |r|
      unless r.controller.methods.any? { |m| m.name == r.action && Controller.action?(m) }
        raise ArgumentError.new("#{r.method} #{r.pattern}: #{r.controller.name} has no action `#{r.action}` (a public method taking and returning a Bezel::Conn)")
      end
    end
    doc "The routes, in order."
    def_class_method(:route_table, override: true) { table }
    owner: Type[Router] = type
    doc ":nodoc:"
    def_method(:router_class, override: true) { owner }
    names = table.flat_map(&:pipelines).uniq
    Router.generate_pipelines(self, names)
    Router.generate_helpers(self, table)
  end

  # :nodoc:
  # `pipeline_table`, through a chain of class methods
  # `__bezel_pipelines_<i>` that make pipeline i's plugs with its class
  # method (`class_method_ref`: a compile error when there is none) and
  # add the rest's.
  static def self.generate_pipelines[T <: Router](cls: Meta::ClassDef[T], names: Array[Symbol]) -> Void
    n = names.size
    cls.def_class_method("__bezel_pipelines_#{n}".to_sym, visibility: :private) do -> Hash[Symbol, Array[Plug]]
      Hash[Symbol, Array[Plug]].new
    end
    i = n - 1
    while i >= 0
      name = names[i]
      make = cls.class_method_ref[() -> Array[Plug]](name)
      rest = cls.class_method_ref[() -> Hash[Symbol, Array[Plug]]]("__bezel_pipelines_#{i + 1}".to_sym)
      cls.def_class_method("__bezel_pipelines_#{i}".to_sym, visibility: :private) do -> Hash[Symbol, Array[Plug]]
        rest.bind(self).call.put(name, make.bind(self).call)
      end
      i -= 1
    end
    first = cls.class_method_ref[() -> Hash[Symbol, Array[Plug]]](:__bezel_pipelines_0)
    cls.doc ":nodoc:"
    cls.def_class_method(:pipeline_table, override: true) { first.bind(self).call }
  end

  # :nodoc:
  # A `<name>_path` class method for each named route.
  static def self.generate_helpers[T <: Router](cls: Meta::ClassDef[T], table: Array[Route]) -> Void
    seen: Array[String] = []
    table.each do |r|
      n = r.name
      next if n.nil? || seen.include?(n)
      seen = seen.push(n)
      pattern = r.pattern
      kws = r.params.map { |p| Meta::Keyword.new(p, Object, true) }
      helper = "#{n}_path".to_sym
      cls.doc "The path of the route `#{pattern}` (#{r.controller.name}##{r.action})."
      if kws.empty?
        cls.def_class_method(helper) { pattern }
      else
        cls.def_class_method(helper, keywords: kws) do |given|
          Router.fill(pattern, given)
        end
      end
    end
  end

  # `pattern` with its parameters taken from `values` (an `Int` or a
  # `String` each), percent-encoded; a `{name...}` one keeps its slashes.
  def self.fill(pattern: String, values: Hash[Symbol, Object]) -> String
    parts = pattern.split("/", -1).map do |seg|
      if seg.start_with?("{") && seg.end_with?("}")
        rest = seg.end_with?("...}")
        key = seg.delete_prefix("{").delete_suffix("}").delete_suffix("...").to_sym
        v = values[key]?
        text = if v.is_a?(Int)
          v.to_s
        elsif v.is_a?(String)
          v
        else
          raise ArgumentError.new("#{key}: an Int or a String, not #{v.nil? ? "nil" : v.class.name}")
        end
        # (A rest may be empty, `/files/{p...}` matching `/files/`.)
        pieces: Array[String] = rest && text.empty? ? [] : (rest ? text.split("/", -1) : [text])
        pieces.each_with_index do |p, i|
          # (A dot segment would leave the route once a client resolves
          # the path. A rest may end with `/`, as matching gives it.)
          trailing = rest && i == pieces.size - 1 && i > 0
          raise ArgumentError.new("#{key}: #{p.inspect} is not a path segment") if (p.empty? && !trailing) || p == "." || p == ".."
        end
        pieces.map { |p| URI.encode_component(p) }.join("/")
      else
        seg
      end
    end
    parts.join("/")
  end

  # `path` with the query `params` (keys in order; an array value repeats
  # its key), or `path` alone when `params` is empty.
  #
  # ```
  # Bezel::Router.with_query("/users", {"page" => "2", "tag" => ["a b", "c"]})
  # # => "/users?page=2&tag=a+b&tag=c"
  # ```
  def self.with_query(path: String, params: Hash[String, String | Array[String]]) -> String
    params.empty? ? path : "#{path}?#{URI.encode_www_form(params)}"
  end

  def call(conn: Conn) -> Conn
    segments = conn.request.path_segments
    return conn if segments.nil?
    # (`HTTP::Routes#find` chooses as `HTTP::Router` does: the most
    # specific pattern, HEAD by GET with a HEAD route winning, 405.)
    case @routes.find(conn.method, segments)
    in HTTP::Routes::Found::Match(value:, params:)
      run_route(conn, value, params)
    in HTTP::Routes::Found::NotAllowed(allow:)
      conn.put_resp_header("allow", allow.join(", ")).text("Method Not Allowed", status: 405)
    in HTTP::Routes::Found::NotFound
      conn
    end
  end

  # `route`'s pipelines, then its controller's action, with the
  # pattern's parameters in the request.
  private def run_route(conn: Conn, route: Route, found_params: Hash[String, String]) -> Conn
    routed = conn.with(request: conn.request.with(params: conn.request.params.merge(found_params)))
                 .merge_params(Params.of(found_params))
    plugs: Array[Plug] = []
    route.pipelines.each { |p| plugs = plugs + (@pipelines[p]? || []) }
    controller = route.controller
    action = route.action
    Plug.run(plugs, routed, ->(c: Conn) { controller.make.dispatch(action, c) })
  end
end
