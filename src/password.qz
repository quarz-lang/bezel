# Password hashes: PBKDF2-SHA256 with a random salt and a cost (its
# iterations), in a self-describing string
# (`$pbkdf2-sha256$600000$<salt>$<hash>`, Base64 without padding), and a
# check in constant time. (argon2 when the standard library has it.)
#
# ```
# h = Bezel::Password.hash("correct horse", iterations: 1000)
# Bezel::Password.verify("correct horse", h)    # => true
# Bezel::Password.verify("wrong horse", h)      # => false
# Bezel::Password.needs_rehash?(h)              # => true
# ```
module Password
  # The iterations by default: OWASP's recommendation for PBKDF2-SHA256
  # (2023).
  ITERATIONS = 600_000

  # The hash of `password`, with a fresh 16-byte salt.
  def self.hash(password: String, *, iterations: Int = ITERATIONS) -> String
    raise ArgumentError.new("iterations must be at least 1000") if iterations < 1000
    salt = Crypto.random_bytes(16)
    dk = Digest::PBKDF2.sha256(password, salt, iterations, 32)
    "$pbkdf2-sha256$#{iterations}$#{Base64.urlsafe_encode(salt, padding: false)}$#{Base64.urlsafe_encode(dk, padding: false)}"
  end

  # Whether `password` is the one `hashed` was made from; false for a
  # string that is not such a hash.
  def self.verify(password: String, hashed: String) -> Bool
    parts = Password.parse(hashed)
    return false if parts.nil?
    iterations, salt, dk = parts
    Keys.same?(Digest::PBKDF2.sha256(password, salt, iterations, dk.size), dk)
  end

  # Whether `hashed` was made with fewer iterations than `iterations` (or
  # is no such hash): hash the password again after a login.
  def self.needs_rehash?(hashed: String, iterations: Int = ITERATIONS) -> Bool
    parts = Password.parse(hashed)
    parts.nil? || parts[0] < iterations
  end

  # :nodoc:
  def self.parse(hashed: String) -> [Int, Bytes, Bytes]?
    m = hashed.match(/\A\$pbkdf2-sha256\$([0-9]{4,9})\$([A-Za-z0-9_\-]+)\$([A-Za-z0-9_\-]+)\z/)
    return nil if m.nil?
    begin
      [(m[1] || "0").to_i, Base64.urlsafe_decode(m[2] || ""), Base64.urlsafe_decode(m[3] || "")]
    rescue ArgumentError
      nil
    end
  end
end

# Signed, expiring tokens for links sent by mail (confirm an address,
# reset a password): `data` (an id), the purpose and the expiry, signed
# with HMAC-SHA256 under a key derived from SECRET_KEY_BASE. A token is
# good for its purpose only, until it expires; its data can be read by
# anyone holding it (it is signed, not encrypted).
#
# ```
# config = Bezel::Config.load("shop", environ: {"BEZEL_ENV" => "test"})
# t = Bezel::Token.sign(config, "reset", "42", expires_in: 1.hour)
# Bezel::Token.verify(config, "reset", t)      # => "42"
# Bezel::Token.verify(config, "confirm", t)    # => nil
# ```
module Token
  # A token of `data` for `purpose`, good for `expires_in`.
  def self.sign(config: Config, purpose: String, data: String, *, expires_in: Duration) -> String
    expires = Time.now.to_i + expires_in.to_ms / 1000
    payload = Base64.urlsafe_encode(JSON.generate({"d" => data, "e" => expires.to_s}), padding: false)
    "#{payload}.#{Token.mac(config, purpose, payload)}"
  end

  # The data of `token` when it is a token for `purpose` that has not
  # expired, else nil.
  def self.verify(config: Config, purpose: String, token: String) -> String?
    payload, dot, mac = token.partition(".")
    return nil if dot.empty?
    return nil unless Keys.same?(mac, Token.mac(config, purpose, payload))
    begin
      json = JSON.parse(Base64.urlsafe_decode(payload).decode? || "")
      data = json["d"].as_s?
      expires = json["e"].as_s?&.to_i
      return nil if data.nil? || expires.nil? || Time.now.to_i >= expires
      data
    rescue JSON::ParseError, ArgumentError, KeyError
      nil
    end
  end

  # :nodoc:
  def self.mac(config: Config, purpose: String, payload: String) -> String
    key = Keys.derive(config.secret_key_base, "bezel token")
    Base64.urlsafe_encode(Digest::HMAC.sha256(key, "#{purpose}\0#{payload}"), padding: false)
  end
end
