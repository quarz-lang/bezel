# Password hashes: argon2id (`Crypto::Argon2`), as PHC strings
# (`$argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>`) that name their
# parameters, with a random salt and a check in constant time.
#
# ```
# cheap = Crypto::Argon2::Params.new(memory_kib: 64, iterations: 1, parallelism: 1)
# h = Bezel::Password.hash("correct horse", params: cheap)
# Bezel::Password.verify?("correct horse", h)    # => true
# Bezel::Password.verify?("wrong horse", h)      # => false
# Bezel::Password.needs_rehash?(h)               # => true
# ```
#
# The parameters are the application's `Config#password_params`
# (`Settings`'s `password_params:`, `Crypto::Argon2::Params::DEFAULT`
# unless set): give them to `hash` and `needs_rehash?`, and after a
# successful login hash the password again when `needs_rehash?` says so.
# A hash takes tens of milliseconds and `memory_kib` of memory (19 MiB by
# default) on a helper thread: a server that takes many logins at once
# should bound how many it checks together.
module Password
  # The hash of `password`, with a fresh 16-byte salt.
  def self.hash(password: String, *, params: Crypto::Argon2::Params = Crypto::Argon2::Params::DEFAULT) -> String
    Crypto::Argon2.hash(password, params: params)
  end

  # Whether `password` is the one `hashed` was made from. A string that
  # is not an argon2id hash (another scheme, garbage) raises
  # `Crypto::Error`, so that a broken stored hash is noticed rather than
  # taken for a wrong password.
  def self.verify?(password: String, hashed: String) -> Bool = Crypto::Argon2.verify?(password, hashed)

  # Whether `hashed` was made with parameters below `params` (or is not
  # an argon2id hash): hash the password again after a login.
  def self.needs_rehash?(hashed: String, params: Crypto::Argon2::Params = Crypto::Argon2::Params::DEFAULT) -> Bool
    Crypto::Argon2.needs_rehash?(hashed, params)
  end
end

# Signed, expiring tokens for links sent by mail (confirm an address,
# reset a password): `data` (an id), the purpose and the expiry, signed
# with HMAC-SHA256 under a key derived from SECRET_KEY_BASE. A token is
# good for its purpose only, until it expires; its data can be read by
# anyone holding it (it is signed, not encrypted).
#
# A token is not used up: it stays good until it expires. Give
# `fingerprint` something that its use changes (for a password reset,
# the current password hash), the same when signing and verifying, and
# the token stops verifying once that changes.
#
# ```
# config = Bezel::Config.load("shop", environ: {"BEZEL_ENV" => "test"})
# t = Bezel::Token.sign(config, "reset", "42", expires_in: 1.hour)
# Bezel::Token.verify(config, "reset", t)      # => "42"
# Bezel::Token.verify(config, "confirm", t)    # => nil
# ```
module Token
  # A token of `data` for `purpose`, good for `expires_in`.
  def self.sign(config: Config, purpose: String, data: String, *, expires_in: Duration, fingerprint: String = "") -> String
    expires = Time.now.to_i + expires_in.to_ms / 1000
    payload = Base64.urlsafe_encode(JSON.generate({"d" => data, "e" => expires.to_s}), padding: false)
    "#{payload}.#{Token.mac(config, purpose, payload, fingerprint)}"
  end

  # The data of `token` when it is a token for `purpose` that has not
  # expired, else nil.
  def self.verify(config: Config, purpose: String, token: String, *, fingerprint: String = "") -> String?
    payload, dot, mac = token.partition(".")
    return nil if dot.empty?
    return nil unless Keys.same?(mac, Token.mac(config, purpose, payload, fingerprint))
    begin
      json = JSON.parse(Base64.urlsafe_decode(payload).decode? || "")
      data = json["d"].as_s?
      expires = json["e"].as_s?&.to_i
      return nil if data.nil? || expires.nil? || Time.now.to_i >= expires
      data
    rescue JSON::ParseError, ArgumentError, KeyError
      nil
    end
  end

  # :nodoc:
  def self.mac(config: Config, purpose: String, payload: String, fingerprint: String) -> String
    key = Keys.derive(config.secret_key_base, "bezel token")
    fp = Digest::SHA256.hexdigest(fingerprint)
    Base64.urlsafe_encode(Digest::HMAC.sha256(key, "#{purpose}\0#{fp}\0#{payload}"), padding: false)
  end
end
